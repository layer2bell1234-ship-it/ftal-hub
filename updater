source = source .. [[

--============================================================
-- FTAL 334
-- RAGEBOT RUNTIME
--============================================================

do

    local LastShot = 0
    local LastTarget = nil

    local SavedWalkSpeed = nil
    local SavedJumpPower = nil
    local SavedAutoRotate = nil

    local CameraSaved = false
    local SavedCameraMode
    local SavedMinZoom
    local SavedMaxZoom

    local RageOverlay = nil

    --========================================================
    -- CHARACTER
    --========================================================

    local function Character()
        return LocalPlayer.Character
    end

    local function Humanoid()
        local character = Character()

        if not character then
            return nil
        end

        return character:FindFirstChildOfClass(
            "Humanoid"
        )
    end

    local function Root(player)
        player = player or LocalPlayer

        local character = player.Character

        if not character then
            return nil
        end

        return character:FindFirstChild(
            "HumanoidRootPart"
        )
    end

    local function Alive(player)
        if not player then
            return false
        end

        local character =
            player.Character

        if not character then
            return false
        end

        local humanoid =
            character:FindFirstChildOfClass(
                "Humanoid"
            )

        return
            humanoid ~= nil
            and
            humanoid.Health > 0
    end

    --========================================================
    -- ENEMY CHECK
    --========================================================

    local function Enemy(player)

        if not player
            or
            player == LocalPlayer
        then
            return false
        end

        if not Alive(player) then
            return false
        end

        if
            Hub.State.RageTeamCheck
            and
            LocalPlayer.Team
            and
            player.Team
            and
            LocalPlayer.Team == player.Team
        then
            return false
        end

        return true
    end

    --========================================================
    -- BODY PARTS
    --========================================================

    local BodyParts = {
        "Head",
        "UpperTorso",
        "Torso",
        "LowerTorso",
        "HumanoidRootPart",

        "LeftUpperArm",
        "RightUpperArm",
        "LeftLowerArm",
        "RightLowerArm",

        "LeftUpperLeg",
        "RightUpperLeg",
        "LeftLowerLeg",
        "RightLowerLeg",

        "LeftHand",
        "RightHand",
        "LeftFoot",
        "RightFoot",
    }

    --========================================================
    -- AIM PART
    --========================================================

    local function GetAimPart(player)

        local character =
            player.Character

        if not character then
            return nil
        end

        local mode =
            Hub.State.RageAimPart

        if mode == "Head" then

            return
                character:FindFirstChild("Head")
                or
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

        elseif mode == "Torso" then

            return
                character:FindFirstChild(
                    "UpperTorso"
                )
                or
                character:FindFirstChild("Torso")
                or
                character:FindFirstChild(
                    "LowerTorso"
                )
                or
                character:FindFirstChild(
                    "HumanoidRootPart"
                )
        end

        --====================================================
        -- CLOSEST BODY PART
        --====================================================

        local mouse =
            UserInputService:GetMouseLocation()

        local closest = nil
        local closestDistance = math.huge

        for _, name in ipairs(BodyParts) do

            local part =
                character:FindFirstChild(name)

            if part then

                local screenPos,
                    onScreen =
                    Camera:WorldToViewportPoint(
                        part.Position
                    )

                if
                    onScreen
                    and
                    screenPos.Z > 0
                then

                    local screen =
                        Vector2.new(
                            screenPos.X,
                            screenPos.Y
                        )

                    local distance =
                        (
                            screen -
                            mouse
                        ).Magnitude

                    if distance < closestDistance then

                        closestDistance =
                            distance

                        closest = part
                    end
                end
            end
        end

        return closest
    end

    --========================================================
    -- WALL CHECK
    --========================================================

    local function Visible(player, part)

        if not Hub.State.RageWallCheck then
            return true
        end

        local myCharacter =
            Character()

        if
            not myCharacter
            or
            not player
            or
            not player.Character
            or
            not part
        then
            return false
        end

        local origin =
            Camera.CFrame.Position

        local direction =
            part.Position - origin

        local params =
            RaycastParams.new()

        params.FilterType =
            Enum.RaycastFilterType.Exclude

        params.FilterDescendantsInstances = {
            myCharacter
        }

        local result =
            workspace:Raycast(
                origin,
                direction,
                params
            )

        -- Nothing blocked the ray.
        if not result then
            return true
        end

        return result.Instance:IsDescendantOf(
            player.Character
        )
    end

    --========================================================
    -- DISTANCE
    --========================================================

    local function InDistance(player)

        local mine =
            Root(LocalPlayer)

        local theirs =
            Root(player)

        if
            not mine
            or
            not theirs
        then
            return false
        end

        return
            (
                mine.Position -
                theirs.Position
            ).Magnitude
            <=
            (
                tonumber(
                    Hub.State.RageDistance
                )
                or
                2000
            )
    end

    --========================================================
    -- SCREEN DATA
    --========================================================

    local function GetScreenDistance(part)

        if not part then
            return nil
        end

        local position,
            onScreen =
            Camera:WorldToViewportPoint(
                part.Position
            )

        if
            not onScreen
            or
            position.Z <= 0
        then
            return nil
        end

        local screen =
            Vector2.new(
                position.X,
                position.Y
            )

        local mouse =
            UserInputService:GetMouseLocation()

        return
            (
                screen -
                mouse
            ).Magnitude,
            screen
    end

    --========================================================
    -- TARGET SCORE
    --========================================================

    local function Score(player, part)

        if not part then
            return nil
        end

        local position,
            onScreen =
            Camera:WorldToViewportPoint(
                part.Position
            )

        if
            not onScreen
            or
            position.Z <= 0
        then
            return nil
        end

        local screen =
            Vector2.new(
                position.X,
                position.Y
            )

        local mouse =
            UserInputService:GetMouseLocation()

        local center =
            Vector2.new(
                Camera.ViewportSize.X / 2,
                Camera.ViewportSize.Y / 2
            )

        local cursorDistance =
            (
                screen -
                mouse
            ).Magnitude

        local centerDistance =
            (
                screen -
                center
            ).Magnitude

        local fov =
            tonumber(
                Hub.State.RageFOV
            )
            or
            1000

        local extra =
            tonumber(
                Hub.State.RageScanPixels
            )
            or
            0

        --====================================================
        -- CLOSEST TO CURSOR
        --====================================================

        if Hub.State.RageTargetMode ==
            "Closest to Cursor"
        then

            if cursorDistance >
                fov + extra
            then
                return nil
            end

            return cursorDistance
        end

        --====================================================
        -- OTHER MODES
        --====================================================

        if centerDistance >
            fov + extra
        then
            return nil
        end

        if Hub.State.RageTargetMode ==
            "Lowest Health"
        then

            local humanoid =
                player.Character:
                FindFirstChildOfClass(
                    "Humanoid"
                )

            if not humanoid then
                return nil
            end

            return humanoid.Health
        end

        local mine =
            Root(LocalPlayer)

        local theirs =
            Root(player)

        if
            not mine
            or
            not theirs
        then
            return nil
        end

        return
            (
                mine.Position -
                theirs.Position
            ).Magnitude
    end

    --========================================================
    -- TARGET ACQUISITION
    --========================================================

    local function AcquireTarget()

        local bestPlayer = nil
        local bestPart = nil
        local bestScore = math.huge

        local selectedMode =
            Hub.State.RageTargetMode

        -- Priority overrides the normal selection mode.
        if Hub.State.RagePriority ~= "None" then
            selectedMode =
                Hub.State.RagePriority
        end

        for _, player in ipairs(
            Players:GetPlayers()
        ) do

            if
                Enemy(player)
                and
                InDistance(player)
            then

                local part =
                    GetAimPart(player)

                if
                    part
                    and
                    Visible(
                        player,
                        part
                    )
                then

                    local oldMode =
                        Hub.State.RageTargetMode

                    Hub.State.RageTargetMode =
                        selectedMode

                    local score =
                        Score(
                            player,
                            part
                        )

                    Hub.State.RageTargetMode =
                        oldMode

                    if
                        score
                        and
                        score < bestScore
                    then

                        bestScore =
                            score

                        bestPlayer =
                            player

                        bestPart =
                            part
                    end
                end
            end
        end

        return
            bestPlayer,
            bestPart
    end

    --========================================================
    -- CAMERA SAVE / RESTORE
    --========================================================

    local function SaveCamera()

        if CameraSaved then
            return
        end

        SavedCameraMode =
            LocalPlayer.CameraMode

        SavedMinZoom =
            LocalPlayer.CameraMinZoomDistance

        SavedMaxZoom =
            LocalPlayer.CameraMaxZoomDistance

        CameraSaved = true
    end

    local function RestoreCamera()

        if not CameraSaved then
            return
        end

        pcall(function()

            LocalPlayer.CameraMode =
                SavedCameraMode
                or
                Enum.CameraMode.Classic

            LocalPlayer.CameraMinZoomDistance =
                SavedMinZoom
                or
                0.5

            LocalPlayer.CameraMaxZoomDistance =
                SavedMaxZoom
                or
                12.5

        end)

        CameraSaved = false
    end

    --========================================================
    -- THIRD PERSON
    --========================================================

    Connect(
        RunService.RenderStepped,
        function()

            if not Hub.State.RageBot then
                RestoreCamera()
                return
            end

            SaveCamera()

            if Hub.State.RageThirdPerson then

                LocalPlayer.CameraMode =
                    Enum.CameraMode.Classic

                LocalPlayer.CameraMinZoomDistance =
                    8

                LocalPlayer.CameraMaxZoomDistance =
                    14
            end

            if Hub.State.RageShiftLock then

                pcall(function()

                    LocalPlayer.DevEnableMouseLock =
                        true

                end)
            end
        end
    )

    --========================================================
    -- AIMBOT
    --========================================================
    --
    -- THIS WAS THE MAIN BUG IN THE OLD VERSION.
    -- The previous code acquired a target and then
    -- intentionally did nothing with it.
    --
    -- This version continuously points the camera at the
    -- currently valid target every RenderStepped.
    --
    --========================================================

    Connect(
        RunService.RenderStepped,
        function()

            if not Hub.State.RageBot then
                LastTarget = nil
                return
            end

            local target,
                part =
                AcquireTarget()

            if
                not target
                or
                not part
            then

                LastTarget = nil
                return
            end

            LastTarget = target

            --================================================
            -- AIM CAMERA DIRECTLY AT TARGET
            --================================================

            local cameraPosition =
                Camera.CFrame.Position

            Camera.CFrame =
                CFrame.lookAt(
                    cameraPosition,
                    part.Position
                )

        end
    )

    --========================================================
    -- SPINBOT
    --========================================================

    Connect(
        RunService.RenderStepped,
        function(dt)

            if
                not Hub.State.RageBot
                or
                not Hub.State.RageSpinbot
            then
                return
            end

            local character =
                Character()

            local humanoid =
                Humanoid()

            local root =
                character
                and
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if
                not humanoid
                or
                not root
            then
                return
            end

            if SavedAutoRotate == nil then
                SavedAutoRotate =
                    humanoid.AutoRotate
            end

            humanoid.AutoRotate = false

            local speed =
                tonumber(
                    Hub.State.RageSpinSpeed
                )
                or
                900

            root.CFrame =
                root.CFrame
                *
                CFrame.Angles(
                    0,
                    math.rad(speed) * dt,
                    0
                )
        end
    )

    --========================================================
    -- MOVEMENT
    --========================================================

    Connect(
        RunService.Heartbeat,
        function()

            local humanoid =
                Humanoid()

            if not humanoid then
                return
            end

            if Hub.State.RageBot then

                --================================================
                -- SPEED
                --================================================

                if Hub.State.RageSpeedHack then

                    if SavedWalkSpeed == nil then
                        SavedWalkSpeed =
                            humanoid.WalkSpeed
                    end

                    humanoid.WalkSpeed =
                        tonumber(
                            Hub.State.RageWalkSpeed
                        )
                        or
                        100

                elseif SavedWalkSpeed ~= nil then

                    humanoid.WalkSpeed =
                        SavedWalkSpeed

                    SavedWalkSpeed = nil
                end

                --================================================
                -- JUMP
                --================================================

                if Hub.State.RageJumpHack then

                    if humanoid.UseJumpPower then

                        if SavedJumpPower == nil then
                            SavedJumpPower =
                                humanoid.JumpPower
                        end

                        humanoid.JumpPower =
                            tonumber(
                                Hub.State.RageJumpPower
                            )
                            or
                            100
                    end

                elseif SavedJumpPower ~= nil then

                    humanoid.JumpPower =
                        SavedJumpPower

                    SavedJumpPower = nil
                end

                --================================================
                -- BUNNY HOP
                --================================================

                if
                    Hub.State.RageBunnyHop
                    and
                    humanoid.MoveDirection.Magnitude > 0
                    and
                    humanoid.FloorMaterial ~=
                        Enum.Material.Air
                then

                    humanoid.Jump = true
                end

            else

                if SavedWalkSpeed ~= nil then

                    humanoid.WalkSpeed =
                        SavedWalkSpeed

                    SavedWalkSpeed = nil
                end

                if SavedJumpPower ~= nil then

                    humanoid.JumpPower =
                        SavedJumpPower

                    SavedJumpPower = nil
                end

                if SavedAutoRotate ~= nil then

                    humanoid.AutoRotate =
                        SavedAutoRotate

                    SavedAutoRotate = nil

                else

                    humanoid.AutoRotate = true
                end
            end
        end
    )

    --========================================================
    -- INFINITE JUMP
    --========================================================

    Connect(
        UserInputService.JumpRequest,
        function()

            if
                not Hub.State.RageBot
                or
                not Hub.State.RageInfiniteJump
            then
                return
            end

            local humanoid =
                Humanoid()

            if humanoid then

                humanoid:ChangeState(
                    Enum.HumanoidStateType.Jumping
                )

            end
        end
    )

    --========================================================
    -- LEFT CLICK SHOOTING
    --========================================================
    --
    -- Priority:
    --
    -- 1. mouse1press / mouse1release
    -- 2. Tool:Activate() fallback
    --
    -- This means Auto Shoot actually behaves like left click
    -- when the environment exposes mouse input functions.
    --
    --========================================================

    local MouseDown = false

    local function LeftClick()

        if MouseDown then
            return
        end

        MouseDown = true

        --====================================================
        -- ACTUAL LEFT MOUSE INPUT
        --====================================================

        if type(mouse1press) == "function" then

            pcall(function()
                mouse1press()
            end)

            return
        end

        --====================================================
        -- TOOL FALLBACK
        --====================================================

        local character =
            Character()

        if not character then
            MouseDown = false
            return
        end

        local tool =
            character:FindFirstChildOfClass(
                "Tool"
            )

        if tool then

            pcall(function()
                tool:Activate()
            end)
        end
    end

    local function LeftRelease()

        if not MouseDown then
            return
        end

        MouseDown = false

        if type(mouse1release) == "function" then

            pcall(function()
                mouse1release()
            end)

        end
    end

    --========================================================
    -- AUTO SHOOT
    --========================================================

    Connect(
        RunService.Heartbeat,
        function()

            --================================================
            -- EVERYTHING OFF
            --================================================

            if
                not Hub.State.RageBot
                or
                not Hub.State.RageAutoShoot
            then

                LeftRelease()
                LastTarget = nil

                return
            end

            --================================================
            -- CONTINUOUS TARGET SEARCH
            --================================================

            local target,
                part =
                AcquireTarget()

            --================================================
            -- NO VALID TARGET
            --================================================

            if
                not target
                or
                not part
            then

                LeftRelease()
                LastTarget = nil

                return
            end

            LastTarget = target

            --================================================
            -- FIRE RATE
            --================================================

            local now =
                os.clock()

            local rate =
                math.max(
                    1,
                    tonumber(
                        Hub.State.RageFireRate
                    )
                    or
                    30
                )

            local interval =
                1 / rate

            --================================================
            -- HIT CHANCE
            --================================================

            local chance =
                math.clamp(
                    tonumber(
                        Hub.State.RageHitChance
                    )
                    or
                    100,
                    0,
                    100
                )

            --================================================
            -- FIRE
            --================================================

            if
                now - LastShot >= interval
            then

                LastShot = now

                if
                    math.random(1, 100)
                    <=
                    chance
                then

                    LeftClick()

                    -- Release shortly after the click.
                    task.delay(
                        math.min(
                            interval * 0.45,
                            0.05
                        ),
                        function()

                            if
                                Hub.State.RageBot
                                and
                                Hub.State.RageAutoShoot
                            then

                                LeftRelease()

                            end
                        end
                    )
                end
            end

        end
    )

    --========================================================
    -- STATUS OVERLAY
    --========================================================

    local function CreateOverlay()

        if
            RageOverlay
            and
            RageOverlay.Parent
        then
            return
        end

        RageOverlay =
            Instance.new(
                "TextLabel"
            )

        RageOverlay.Name =
            "RageBotStatus"

        RageOverlay.AnchorPoint =
            Vector2.new(1, 0)

        RageOverlay.Position =
            UDim2.new(
                1,
                -12,
                0,
                75
            )

        RageOverlay.Size =
            UDim2.fromOffset(
                250,
                28
            )

        RageOverlay.BackgroundColor3 =
            Theme.Background2

        RageOverlay.BackgroundTransparency =
            0.2

        RageOverlay.BorderSizePixel =
            0

        RageOverlay.Font =
            Enum.Font.GothamBold

        RageOverlay.TextSize =
            10

        RageOverlay.TextColor3 =
            Theme.Text

        RageOverlay.TextXAlignment =
            Enum.TextXAlignment.Right

        RageOverlay.ZIndex =
            999

        RageOverlay.Parent =
            Gui

        Round(
            RageOverlay,
            5
        )

        Stroke(
            RageOverlay,
            Theme.Border
        )
    end

    local function UpdateOverlay()

        if
            not Hub.State.RageBot
            or
            not Hub.State.RageKeybindList
        then

            if RageOverlay then
                RageOverlay.Visible = false
            end

            return
        end

        CreateOverlay()

        RageOverlay.Visible = true

        local target,
            part =
            AcquireTarget()

        local targetName =
            target
            and
            target.DisplayName
            or
            "NO TARGET"

        local targetState =
            target
            and
            "LOCKED"
            or
            "NO TARGET"

        RageOverlay.Text =
            "RAGE  •  "
            ..
            targetState
            ..
            "  •  "
            ..
            targetName
    end

    Connect(
        RunService.RenderStepped,
        UpdateOverlay
    )

    --========================================================
    -- RESPAWN
    --========================================================

    Connect(
        LocalPlayer.CharacterAdded,
        function(character)

            SavedWalkSpeed = nil
            SavedJumpPower = nil
            SavedAutoRotate = nil

            LastTarget = nil
            LastShot = 0

            task.wait(0.25)

            if not Hub.State.RageBot then
                return
            end

            local humanoid =
                character:
                FindFirstChildOfClass(
                    "Humanoid"
                )

            if not humanoid then
                return
            end

            if Hub.State.RageSpinbot then

                humanoid.AutoRotate =
                    false

            end
        end
    )

    --========================================================
    -- FOCUS LOST
    --========================================================

    Connect(
        UserInputService.WindowFocusReleased,
        function()

            LeftRelease()

            Hub.State.AimbotHolding =
                false

            LastTarget = nil

        end
    )

    --========================================================
    -- CLEANUP
    --========================================================

    Connect(
        RunService.Heartbeat,
        function()

            if not Hub.Destroyed then
                return
            end

            LeftRelease()

            RestoreCamera()

            if RageOverlay then

                pcall(function()
                    RageOverlay:Destroy()
                end)

                RageOverlay = nil
            end

        end
    )

end

