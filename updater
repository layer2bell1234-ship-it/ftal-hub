--============================================================
-- PATCH HELPERS
--============================================================

local function replaceOnce(src,old,new)
    local a,b = string.find(src,old,1,true)

    if not a then
        warn("[FTAL 334] Patch target not found.")
        return src,false
    end

    return
        string.sub(src,1,a-1) ..
        new ..
        string.sub(src,b+1),
        true
end

local function replaceBetween(src,startText,endText,replacement)
    local a = string.find(src,startText,1,true)

    if not a then
        warn("[FTAL 334] Start patch target not found.")
        return src,false
    end

    local b = string.find(src,endText,a+1,true)

    if not b then
        warn("[FTAL 334] End patch target not found.")
        return src,false
    end

    return
        string.sub(src,1,a-1) ..
        replacement ..
        string.sub(src,b),
        true
end

