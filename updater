--============================================================
-- PATCH HELPERS
--============================================================

local function replaceOnce(src, old, new, name)
    local a, b = string.find(src, old, 1, true)

    if not a then
        warn(
            "[FTAL 334] PATCH FAILED:",
            name or "unnamed patch"
        )
        return src, false
    end

    local result =
        string.sub(src, 1, a - 1)
        ..
        new
        ..
        string.sub(src, b + 1)

    print(
        "[FTAL 334] PATCH OK:",
        name or "unnamed patch"
    )

    return result, true
end

local function assertPatch(okPatch, name)
    if not okPatch then
        error(
            "[FTAL 334] Required patch failed: "
            ..
            tostring(name)
        )
    end
end

