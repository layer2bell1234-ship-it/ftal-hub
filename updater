-- 12. RUNTIME PATCH
--
-- RAGE:
--   • Spinbot
--   • Aimbot
--   • Triggerbot
--   • Third person
--
-- SPINBOT:
--   • Does not take control of camera
--   • Humanoid AutoRotate disabled
--   • Camera remains freely controllable
--   • Shift lock remains usable
--
-- TRIGGERBOT:
--   • Checks center of screen
--   • Requires actual visible enemy
--   • Holds left click while target is visible
--============================================================

source = source .. [[

--============================================================
-- FTAL 334 GITHUB UPDATE RUNTIME
--============================================================

do

    local RagePreviousCameraMode
    local RagePreviousMinZoom
    local RagePreviousMaxZoom
    local RagePreviousMouseLock

    local RageCameraSaved = false

    local TriggerHeld = false

    --========================================================
    -- INPUT NAME
    --========================================================

    local function GetKeybindName()

        if Hub.State.AimbotKeyType == "Keyboard" then

            if Hub.State.AimbotKey then
                return Hub.State.AimbotKey.Name
            end

            return "NONE"
        end

        if Hub.State.AimbotKey ==
            Enum.UserInputType.MouseButton1 then

            return "LMB"

        elseif Hub.State.AimbotKey ==
            Enum.UserInputType.MouseButton2 then

            return "RMB"

        elseif Hub.State.AimbotKey ==
            Enum.UserInputType.MouseButton3 then

            return "MMB"
        end

        return "NONE"
    end

    --========================================================
    -- FORCE THIRD PERSON FOR RAGE
    --========================================================

    local function SetRageCamera(active)

        if active then

            if not RageCameraSaved then

                RagePreviousCameraMode =
                    LocalPlayer.CameraMode

                RagePreviousMinZoom =
                    LocalPlayer.CameraMinZoomDistance

                RagePreviousMaxZoom =
                    LocalPlayer.CameraMaxZoomDistance

                pcall(function()
                    RagePreviousMouseLock =
                        LocalPlayer.DevEnableMouseLock
                end)

                RageCameraSaved = true
            end

            LocalPlayer.CameraMode =
                Enum.CameraMode.Classic

            LocalPlayer.CameraMinZoomDistance =
                8

            LocalPlayer.CameraMaxZoomDistance =
                14

            pcall(function()

                LocalPlayer.DevEnableMouseLock =
                    true

            end)

            Camera.CameraType =
                Enum.CameraType.Custom

        else

            if RageCameraSaved then

                LocalPlayer.CameraMode =
                    RagePreviousCameraMode
                    or Enum.CameraMode.Classic

                LocalPlayer.CameraMinZoomDistance =
                    RagePreviousMinZoom
                    or .5

                LocalPlayer.CameraMaxZoomDistance =
                    RagePreviousMaxZoom
                    or 12.5

                pcall(function()

                    if RagePreviousMouseLock ~= nil then

                        LocalPlayer.DevEnableMouseLock =
                            RagePreviousMouseLock
                    end

                end)
            end

            RageCameraSaved = false
        end
    end

    --========================================================
    -- SPINBOT
    -- CAMERA IS NEVER ROTATED BY THE SPIN
    --========================================================

    Connect(
        RunService.RenderStepped,
        function()

            local spinning =
                Hub.State.Spinbot == true

            local character =
                LocalPlayer.Character

            local root =
                character
                and
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            local humanoid =
                character
                and
                character:FindFirstChildOfClass(
                    "Humanoid"
                )

            if spinning then

                if humanoid then

                    humanoid.AutoRotate = false
                end

                if root then

                    local position =
                        root.Position

                    local rotation =
                        CFrame.Angles(
                            0,
                            math.rad(
                                Hub.State.SpinbotSpeed
                            ),
                            0
                        )

                    root.CFrame =
                        CFrame.new(position)
                        * rotation
                end

            elseif humanoid then

                humanoid.AutoRotate = true
            end
        end
    )

    --========================================================
    -- RAGE CAMERA
    --========================================================

    Connect(
        RunService.RenderStepped,
        function()

            if Hub.State.RAGE then

                SetRageCamera(true)

            else

                SetRageCamera(false)
            end
        end
    )

    --========================================================
    -- TRIGGERBOT HELPERS
    --========================================================

    local function IsTriggerEnemy(player)

        if not player
            or player == LocalPlayer then

            return false
        end

        if Hub.State.AimbotTeamCheck
            and LocalPlayer.Team
            and player.Team
            and LocalPlayer.Team ==
                player.Team then

            return false
        end

        return true
    end

    local function GetTriggerTarget()

        local character =
            LocalPlayer.Character

        local myRoot =
            character
            and
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not myRoot then
            return nil
        end

        local viewport =
            Camera.ViewportSize

        local centerX =
            viewport.X / 2

        local centerY =
            viewport.Y / 2

        local ray =
            Camera:ViewportPointToRay(
                centerX,
                centerY
            )

        local direction =
            ray.Direction
            *
            (Hub.State.TriggerbotRange or 150)

        local params =
            RaycastParams.new()

        params.FilterType =
            Enum.RaycastFilterType.Exclude

        params.FilterDescendantsInstances = {
            character
        }

        local result =
            workspace:Raycast(
                ray.Origin,
                direction,
                params
            )

        if not result then
            return nil
        end

        local hit =
            result.Instance

        local targetCharacter =
            hit:FindFirstAncestorOfClass(
                "Model"
            )

        if not targetCharacter then
            return nil
        end

        local targetPlayer =
            Players:GetPlayerFromCharacter(
                targetCharacter
            )

        if not IsTriggerEnemy(targetPlayer) then
            return nil
        end

        local humanoid =
            targetCharacter:FindFirstChildOfClass(
                "Humanoid"
            )

        if not humanoid
            or humanoid.Health <= 0 then

            return nil
        end

        local targetRoot =
            targetCharacter:FindFirstChild(
                "HumanoidRootPart"
            )

        if not targetRoot then
            return nil
        end

        local distance =
            (
                myRoot.Position -
                targetRoot.Position
            ).Magnitude

        if distance >
            (Hub.State.TriggerbotRange or 150) then

            return nil
        end

        return targetPlayer
    end

    --========================================================
    -- LEFT CLICK
    --========================================================

    local function HoldLeftClick()

        if TriggerHeld then
            return
        end

        TriggerHeld = true

        if mouse1press then

            pcall(function()
                mouse1press()
            end)

            return
        end

        pcall(function()

            local VirtualUser =
                game:GetService("VirtualUser")

            VirtualUser:Button1Down(
                Vector2.new(
                    Camera.ViewportSize.X / 2,
                    Camera.ViewportSize.Y / 2
                ),
                Camera.CFrame
            )

        end)
    end

    local function ReleaseLeftClick()

        if not TriggerHeld then
            return
        end

        TriggerHeld = false

        if mouse1release then

            pcall(function()
                mouse1release()
            end)

            return
        end

        pcall(function()

            local VirtualUser =
                game:GetService("VirtualUser")

            VirtualUser:Button1Up(
                Vector2.new(
                    Camera.ViewportSize.X / 2,
                    Camera.ViewportSize.Y / 2
                ),
                Camera.CFrame
            )

        end)
    end

    --========================================================
    -- TRIGGERBOT LOOP
    --========================================================

    Connect(
        RunService.RenderStepped,
        function()

            if not Hub.State.RAGE
                or not Hub.State.Triggerbot then

                ReleaseLeftClick()

                return
            end

            local target =
                GetTriggerTarget()

            if target then

                HoldLeftClick()

                -- Default LMB also activates the aimbot.
                if Hub.State.AimbotKeyType ==
                    "Mouse"
                    and
                    Hub.State.AimbotKey ==
                        Enum.UserInputType.MouseButton1 then

                    Hub.State.AimbotHolding = true
                end

            else

                ReleaseLeftClick()

                if Hub.State.AimbotKeyType ==
                    "Mouse"
                    and
                    Hub.State.AimbotKey ==
                        Enum.UserInputType.MouseButton1 then

                    Hub.State.AimbotHolding = false
                end
            end
        end
    )

    --========================================================
    -- KEYBIND LIST
    --========================================================

    local KeybindListFrame =
        Instance.new("Frame")

    KeybindListFrame.Name =
        "FTAL_KeybindList"

    KeybindListFrame.AnchorPoint =
        Vector2.new(1,0)

    KeybindListFrame.Position =
        UDim2.new(1,-15,0,15)

    KeybindListFrame.Size =
        UDim2.fromOffset(190,55)

    KeybindListFrame.BackgroundColor3 =
        Theme.Background2

    KeybindListFrame.BackgroundTransparency =
        .35

    KeybindListFrame.BorderSizePixel = 0

    KeybindListFrame.ZIndex = 2000

    KeybindListFrame.Visible =
        Hub.State.KeybindList == true

    KeybindListFrame.Parent = Gui

    Round(
        KeybindListFrame,
        5
    )

    Stroke(
        KeybindListFrame,
        Theme.Border
    )

    local KeybindTitle =
        Instance.new("TextLabel")

    KeybindTitle.BackgroundTransparency = 1

    KeybindTitle.Position =
        UDim2.fromOffset(9,5)

    KeybindTitle.Size =
        UDim2.new(1,-18,0,15)

    KeybindTitle.Font =
        Enum.Font.GothamBold

    KeybindTitle.Text =
        "KEYBINDS"

    KeybindTitle.TextSize = 8

    KeybindTitle.TextColor3 =
        Theme.Muted

    KeybindTitle.TextXAlignment =
        Enum.TextXAlignment.Left

    KeybindTitle.ZIndex = 2001

    KeybindTitle.Parent =
        KeybindListFrame

    local KeybindText =
        Instance.new("TextLabel")

    KeybindText.BackgroundTransparency = 1

    KeybindText.Position =
        UDim2.fromOffset(9,20)

    KeybindText.Size =
        UDim2.new(1,-18,1,-24)

    KeybindText.Font =
        Enum.Font.Gotham

    KeybindText.TextSize = 9

    KeybindText.TextColor3 =
        Theme.Text

    KeybindText.TextXAlignment =
        Enum.TextXAlignment.Left

    KeybindText.TextYAlignment =
        Enum.TextYAlignment.Top

    KeybindText.ZIndex = 2001

    KeybindText.Parent =
        KeybindListFrame

    Connect(
        RunService.RenderStepped,
        function()

            KeybindListFrame.Visible =
                Hub.State.KeybindList == true

            if not KeybindListFrame.Visible then
                return
            end

            local rows = {}

            -- AIMBOT
            if Hub.State.AimbotKey then

                local state =
                    Hub.State.Aimbot
                    and
                    Hub.State.AimbotHolding

                table.insert(
                    rows,
                    "Aimbot  [" ..
                    GetKeybindName() ..
                    "]  " ..
                    (state and "ON" or "OFF")
                )
            end

            -- KILL AURA
            if Hub.State.KillAuraKey then

                table.insert(
                    rows,
                    "Kill Aura  [" ..
                    Hub.State.KillAuraKey.Name ..
                    "]  " ..
                    (
                        Hub.State.KillAura
                        and "ON"
                        or "OFF"
                    )
                )
            end

            if #rows == 0 then

                KeybindText.Text =
                    "No keybinds"

                KeybindListFrame.Size =
                    UDim2.fromOffset(
                        190,
                        55
                    )

            else

                KeybindText.Text =
                    table.concat(
                        rows,
                        "\n"
                    )

                KeybindListFrame.Size =
                    UDim2.fromOffset(
                        190,
                        25 + (#rows * 17)
                    )
            end
        end
    )

    --========================================================
    -- SETTINGS TOGGLE SYNC
    --========================================================

    Connect(
        RunService.Heartbeat,
        function()

            if KeybindListFrame then

                KeybindListFrame.Visible =
                    Hub.State.KeybindList == true
            end
        end
    )

    --========================================================
    -- RELEASE CLICK WHEN WINDOW LOSES FOCUS
    --========================================================

    Connect(
        UserInputService.WindowFocusReleased,
        function()

            ReleaseLeftClick()

            Hub.State.AimbotHolding =
                false
        end
    )

    --========================================================
    -- RAGE RESPAWN CAMERA
    --========================================================

    Connect(
        LocalPlayer.CharacterAdded,
        function()

            task.wait(.2)

            if Hub.State.RAGE then

                SetRageCamera(true)

            end
        end
    )

    --========================================================
    -- RAGE UNLOAD CLEANUP
    --========================================================

    local oldStop =
        _G.StopFTALSHub

    _G.StopFTALSHub =
        function()

            ReleaseLeftClick()

            Hub.State.RAGE = false
            Hub.State.Triggerbot = false
            Hub.State.AimbotHolding = false

            SetRageCamera(false)

            pcall(function()

                local character =
                    LocalPlayer.Character

                local humanoid =
                    character
                    and
                    character:FindFirstChildOfClass(
                        "Humanoid"
                    )

                if humanoid then
                    humanoid.AutoRotate = true
                end

            end)

            if oldStop then
                oldStop()
            end
        end
end

]]

