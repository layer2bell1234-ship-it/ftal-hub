local function DrawSkeleton(data,char,color)

    local pairsToUse

    if char:FindFirstChild("UpperTorso")
        and char:FindFirstChild("LowerTorso") then

        pairsToUse = R15SkeletonPairs

    else

        pairsToUse = R6SkeletonPairs
    end

    local lineIndex = 1

    for _,pair in ipairs(pairsToUse) do

        local a =
            char:FindFirstChild(pair[1])

        local b =
            char:FindFirstChild(pair[2])

        if a
            and b
            and a ~= b
            and lineIndex <= #data.Skeleton then

            local ap = Project(a)
            local bp = Project(b)

            if ap and bp then

                SetLine(
                    data.Skeleton[lineIndex],
                    ap,
                    bp,
                    color,
                    1
                )

            else

                data.Skeleton[lineIndex].Visible = false
            end

            lineIndex += 1
        end
    end

    for i=lineIndex,#data.Skeleton do
        data.Skeleton[i].Visible = false
    end
end
