            if not target then

                Hub.State.AimbotHolding = false

                return
            end

            local character =
                target.Character

            local aimPart =
                character
                and (
                    character:FindFirstChild("Head")
                    or character:FindFirstChild(
                        "HumanoidRootPart"
                    )
                )

            if not aimPart then
                return
            end

            local cameraPosition =
                Camera.CFrame.Position

            Camera.CFrame =
                CFrame.lookAt(
                    cameraPosition,
                    aimPart.Position
                )

            Hub.State.AimbotHolding = true

        end
    )

    --========================================================
    -- TRIGGERBOT TARGET
    --========================================================

    local function GetTriggerTarget()

        local character =
            LocalPlayer.Character

        if not character then
            return nil
        end

        local viewport =
            Camera.ViewportSize

        local ray =
            Camera:ViewportPointToRay(
                viewport.X / 2,
                viewport.Y / 2
            )

        local params =
            RaycastParams.new()

        params.FilterType =
            Enum.RaycastFilterType.Exclude

        params.FilterDescendantsInstances = {
            character
        }

        local result =
            workspace:Raycast(
                ray.Origin,
                ray.Direction *
                (Hub.State.TriggerbotRange or 150),
                params
            )

        if not result then
            return nil
        end

        local targetCharacter =
            result.Instance:FindFirstAncestorOfClass(
                "Model"
            )

        if not targetCharacter then
            return nil
        end

        local targetPlayer =
            Players:GetPlayerFromCharacter(
                targetCharacter
            )

        if not IsValidRageTarget(targetPlayer) then
            return nil
        end

        return targetPlayer
    end

    --========================================================
    -- CLICK CONTROL
    --========================================================

    local function HoldLeftClick()

        if TriggerHeld then
            return
        end

        TriggerHeld = true

        if mouse1press then

            pcall(function()
                mouse1press()
            end)

        else

            pcall(function()

                local VirtualUser =
                    game:GetService(
                        "VirtualUser"
                    )

                VirtualUser:Button1Down(
                    Vector2.new(
                        Camera.ViewportSize.X / 2,
                        Camera.ViewportSize.Y / 2
                    ),
                    Camera.CFrame
                )

            end)
        end
    end

    local function ReleaseLeftClick()

        if not TriggerHeld then
            return
        end

        TriggerHeld = false

        if mouse1release then

            pcall(function()
                mouse1release()
            end)

        else

            pcall(function()

                local VirtualUser =
                    game:GetService(
                        "VirtualUser"
                    )

                VirtualUser:Button1Up(
                    Vector2.new(
                        Camera.ViewportSize.X / 2,
                        Camera.ViewportSize.Y / 2
                    ),
                    Camera.CFrame
                )

            end)
        end
    end

    --========================================================
    -- INSTANT TRIGGERBOT
    --========================================================

    Connect(
        RunService.RenderStepped,
        function()

            if not Hub.State.RAGE
                or not Hub.State.Triggerbot then

                ReleaseLeftClick()

                return
            end

            local target =
                GetTriggerTarget()

            if target then

                HoldLeftClick()

            else

                ReleaseLeftClick()

            end

        end
    )

    --========================================================
    -- RELEASE WHEN WINDOW LOSES FOCUS
    --========================================================

    Connect(
        UserInputService.WindowFocusReleased,
        function()

            ReleaseLeftClick()

            Hub.State.AimbotHolding =
                false

        end
    )

    --========================================================
    -- RESPAWN
    --========================================================

    Connect(
        LocalPlayer.CharacterAdded,
        function()

            task.wait(.2)

            if Hub.State.RAGE then
                SetRageCamera(true)
            end

        end
    )

end

