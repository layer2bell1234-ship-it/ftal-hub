-- FTAL 334 - MOVEMENT SPINBOT
-- First person / third person / shift lock
-- Character spins while camera stays visually still
--============================================================--

local SPINBOT_BIND_NAME = "FTAL_MovementSpinbot"

local function MovementSpinbot(dt)
    local character = LocalPlayer.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        return
    end

    -- Spinbot is controlled ONLY by the Movement tab toggle
    if not Hub.State.Spinbot then
        humanoid.AutoRotate = true
        return
    end

    -- Stop Roblox from automatically turning the character
    humanoid.AutoRotate = false

    -- Save the exact camera transform before rotating the character
    local cameraCF = Camera.CFrame

    -- Speed in degrees per second
    local speed = tonumber(Hub.State.SpinbotSpeed) or 900

    -- Rotate character around its Y axis
    root.CFrame =
        root.CFrame *
        CFrame.Angles(0, math.rad(speed) * dt, 0)

    -- Restore camera so the player's view does not spin
    Camera.CFrame = cameraCF
end

