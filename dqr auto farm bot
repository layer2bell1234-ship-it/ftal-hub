local function SetLine(line,from,to,color,thickness)
    local delta = to-from
    if delta.Magnitude < .5 then
        line.Visible = false
        return
    end

    line.Position = UDim2.fromOffset((from.X+to.X)/2,(from.Y+to.Y)/2)
    line.Size = UDim2.fromOffset(delta.Magnitude,thickness or 1)
    line.Rotation = math.deg(math.atan2(delta.Y,delta.X))
    line.BackgroundColor3 = color
    line.Visible = true
end

local function HideESP(data)
    data.Highlight.Enabled = false
    data.Billboard.Enabled = false
    data.Tracer.Visible = false
    data.HeadDot.Visible = false

    for _,line in ipairs(data.Box) do line.Visible = false end
    for _,line in ipairs(data.Skeleton) do line.Visible = false end
end

local function WallVisible(char,root)
    if not Hub.State.ESPWallCheck then return true end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character,char}

    local result = workspace:Raycast(
        Camera.CFrame.Position,
        root.Position-Camera.CFrame.Position,
        params
    )

    return result == nil
end

-- WorldToViewportPoint returns viewport coordinates. Gui.IgnoreGuiInset=true
-- above makes these coordinates line up with the drawing layer.
local function Project(part)
    if not part then return nil end

    local pos,onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen or pos.Z <= 0 then return nil end

    return Vector2.new(pos.X,pos.Y)
end

-- More stable than the old head/root-only box: project the character's
-- actual bounding box so boxes stay centered and sized correctly at angles.
local function DrawBox(data,char,color)
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local cf,size = char:GetBoundingBox()
    local half = size/2

    local corners = {
        cf * Vector3.new(-half.X,-half.Y,-half.Z),
        cf * Vector3.new(-half.X,-half.Y, half.Z),
        cf * Vector3.new(-half.X, half.Y,-half.Z),
        cf * Vector3.new(-half.X, half.Y, half.Z),
        cf * Vector3.new( half.X,-half.Y,-half.Z),
        cf * Vector3.new( half.X,-half.Y, half.Z),
        cf * Vector3.new( half.X, half.Y,-half.Z),
        cf * Vector3.new( half.X, half.Y, half.Z),
    }

    local minX,minY = math.huge,math.huge
    local maxX,maxY = -math.huge,-math.huge
    local visible = false

    for _,point in ipairs(corners) do
        local p,onScreen = Camera:WorldToViewportPoint(point)
        if onScreen and p.Z > 0 then
            visible = true
            minX = math.min(minX,p.X)
            minY = math.min(minY,p.Y)
            maxX = math.max(maxX,p.X)
            maxY = math.max(maxY,p.Y)
        end
    end

    if not visible then
        for _,line in ipairs(data.Box) do line.Visible = false end
        return
    end

    local tl = Vector2.new(minX,minY)
    local tr = Vector2.new(maxX,minY)
    local br = Vector2.new(maxX,maxY)
    local bl = Vector2.new(minX,maxY)

    SetLine(data.Box[1],tl,tr,color,1)
    SetLine(data.Box[2],tr,br,color,1)
    SetLine(data.Box[3],br,bl,color,1)
    SetLine(data.Box[4],bl,tl,color,1)
end

