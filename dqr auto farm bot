local function FlingPlayer(target)
    if not target or not target.Character then return end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return end

    local old = myRoot.CFrame
    local started = os.clock()
    local angle = 0

    while FlingActive and target.Parent and targetRoot.Parent and os.clock()-started < Hub.State.FlingDuration do
        angle += 55
        local offset = CFrame.new(0,math.sin(angle)*2,2)*CFrame.Angles(math.rad(angle),0,0)
        pcall(function()
            myRoot.CFrame = targetRoot.CFrame*offset
            myRoot.AssemblyLinearVelocity = Vector3.new(Hub.State.FlingStrength,Hub.State.FlingStrength,Hub.State.FlingStrength)
            myRoot.AssemblyAngularVelocity = Vector3.new(Hub.State.FlingStrength,Hub.State.FlingStrength,Hub.State.FlingStrength)
        end)
        RunService.Heartbeat:Wait()
    end

    pcall(function()
        myRoot.CFrame = old
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
    end)
end

