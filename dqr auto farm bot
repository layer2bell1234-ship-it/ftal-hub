local function RunUniversalStartWorker()
    if AutoStartDungeonWorkerRunning then return end
    if not IsAutoStartPlace() then
        SetFarmStatus("Auto Start: unavailable in this place.")
        return
    end
    if Hub.State.AutoDungeon then
        SetFarmStatus("Auto Start: Auto Dungeon already controls Start.")
        return
    end
    AutoStartDungeonWorkerRunning = true
    task.spawn(function()
        SetFarmStatus("Auto Start: starting in 5 seconds...")
        for _ = 1,50 do
            if not Hub.State.AutoStartDungeon or Hub.Destroyed then
                AutoStartDungeonWorkerRunning = false
                return
            end
            task.wait(0.1)
        end

        local armed = true
        while Hub.State.AutoStartDungeon and not Hub.Destroyed do
            if armed then
                local clicked = ClickUniversalStart()
                if clicked then
                    SetFarmStatus("Auto Start: clicked Start")
                    armed = false
                    task.wait(2.0)
                else
                    SetFarmStatus("Auto Start: click failed")
                    task.wait(0.5)
                end
            else
                task.wait(0.25)
            end
        end
        AutoStartDungeonWorkerRunning = false
    end)
end

local function RunAutoDungeonWorker()
    if AutoDungeonWorkerRunning then return end
    if not IsAutoDungeonPlace() then
        SetFarmStatus("Auto Dungeon: unavailable in this place.")
        return
    end
    AutoDungeonWorkerRunning = true
    task.spawn(function()
        local step = 1
        local level = 1
        local difficulty = "easy"
        local steps = {"play","create",difficulty,"lobby","start"}
        local lastButton
        local waitingSince = os.clock()
        SetFarmStatus("Auto Dungeon: starting in 7 seconds...")
        for _ = 1,70 do
            if not Hub.State.AutoDungeon or Hub.Destroyed then
                AutoDungeonWorkerRunning = false
                return
            end
            task.wait(0.1)
        end
        level = GetDungeonPlayerLevel()
        difficulty = GetHighestDungeonDifficulty(level)
        steps[3] = difficulty
        while Hub.State.AutoDungeon and not Hub.Destroyed do
            local kind = steps[step]
            -- Re-read the level immediately before the difficulty click.
            if step == 3 then
                local currentLevel = GetDungeonPlayerLevel()
                local currentDifficulty = GetHighestDungeonDifficulty(currentLevel)
                if currentDifficulty ~= difficulty then
                    level = currentLevel
                    difficulty = currentDifficulty
                    steps[3] = difficulty
                    kind = difficulty
                end
            end
            local button = FindDungeonButton(kind)
            -- Create Lobby is a custom panel in this UI; use its known
            -- screen-relative left-click target rather than a nested GUI
            -- object that may report the wrong bounds.
            if kind == "lobby" or kind == "start" then button = nil end
            if button and button ~= lastButton then
                lastButton = button
                waitingSince = os.clock()
                if ActivateDungeonButton(button) then
                    if kind == "lobby" and button:IsA("GuiButton") then
                        pcall(function() button:Activate() end)
                    end
                    if kind == difficulty then
                        SetFarmStatus("Auto Dungeon: level "..level.." -> "..difficulty)
                    else
                        SetFarmStatus("Auto Dungeon: clicked "..kind)
                    end
                    step = step + 1
                    if step > #steps then
                        step = 1
                        lastButton = nil
                        task.wait(3.0)
                    else
                        task.wait(AutoDungeonClickDelay(kind))
                    end
                else
                    SetFarmStatus("Auto Dungeon: click failed")
                    task.wait(0.75)
                end
            else
                if not button then
                    lastButton = nil
                    if os.clock()-waitingSince >= 1.5 then
                        if ActivateDungeonPoint(DungeonFallbackPoint(kind)) then
                            SetFarmStatus("Auto Dungeon: left-clicked "..kind)
                            step = step + 1
                            waitingSince = os.clock()
                            if step > #steps then
                                step = 1
                                task.wait(3.0)
                            else
                                task.wait(AutoDungeonClickDelay(kind))
                            end
                        else
                            SetFarmStatus("Auto Dungeon: waiting for "..kind.."...")
                            task.wait(0.25)
                        end
                    else
                        SetFarmStatus("Auto Dungeon: waiting for "..kind.."...")
                        task.wait(0.25)
                    end
                else
                    task.wait(0.25)
                end
            end
        end
        AutoDungeonWorkerRunning = false
    end)
end

local function FarmMoveTo(humanoid,position,force)
    if not humanoid or not humanoid.Parent or not position then return end
    local now = os.clock()
    if not force and FarmLastMovePosition
        and (FarmLastMovePosition-position).Magnitude < 0.8
        and now-FarmLastMoveAt < 0.8 then
        return
    end
    FarmLastMovePosition = position
    FarmLastMoveAt = now
    humanoid:MoveTo(position)
end

local function SendFarmKey(key,down)
    if type(keypress) == "function" and type(keyrelease) == "function" then
        pcall(function()
            if down then keypress(key) else keyrelease(key) end
        end)
        return
    end
    local ok,virtualInput = pcall(function() return game:GetService("VirtualInputManager") end)
    if ok and virtualInput and Enum.KeyCode[key:upper()] then
        pcall(function() virtualInput:SendKeyEvent(down,Enum.KeyCode[key:upper()],false,game) end)
    end
end

local function SetFarmHeldKeys(keys)
    local wanted = {}
    for _,key in ipairs(keys or {}) do wanted[key] = true end
    for key in pairs(FarmHeldKeys) do
        if not wanted[key] then
            SendFarmKey(key,false)
            FarmHeldKeys[key] = nil
        end
    end
    for key in pairs(wanted) do
        if not FarmHeldKeys[key] then
            SendFarmKey(key,true)
            FarmHeldKeys[key] = true
        end
    end
end

local function ReleaseFarmKeys()
    SetFarmHeldKeys({})
end

