_G.StopFTALMovementVisuals = function()
    if Hub.Destroyed then return end
    Hub.Destroyed = true

    for _,c in ipairs(Hub.Connections) do
        pcall(function() c:Disconnect() end)
    end
    for _,c in pairs(Hub.ESPConnections) do
        pcall(function() c:Disconnect() end)
    end

    for _,data in pairs(Hub.ESP) do
        for _,obj in pairs(data) do
            if typeof(obj) == "Instance" then
                pcall(function() obj:Destroy() end)
            elseif type(obj) == "table" then
                for _,v in pairs(obj) do
                    if typeof(v) == "Instance" then
                        pcall(function() v:Destroy() end)
                    end
                end
            end
        end
    end

    Hub.ESP = {}
    if Hub.AutoFarmCleanup then
        pcall(Hub.AutoFarmCleanup)
        Hub.AutoFarmCleanup = nil
    end
    if Hub.AutoDungeonCleanup then
        pcall(Hub.AutoDungeonCleanup)
        Hub.AutoDungeonCleanup = nil
    end
    if Hub.AutoStartCleanup then
        pcall(Hub.AutoStartCleanup)
        Hub.AutoStartCleanup = nil
    end
end

