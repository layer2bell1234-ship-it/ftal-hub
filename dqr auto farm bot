    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Theme.Accent
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Round(fill,3)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(.5,.5)
    knob.Size = UDim2.fromOffset(12,12)
    knob.BackgroundColor3 = Theme.Text
    knob.BorderSizePixel = 0
    knob.Parent = bar
    Round(knob,6)

    local settingKey = SettingKeyByTitle[title]
    local savedValue = settingKey and Hub.State[settingKey]
    local value = type(savedValue) == "number" and savedValue or default
    local sliding = false

    local function setValue(v)
        value = math.clamp(v,min,max)
        local alpha = (value-min)/(max-min)
        fill.Size = UDim2.new(alpha,0,1,0)
        knob.Position = UDim2.new(alpha,0,.5,0)
        valueLabel.Text = math.floor(value) == value and tostring(math.floor(value)) or string.format("%.2f",value)
        callback(value)
        SaveSettings()
    end

    local function updateFromX(x)
        local width = math.max(bar.AbsoluteSize.X,1)
        local alpha = math.clamp((x-bar.AbsolutePosition.X)/width,0,1)
        setValue(min+(max-min)*alpha)
    end

    Connect(bar.InputBegan,function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            updateFromX(input.Position.X)
        end
    end)

    Connect(knob.InputBegan,function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
        end
    end)

    Connect(UserInputService.InputChanged,function(input)
        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(input.Position.X)
        end
    end)

    Connect(UserInputService.InputEnded,function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = false
        end
    end)

    setValue(default)
    return c
end

