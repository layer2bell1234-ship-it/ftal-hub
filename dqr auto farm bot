local function WinterBossHazardClearance(position,hazard)
if hazard.shape== "CIRCLE" then
local delta= __FTV3(
position.X-hazard.center.X,
0,
position.Z-hazard.center.Z
)
return delta.Magnitude-hazard.radius
end
local sample= __FTV3(position.X,hazard.cframe.Position.Y,position.Z)
local localPoint= hazard.cframe:PointToObjectSpace(sample)
local halfX= hazard.size.X*0.5+hazard.margin
local halfZ= hazard.size.Z*0.5+hazard.margin
local outsideX= math.abs(localPoint.X)-halfX
local outsideZ= math.abs(localPoint.Z)-halfZ
if outsideX <= 0 and outsideZ <= 0 then
return math.max(outsideX,outsideZ)
end
return math.sqrt(math.max(0,outsideX)^2+math.max(0,outsideZ)^2)
end
local function WinterBossPointClearance(position,hazards)
local clearance= math.huge
for _,hazard in ipairs(hazards) do
clearance= math.min(clearance,WinterBossHazardClearance(position,hazard))
end
return clearance
end
local function WinterBossPointReachable(root,position,hazards)
local exclusions= {LocalPlayer.Character}
for _,hazard in ipairs(hazards) do
table.insert(exclusions,hazard.instance)
end
local params= RaycastParams.new()
params.FilterType= Enum.RaycastFilterType.Exclude
params.FilterDescendantsInstances= exclusions
local travel= __FTV3(position.X-root.Position.X,0,position.Z-root.Position.Z)
local wallHit= workspace:Raycast(root.Position+__FTV3(0,2.2,0),travel,params)
if wallHit and wallHit.Distance < math.max(0,travel.Magnitude-1.2) then
return false
end
local floorHit= workspace:Raycast(
position+__FTV3(0,6,0),
__FTV3(0,-15,0),
params
)
return floorHit ~= nil
end
local function GetWinterBossDirections(root)
local forward= __FTV3(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)
if forward.Magnitude < 0.05 then forward= __FTV3(0,0,-1) end
forward= forward.Unit
local right= __FTV3(-forward.Z,0,forward.X)
return {
forward,
(forward+right).Unit,
right,
(-forward+right).Unit,
-forward,
(-forward-right).Unit,
-right,
(forward-right).Unit,
}
end
local function FindClosestWinterBossSafePosition(root,hazards)
local currentClearance= WinterBossPointClearance(root.Position,hazards)
if currentClearance >= 1.5 then
return root.Position,currentClearance
end
local directions= GetWinterBossDirections(root)
for distance= 2,44,2 do
local bestPosition,bestClearance
for _,direction in ipairs(directions) do
local position= root.Position+direction*distance
local clearance= WinterBossPointClearance(position,hazards)
if clearance >= 1.5
and WinterBossPointReachable(root,position,hazards)
and (not bestClearance or clearance > bestClearance) then
bestPosition,bestClearance= position,clearance
end
end
if bestPosition then
return bestPosition,bestClearance
end
end
local bestPosition,bestClearance
for _,distance in ipairs({12,20,28,36,44}) do
for _,direction in ipairs(directions) do
local position= root.Position+direction*distance
local clearance= WinterBossPointClearance(position,hazards)
if WinterBossPointReachable(root,position,hazards)
and (not bestClearance or clearance > bestClearance) then
bestPosition,bestClearance= position,clearance
end
end
end
return bestPosition,bestClearance
end
