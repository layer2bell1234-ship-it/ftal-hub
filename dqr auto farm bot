local function StartTween()
    StopTween()
    if not TweenTarget then return end
    TweenActive = true

    TweenConnection = RunService.Heartbeat:Connect(function(dt)
        if not TweenActive or Hub.Destroyed then return end

        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local targetChar = TweenTarget.Character
        local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        if not root or not targetRoot then return end

