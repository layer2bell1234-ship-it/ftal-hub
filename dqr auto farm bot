Connect(UserInputService.InputBegan,function(input,gp)
    if gp then return end

    if Hub.State.WaitingForMenuKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            Hub.State.MenuKey = input.KeyCode
            Hub.State.WaitingForMenuKey = false
        end
        return
    end

    if input.KeyCode == Hub.State.MenuKey then
        Hub.State.Open = not Hub.State.Open
        Main.Visible = Hub.State.Open
    end
end)

-- Keep movement settings after respawn.
Connect(LocalPlayer.CharacterAdded,function(character)
    task.wait(.25)
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum and Hub.State.FTALSSpoof then
        hum.WalkSpeed = Hub.State.FTALSSpeed
    end
    if Hub.State.Noclip then
        StartNoclip()
    end
end)

Connect(Close.MouseButton1Click,function()
    Hub.State.Open = false
    Main.Visible = false
end)

-- RightShift is the default menu key. Click the top-left title area
-- with the middle mouse button to rebind it to the next keyboard key.
Connect(TopBar.InputBegan,function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        Hub.State.WaitingForMenuKey = true
    end
end)

