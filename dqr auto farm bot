local function SaveSettings()
    if type(writefile) ~= "function" then return end
    local data = {_configVersion = 1}
    for key,value in pairs(Hub.State) do
        if key ~= "Open" and key ~= "WaitingForMenuKey" then
            if type(value) == "boolean" or type(value) == "number" or type(value) == "string" then
                data[key] = value
            elseif typeof(value) == "Color3" then
                data[key] = {r = value.R, g = value.G, b = value.B}
            end
        end
    end
    pcall(function()
        writefile(SettingsFile,game:GetService("HttpService"):JSONEncode(data))
    end)
end

local function LoadSettings()
    if type(isfile) ~= "function" or type(readfile) ~= "function" or not isfile(SettingsFile) then return end
    local ok,data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(readfile(SettingsFile))
    end)
    if not ok or type(data) ~= "table" then return end
    for key,default in pairs(Hub.State) do
        local saved = data[key]
        if saved ~= nil and key ~= "Open" and key ~= "WaitingForMenuKey" then
            if type(saved) == type(default) and (type(default) == "boolean" or type(default) == "number" or type(default) == "string") then
                Hub.State[key] = saved
            elseif key == "ESPColor" and type(saved) == "table" and saved.r and saved.g and saved.b then
                Hub.State[key] = Color3.new(saved.r,saved.g,saved.b)
            end
        end
    end
    if data._configVersion == nil then
        Hub.State.FTALSSpeed = 19.82
        Hub.State.FarmScanRadius = 500
        Hub.State.FarmRepathInterval = 0.35
    end
end

