            if part:IsA("BasePart") then part.CanCollide = false end
        end

        local target = targetRoot.Position + Vector3.new(0,3,0)
        local offset = target-root.Position
        local distance = offset.Magnitude

        if distance <= 3 then
            root.CFrame = CFrame.new(target,targetRoot.Position)
            StopTween()
            return
        end

        local movement = math.min(distance,Hub.State.TweenSpeed*dt)
        root.CFrame = CFrame.new(root.Position + offset.Unit*movement,targetRoot.Position)
    end)
end

