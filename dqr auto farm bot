local function IsTrueAttribute(model, names)
    for _,name in ipairs(names) do
        if model:GetAttribute(name) == true then return true end
    end
    return false
end

local function IsAttackAnimationPlaying(humanoid)
    local ok,tracks = pcall(function() return humanoid:GetPlayingAnimationTracks() end)
    if not ok then return false end
    for _,track in ipairs(tracks) do
        local name = string.lower(track.Name or "")
        if track.IsPlaying and (name:find("attack") or name:find("charge")
            or name:find("slam") or name:find("lunge") or name:find("cast")
            or name:find("shoot") or name:find("spell") or name:find("beam")
            or name:find("magic")) then
            return true
        end
    end
    return false
end

local function GetLiveEnemies(position)
    local result = {}
    local scanRadius = Hub.State.FarmScanRadius or FARM_CONFIG.ScanRadius
    if Hub.State.FarmDungeon == "Winter Outpost (Legacy)" then
        scanRadius = math.max(scanRadius,FARM_CONFIG.WinterScanRadius)
    end
    for model,humanoid in pairs(NPCCandidates) do
        if not model.Parent or not humanoid:IsDescendantOf(model) then
            NPCCandidates[model] = nil
        elseif humanoid.Health > 0 and Players:GetPlayerFromCharacter(model) == nil
            and model ~= LocalPlayer.Character and IsFarmEnemy(model) then
            local root = GetTaggedRoot(model)
            if root and (root.Position-position).Magnitude <= scanRadius then
                table.insert(result,{model=model,humanoid=humanoid,root=root,distance=(root.Position-position).Magnitude})
            end
        end
    end
    table.sort(result,function(a,b) return a.distance < b.distance end)
    return result
end

local function SelectCombatGroup(position)
    local enemies = GetLiveEnemies(position)
    if #enemies == 0 then return nil,{},nil end

    local previousTarget = FarmCombatTarget
    local anchor = FarmCombatTarget
    local anchorHumanoid = anchor and NPCCandidates[anchor]
    if not anchor or not anchor.Parent or not anchorHumanoid or anchorHumanoid.Health <= 0
        or not IsFarmEnemy(anchor) or (GetTaggedRoot(anchor) and (GetTaggedRoot(anchor).Position-position).Magnitude > 90) then
        FarmCombatTarget = nil
        anchor = enemies[1].model
    end
    local anchorRoot = GetTaggedRoot(anchor) or enemies[1].root
    local group = {}
    for _,entry in ipairs(enemies) do
        if (entry.root.Position-anchorRoot.Position).Magnitude <= FARM_CONFIG.GroupRadius then
            table.insert(group,entry)
        end
    end
    if #group == 0 then group = {enemies[1]} end
    FarmCombatTarget = group[1].model
    if previousTarget ~= FarmCombatTarget then
        FarmCombatRangeActive = false
    end
    FarmCombatGroup = group
    return group[1].root,group,FarmCombatTarget
end

local function IsDesertBossAttack(model,humanoid)
    local modelName = string.lower(model.Name or "")
    if not (modelName:find("sand") and modelName:find("giant")) then return false end
    if IsTrueAttribute(model,{"Attacking","IsAttacking","Attack","Charging","Smash","FireLines","Telegraph","Warning"}) then
        return true
    end
    for _,descendant in ipairs(model:GetDescendants()) do
        local name = string.lower(descendant.Name or "")
        if name:find("fireline") or name:find("fire_line") or name:find("smash")
            or name:find("telegraph") or name:find("warning") or name:find("aoe") then
            if (descendant:IsA("BasePart") and descendant.Transparency < 0.95)
                or ((descendant:IsA("ParticleEmitter") or descendant:IsA("Beam")) and descendant.Enabled) then
                return true
            end
        end
    end
    return IsAttackAnimationPlaying(humanoid)
end

local function HasIncomingAttack(root,group)
    for _,entry in ipairs(group) do
        local enemyRoot,humanoid = entry.root,entry.humanoid
        local offset = root.Position-enemyRoot.Position
        local distance = offset.Magnitude
        if distance <= FARM_CONFIG.ThreatRadius then
            if IsTrueAttribute(entry.model,{"Attacking","IsAttacking","Attack","Charging","IsCharging","PreparingAttack"})
                or IsAttackAnimationPlaying(humanoid) or IsDesertBossAttack(entry.model,humanoid) then
                return true
            end
            local velocity = enemyRoot.AssemblyLinearVelocity
            local speed = velocity.Magnitude
            if speed >= 18 and speed > 0 and offset.Unit:Dot(velocity.Unit) > 0.62 then
                return true
            end
        end
    end
    return false
end

local function IsWinterRangedEnemy(model)
    local name = string.lower(model.Name or "")
    return name:find("frost wizard",1,true) ~= nil
        or name:find("wizard",1,true) ~= nil
        or name:find("ice mage",1,true) ~= nil
        or name:find("ranged",1,true) ~= nil
end

local function HasWinterRangedAttack(root,group)
    if WinterBeamVisibleAt(root) then return true end
    for _,entry in ipairs(group) do
        if IsWinterRangedEnemy(entry.model) then
            local distance = (root.Position-entry.root.Position).Magnitude
            if distance <= math.max(FARM_CONFIG.ScanRadius,110) then
                if IsTrueAttribute(entry.model,{"Attacking","IsAttacking","Attack","Casting","Cast","Charging","PreparingAttack","Beam","Projectile","IceBeam"})
                    or IsAttackAnimationPlaying(entry.humanoid) then
                    return true
                end
                for _,descendant in ipairs(entry.model:GetDescendants()) do
                    local name = string.lower(descendant.Name or "")
                    if descendant:IsA("BasePart") then
                        local size = descendant.Size
                        local longest = math.max(size.X,size.Y,size.Z)
                        local shortest = math.min(size.X,size.Y,size.Z)
                        local color = descendant.Color
                        local blueBeam = color.B > 0.42
                            and color.B > color.R*1.18
                            and color.B > color.G*0.92
                            and descendant.Transparency < 0.92
                            and longest >= 5
                            and longest >= math.max(shortest*3,3)
                        if blueBeam then return true end
                    elseif descendant:IsA("Beam") and descendant.Enabled then
                        local keypoints = descendant.Color.Keypoints
                        if #keypoints > 0 then
                            local color = keypoints[1].Value
                            if color.B > 0.42 and color.B > color.R*1.18
                                and color.B > color.G*0.92 then
                                return true
                            end
                        end
                    end
                    if name:find("projectile",1,true) or name:find("icebeam",1,true)
                        or name:find("ice_beam",1,true) or name:find("bolt",1,true)
                        or name:find("cast",1,true) then
                        if (descendant:IsA("BasePart") and descendant.Transparency < 0.95)
                            or ((descendant:IsA("Beam") or descendant:IsA("ParticleEmitter")) and descendant.Enabled) then
                            return true
                        end
                    end
                end
                -- Some Legacy Frost Wizards do not expose a useful cast
                -- attribute or animation. At stop distance, facing the
                -- player is a conservative ranged-threat signal.
                local toPlayer = root.Position-entry.root.Position
                if toPlayer.Magnitude > 0 then
                    local facing = entry.root.CFrame.LookVector:Dot(toPlayer.Unit)
                    if facing > 0.55 then return true end
                end
            end
        end
    end
    return false
end

local function IsGroupAggro(root,group)
    for _,entry in ipairs(group) do
        local offset = root.Position-entry.root.Position
        local distance = offset.Magnitude
        if distance <= 55 then
            if IsTrueAttribute(entry.model,{"Chasing","Aggro","Aggroed","TargetingPlayer","HasTarget","InCombat"}) then
                return true
            end
            local velocity = entry.root.AssemblyLinearVelocity
            if velocity.Magnitude >= 6 and distance > 0 and offset.Unit:Dot(velocity.Unit) > 0.45 then
                return true
            end
            local moveDirection = entry.humanoid.MoveDirection
            if moveDirection.Magnitude > 0.1 and distance > 0
                and offset.Unit:Dot(moveDirection.Unit) > 0.5
                and distance <= math.max(Hub.State.FarmStopDistance+12,18) then
                return true
            end
        end
    end
    return false
end

local function TapAbilityKey(key)
    local keyCode = Enum.KeyCode[key]
    if not keyCode then return false end
    local pressed = false
    if type(keypress) == "function" and type(keyrelease) == "function" then
        pressed = pcall(function()
            keypress(string.lower(key))
            task.wait(0.04)
            keyrelease(string.lower(key))
        end)
    end
    if not pressed then
        local ok,virtualInput = pcall(function() return game:GetService("VirtualInputManager") end)
        if ok and virtualInput then
            pressed = pcall(function()
                virtualInput:SendKeyEvent(true,keyCode,false,game)
                virtualInput:SendKeyEvent(false,keyCode,false,game)
            end)
        end
    end
    return pressed
end

local function UseCombatAbilities(aggro)
    if not aggro then return end
    local now = os.clock()
    if now-FarmLastAbilityAt < FARM_CONFIG.AbilityCooldown then return end
    FarmLastAbilityAt = now
    TapAbilityKey(FarmNextAbility)
    FarmNextAbility = FarmNextAbility == "Q" and "E" or "Q"
end

local function BeginRetreat(root,humanoid,group)
    local center = Vector3.zero
    for _,entry in ipairs(group) do center += entry.root.Position end
    if #group > 0 then center /= #group end
    local away = Vector3.new(root.Position.X-center.X,0,root.Position.Z-center.Z)
    if away.Magnitude < 0.05 then away = Vector3.new(0,0,1) end
    away = away.Unit
    local side = Vector3.new(-away.Z,0,away.X)
    FarmStrafeSign = -FarmStrafeSign
    local preferredSide = side*FarmStrafeSign
    local candidates = {
        (away*0.35+preferredSide).Unit,
        (away*0.2+preferredSide).Unit,
        preferredSide,
        away,
        (away-preferredSide*0.5).Unit,
    }
    local bestPosition,bestScore
    for _,direction in ipairs(candidates) do
        local position = root.Position+direction*FARM_CONFIG.RetreatDistance
        if IsDodgePointOpen(root,position,group) then
            local nearest = math.huge
            for _,entry in ipairs(group) do nearest = math.min(nearest,(position-entry.root.Position).Magnitude) end
            if not bestScore or nearest > bestScore then bestPosition,bestScore = position,nearest end
        end
    end
    if not bestPosition then return false end
    FarmRetreatWaypoints = nil
    FarmRetreatWaypointIndex = nil
    if FarmPathBlockedConnection then
        FarmPathBlockedConnection:Disconnect()
        FarmPathBlockedConnection = nil
    end
    FarmPath = nil
    FarmWaypoints = nil
    FarmWaypointIndex = nil
    FarmPathTarget = nil
    FarmPathRoot = nil
    FarmPathGoal = nil
    FarmNextRepathAt = 0
    FarmDodgePosition = bestPosition
    FarmDodgeUntil = os.clock()+FARM_CONFIG.DodgeDuration
    FarmState = "REPOSITIONING"
    FarmCombatRangeActive = true
    FarmContinuousMove = false
    FarmCombatMoveDirection = nil
    ReleaseFarmKeys()
    FarmMoveTo(humanoid,bestPosition,true)
    return true
end

local function FaceCombatTarget(root,humanoid,targetRoot)
    if not root or not humanoid or not targetRoot or not targetRoot.Parent then return end
    local lookPosition = Vector3.new(targetRoot.Position.X,root.Position.Y,targetRoot.Position.Z)
    if (lookPosition-root.Position).Magnitude < 0.05 then return end
    humanoid.AutoRotate = false
    root.CFrame = CFrame.lookAt(root.Position,lookPosition)
end

IsDodgePointOpen = function(root,position,group,extraIgnore)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local exclusions = {LocalPlayer.Character}
    if extraIgnore then table.insert(exclusions,extraIgnore) end
    rayParams.FilterDescendantsInstances = exclusions
    local direction = position-root.Position
    if workspace:Raycast(root.Position+Vector3.new(0,2,0),direction,rayParams) then return false end
    local floorHit = workspace:Raycast(position+Vector3.new(0,5,0),Vector3.new(0,-12,0),rayParams)
    if not floorHit then return false end
    for _,entry in ipairs(group) do
        if (position-entry.root.Position).Magnitude < 7 then return false end
    end
    return true
end

local function BeginDodge(root,humanoid,group)
    local now = os.clock()
    if now-FarmLastDodgeAt < FARM_CONFIG.DodgeCooldown then return false end
    local threat = Vector3.zero
    for _,entry in ipairs(group) do
        local delta = root.Position-entry.root.Position
        if delta.Magnitude > 0 then
            local velocity = entry.root.AssemblyLinearVelocity
            if velocity.Magnitude >= 8 and delta.Unit:Dot(velocity.Unit) > 0.35 then
                threat += velocity.Unit * math.clamp(velocity.Magnitude/20,0.5,2)
            else
                threat += delta.Unit * math.clamp(1/delta.Magnitude*12,0.2,1)
            end
        end
    end
    threat = Vector3.new(threat.X,0,threat.Z)
    if threat.Magnitude < 0.05 then threat = Vector3.new(0,0,-1) end
    threat = threat.Unit
    local side = Vector3.new(-threat.Z,0,threat.X)
    local candidates = {side,-side,-threat,(side-threat).Unit,(-side-threat).Unit}
    local bestPosition,bestScore
    for _,direction in ipairs(candidates) do
        local position = root.Position+direction*FARM_CONFIG.DodgeDistance
        if IsDodgePointOpen(root,position,group) then
            local nearest = math.huge
            for _,entry in ipairs(group) do nearest = math.min(nearest,(position-entry.root.Position).Magnitude) end
            local score = nearest + (direction:Dot(side) * 2)
            if not bestScore or score > bestScore then bestPosition,bestScore = position,score end
        end
    end
    if not bestPosition then return false end
    local lateral = root.CFrame:VectorToObjectSpace(bestPosition-root.Position)
    FarmDodgeKey = lateral.X >= 0 and "d" or "a"
    SetFarmHeldKeys({FarmDodgeKey})
    FarmDodgePosition = bestPosition
    FarmDodgeUntil = now+FARM_CONFIG.DodgeDuration
    FarmLastDodgeAt = now
    FarmState = "DODGING"
    FarmContinuousMove = false
    FarmCombatMoveDirection = nil
    FarmRetreatWaypoints = nil
    FarmRetreatWaypointIndex = nil
    if FarmPathBlockedConnection then
        FarmPathBlockedConnection:Disconnect()
        FarmPathBlockedConnection = nil
    end
    FarmPath = nil
    FarmWaypoints = nil
    FarmWaypointIndex = nil
    FarmPathTarget = nil
    FarmPathRoot = nil
    FarmPathGoal = nil
    FarmNextRepathAt = 0
    FarmMoveTo(humanoid,bestPosition,true)
    return true
end

local function BeginWinterRangedDodge(root,humanoid,group)
    local now = os.clock()
    if now-FarmLastDodgeAt < FARM_CONFIG.DodgeCooldown then return false end
    local center = Vector3.zero
    for _,entry in ipairs(group) do center += entry.root.Position end
    if #group > 0 then center /= #group end
    local away = Vector3.new(root.Position.X-center.X,0,root.Position.Z-center.Z)
    if away.Magnitude < 0.05 then away = Vector3.new(0,0,1) end
    away = away.Unit
    local side = Vector3.new(-away.Z,0,away.X)
    local candidates = {
        (away*0.8+side*1.1).Unit,
        (away*0.8-side*1.1).Unit,
        (away*0.55+side).Unit,
        (away*0.55-side).Unit,
    }
    local bestPosition,bestDirection,bestScore
    for _,direction in ipairs(candidates) do
        local position = root.Position+direction*FARM_CONFIG.DodgeDistance
        if IsDodgePointOpen(root,position,group) then
            local nearest = math.huge
            for _,entry in ipairs(group) do nearest = math.min(nearest,(position-entry.root.Position).Magnitude) end
            local score = nearest + direction:Dot(away)*5
            if not bestScore or score > bestScore then
                bestPosition,bestDirection,bestScore = position,direction,score
            end
        end
    end
    if not bestPosition then return false end
    local sideAmount = bestDirection:Dot(side)
    FarmStrafeSign = sideAmount >= 0 and 1 or -1
    FarmDodgeKey = FarmStrafeSign > 0 and "d" or "a"
    FarmDodgePosition = bestPosition
    FarmDodgeUntil = now+FARM_CONFIG.DodgeDuration
    FarmLastDodgeAt = now
    FarmState = "WINTER_DODGING"
    FarmContinuousMove = true
    FarmCombatMoveDirection = bestDirection
    FarmRetreatWaypoints = nil
    FarmRetreatWaypointIndex = nil
    if FarmPathBlockedConnection then
        FarmPathBlockedConnection:Disconnect()
        FarmPathBlockedConnection = nil
    end
    FarmPath = nil
    FarmWaypoints = nil
    FarmWaypointIndex = nil
    FarmPathTarget = nil
    FarmPathRoot = nil
    FarmPathGoal = nil
    FarmNextRepathAt = 0
    SetFarmHeldKeys({"s",FarmDodgeKey})
    FarmMoveTo(humanoid,bestPosition,true)
    return true
end

local function UpdateDodge(root,humanoid)
    if not FarmDodgePosition then return false end
    local telegraphDodge = FarmState == "WINTER TELEGRAPH DODGE"
    local currentTargetRoot = FarmCombatTarget and GetTaggedRoot(FarmCombatTarget)
    FaceCombatTarget(root,humanoid,currentTargetRoot)
    if os.clock() >= FarmDodgeUntil
        or (not telegraphDodge and (root.Position-FarmDodgePosition).Magnitude <= 2.5) then
        if FarmContinuousMove then humanoid:Move(Vector3.zero,false) end
        ReleaseFarmKeys()
        FarmDodgePosition = nil
        FarmDodgeUntil = 0
        FarmState = "REPOSITIONING"
        FarmContinuousMove = false
        FarmCombatMoveDirection = nil
        FarmDodgeKey = nil
        FarmRetreatWaypoints = nil
        FarmRetreatWaypointIndex = nil
        return false
    end
    if FarmContinuousMove and FarmCombatMoveDirection then
        SetFarmHeldKeys(telegraphDodge
            and {FarmDodgeKey or (FarmStrafeSign > 0 and "d" or "a")}
            or {"s",FarmStrafeSign > 0 and "d" or "a"})
        local winterDodge = Hub.State.FarmDungeon == "Winter Outpost (Legacy)"
        -- Keep the lateral dodge responsive even when the executor's
        -- keyboard bridge drops or delays held-key events.  This does not
        -- press W and it does not fight the facing controller.
        local retreatWaypoint = FarmRetreatWaypoints and FarmRetreatWaypoints[FarmRetreatWaypointIndex]
        while retreatWaypoint and (root.Position-retreatWaypoint.Position).Magnitude <= FARM_CONFIG.WaypointReachDistance do
            FarmRetreatWaypointIndex += 1
            retreatWaypoint = FarmRetreatWaypoints[FarmRetreatWaypointIndex]
        end
        if retreatWaypoint then
            local routeDirection = Vector3.new(
                retreatWaypoint.Position.X-root.Position.X,
                0,
                retreatWaypoint.Position.Z-root.Position.Z
            )
            if routeDirection.Magnitude > 0.1 then
                FarmCombatMoveDirection = routeDirection.Unit
            end
            if not winterDodge then
                FarmMoveTo(humanoid,retreatWaypoint.Position)
            end
        else
            if not winterDodge and not (type(keypress) == "function" and type(keyrelease) == "function") then
                FarmMoveTo(humanoid,FarmDodgePosition)
            end
        end
        if not telegraphDodge and currentTargetRoot and currentTargetRoot.Parent then
            local away = Vector3.new(root.Position.X-currentTargetRoot.Position.X,0,root.Position.Z-currentTargetRoot.Position.Z)
            if away.Magnitude > 0.05 then
                away = away.Unit
                local side = Vector3.new(-away.Z,0,away.X)*FarmStrafeSign
                if not retreatWaypoint then
                    FarmCombatMoveDirection = (away*0.3+side).Unit
                end
            end
        end
        if winterDodge then
            -- FaceCombatTarget keeps LookVector aimed at the wizard. Use the
            -- character axes directly so the dodge always has a real
            -- left/right component instead of only moving away.
            local backward = -root.CFrame.LookVector
            local lateral = root.CFrame.RightVector*FarmStrafeSign
            local dodgeDirection = telegraphDodge and FarmCombatMoveDirection or Vector3.new(
                backward.X*0.65+lateral.X,0,backward.Z*0.65+lateral.Z
            )
            if dodgeDirection.Magnitude > 0.05 then
                FarmCombatMoveDirection = dodgeDirection.Unit
                humanoid:Move(FarmCombatMoveDirection,false)
            end
        end
        -- Never synthesize W/A/S/D here. Keyboard injection can toggle the menu
        -- if its rebind is W; Humanoid:Move is the smooth equivalent and does
        -- not generate keyboard input events.
        -- FarmMoveTo above owns the retreat command. Keeping one movement
        -- controller active prevents MoveTo and Humanoid:Move fighting each other.
    else
        if FarmDodgeKey then SetFarmHeldKeys({FarmDodgeKey}) end
        humanoid:MoveTo(FarmDodgePosition)
    end
    return true
end

local function UpdateStuck(root)
    local now = os.clock()
    if not FarmLastRootPosition then FarmLastRootPosition = root.Position return false end
    if (root.Position-FarmLastRootPosition).Magnitude < 0.35 then
        if FarmStuckSince == 0 then FarmStuckSince = now end
    else
        FarmStuckSince = 0
    end
    FarmLastRootPosition = root.Position
    if FarmStuckSince > 0 and now-FarmStuckSince >= FARM_CONFIG.StuckTime then
        FarmStuckSince = 0
        FarmNextRepathAt = 0
        FarmState = "REPATHING"
        return true
    end
    return false
end

local function GetGroundApproachPoint(characterRoot, targetRoot)
    local away = Vector3.new(
        characterRoot.Position.X-targetRoot.Position.X,
        0,
        characterRoot.Position.Z-targetRoot.Position.Z
    )
    if away.Magnitude < 0.05 then
        away = Vector3.new(-targetRoot.CFrame.LookVector.X,0,-targetRoot.CFrame.LookVector.Z)
    end
    if away.Magnitude < 0.05 then away = Vector3.new(0,0,1) end
    return targetRoot.Position + away.Unit * Hub.State.FarmStopDistance
end

local function ComputeFarmPath(characterRoot, targetRoot, targetModel)
    local away = Vector3.new(characterRoot.Position.X-targetRoot.Position.X,0,characterRoot.Position.Z-targetRoot.Position.Z)
    if away.Magnitude < 0.05 then away = Vector3.new(-targetRoot.CFrame.LookVector.X,0,-targetRoot.CFrame.LookVector.Z) end
    if away.Magnitude < 0.05 then away = Vector3.new(0,0,1) end
    away = away.Unit
    local side = Vector3.new(-away.Z,0,away.X)
    local approachPoints = {
        targetRoot.Position + away * Hub.State.FarmStopDistance,
        targetRoot.Position - away * Hub.State.FarmStopDistance,
        targetRoot.Position + side * Hub.State.FarmStopDistance,
        targetRoot.Position - side * Hub.State.FarmStopDistance,
    }
    local path,destination
    for _,candidate in ipairs(approachPoints) do
        local attempt = PathfindingService:CreatePath({
            AgentRadius = FARM_CONFIG.AgentRadius,
            AgentHeight = FARM_CONFIG.AgentHeight,
            AgentCanJump = true,
            AgentCanClimb = true,
            WaypointSpacing = 2.5,
        })
        local ok = pcall(function()
            attempt:ComputeAsync(characterRoot.Position,candidate)
        end)
        if ok and attempt.Status == Enum.PathStatus.Success and #attempt:GetWaypoints() > 0 then
            path,destination = attempt,candidate
            break
        end
    end
    if not path then
        local fallback = approachPoints[1]
        -- A temporary path failure must not release and re-press W. Preserve
        -- pursuit input while the fallback MoveTo command keeps us moving.
        if FarmPathBlockedConnection then
            FarmPathBlockedConnection:Disconnect()
            FarmPathBlockedConnection = nil
        end
        FarmPath = nil
        FarmWaypoints = nil
        FarmWaypointIndex = nil
        FarmPathTarget = targetModel
        FarmPathRoot = characterRoot
        FarmPathGoal = fallback
        FarmNextRepathAt = os.clock()+0.35
        return false
    end

    if FarmPathBlockedConnection then
        FarmPathBlockedConnection:Disconnect()
        FarmPathBlockedConnection = nil
    end
    FarmPath = path
    FarmWaypoints = path:GetWaypoints()
    FarmWaypointIndex = #FarmWaypoints > 1 and 2 or 1
    FarmPathTarget = targetModel
    FarmPathRoot = characterRoot
    FarmPathGoal = destination
    FarmNextRepathAt = os.clock()+Hub.State.FarmRepathInterval
    FarmPathBlockedConnection = path.Blocked:Connect(function(blockedIndex)
        if FarmWaypointIndex and blockedIndex >= FarmWaypointIndex then
            FarmNextRepathAt = 0
        end
    end)
    return #FarmWaypoints > 0
end

local function FollowFarmPath(characterRoot, humanoid, targetRoot, targetModel)
    -- One persistent W hold for the entire normal route. Retreat calls
    -- ReleaseFarmKeys before taking control.
    SetFarmHeldKeys({"w"})
    local destination = GetGroundApproachPoint(characterRoot,targetRoot)
    local now = os.clock()
    if not FarmPath and FarmPathGoal and FarmPathTarget == targetModel
        and FarmPathRoot == characterRoot and now < FarmNextRepathAt then
        return false
    end
    local targetChanged = FarmPathTarget ~= targetModel
    local rootChanged = FarmPathRoot ~= characterRoot
    local targetMoved = not FarmPathGoal or (FarmPathGoal-destination).Magnitude > 6
    local shouldRepath = not FarmPath or not FarmWaypoints or targetChanged or rootChanged
        or targetMoved or now >= FarmNextRepathAt

    if shouldRepath and not ComputeFarmPath(characterRoot,targetRoot,targetModel) then
        ReleaseFarmKeys()
        FarmMoveTo(humanoid,destination)
        return true
    end

    local waypoint = FarmWaypoints and FarmWaypoints[FarmWaypointIndex]
    if not waypoint then
        if (characterRoot.Position-destination).Magnitude <= Hub.State.FarmStopDistance+1 then
            ReleaseFarmKeys()
            FarmMoveTo(humanoid,characterRoot.Position)
            return true
        end
        FarmNextRepathAt = 0
        FarmMoveTo(humanoid,destination)
        return true
    end

    while waypoint and (characterRoot.Position-waypoint.Position).Magnitude <= FARM_CONFIG.WaypointReachDistance do
        FarmWaypointIndex += 1
        waypoint = FarmWaypoints[FarmWaypointIndex]
    end
    -- Look farther down straight path sections so MoveTo does not pause at
    -- every tiny block. Sharp corners and jump points remain intact.
    while waypoint and waypoint.Action ~= Enum.PathWaypointAction.Jump do
        local nextWaypoint = FarmWaypoints[FarmWaypointIndex+1]
        if not nextWaypoint or nextWaypoint.Action == Enum.PathWaypointAction.Jump
            or (nextWaypoint.Position-characterRoot.Position).Magnitude > FARM_CONFIG.WinterRouteLookahead then
            break
        end
        local currentDirection = waypoint.Position-characterRoot.Position
        local nextDirection = nextWaypoint.Position-waypoint.Position
        if currentDirection.Magnitude > 0.1 and nextDirection.Magnitude > 0.1
            and currentDirection.Unit:Dot(nextDirection.Unit) < 0.72 then
            break
        end
        FarmWaypointIndex += 1
        waypoint = nextWaypoint
    end
    if waypoint then
        if waypoint.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
        FarmMoveTo(humanoid,waypoint.Position)
        return true
    end
    return false
end

local function TryAutoPickup(root, now)
    local remote = GetRemote(FARM_CONFIG.PickupRemote)
    if not remote then return end
    for _,pickup in ipairs(CollectionService:GetTagged(FARM_CONFIG.PickupTag)) do
        local pickupRoot = GetTaggedRoot(pickup)
        if pickupRoot and (pickupRoot.Position-root.Position).Magnitude <= FARM_CONFIG.PickupRange then
            local last = LastPickupAt[pickup] or 0
            if now-last >= 1 then
                LastPickupAt[pickup] = now
                remote:FireServer(pickup)
            end
        else
            LastPickupAt[pickup] = nil
        end
    end
end

local function BeginWinterTelegraphDodge(root,humanoid,group,suppliedThreat)
    local threat = suppliedThreat or GetWinterLaserThreat(root)
    if not threat then return false end
    local now = os.clock()
    if now-FarmLastDodgeAt < FARM_CONFIG.DodgeCooldown then return false end

    local away = Vector3.new(0,0,0)
    for _,entry in ipairs(group) do
        local delta = Vector3.new(root.Position.X-entry.root.Position.X,0,root.Position.Z-entry.root.Position.Z)
        if delta.Magnitude > 0.05 then away += delta.Unit end
    end
    if away.Magnitude < 0.05 then away = -threat.direction end
    away = Vector3.new(away.X,0,away.Z).Unit
    local beamDirection = Vector3.new(threat.direction.X,0,threat.direction.Z)
    if beamDirection.Magnitude < 0.05 then return false end
    beamDirection = beamDirection.Unit
    local side = Vector3.new(-beamDirection.Z,0,beamDirection.X)
    local candidates = {
        side, -side, (side+away*0.30).Unit, (-side+away*0.30).Unit,
        Vector3.new(-root.CFrame.LookVector.X,0,-root.CFrame.LookVector.Z).Unit,
    }
    local bestPosition,bestDirection,bestScore
    for _,direction in ipairs(candidates) do
        local position = root.Position+direction*FARM_CONFIG.DodgeDistance
        local offset = position-threat.origin
        local along = math.clamp(offset:Dot(threat.direction),0,threat.length)
        local closest = threat.origin+threat.direction*along
        local beamClearance = (position-closest).Magnitude
        if beamClearance >= 6 and IsDodgePointOpen(root,position,group,threat.instance) then
            local nearest = math.huge
            for _,entry in ipairs(group) do
                nearest = math.min(nearest,(position-entry.root.Position).Magnitude)
            end
            local score = beamClearance+nearest+direction:Dot(away)*4
            if not bestScore or score > bestScore then
                bestPosition,bestDirection,bestScore = position,direction,score
            end
        end
    end
    -- Detection must always win. If obstacle scoring cannot approve a point
    -- during the beam's ~0.21-second lifetime, still force a perpendicular
    -- dodge instead of silently remaining yellow.
    if not bestPosition then
        bestDirection = FarmStrafeSign >= 0 and side or -side
        bestPosition = root.Position+bestDirection*FARM_CONFIG.DodgeDistance
    end

    local localDirection = root.CFrame:VectorToObjectSpace(bestDirection)
    if localDirection.Z > 0.55 and math.abs(localDirection.Z) > math.abs(localDirection.X) then
        FarmDodgeKey = "s"
        FarmStrafeSign = localDirection.X >= 0 and 1 or -1
    else
        FarmStrafeSign = localDirection.X >= 0 and 1 or -1
        FarmDodgeKey = FarmStrafeSign > 0 and "d" or "a"
    end
    FarmDodgePosition = bestPosition
    FarmDodgeUntil = now+math.clamp(Hub.State.WinterRedDuration or 1.2,0.1,1.2)
    FarmLastDodgeAt = now
    FarmContinuousMove = true
    FarmCombatMoveDirection = bestDirection
    FarmRetreatWaypoints = nil
    FarmRetreatWaypointIndex = nil
    StopFarmPath(humanoid)
    FarmState = "WINTER TELEGRAPH DODGE"
    SetFarmHeldKeys({FarmDodgeKey})
    FarmMoveTo(humanoid,bestPosition,true)
    return true
end

local function StartInstantWinterLaserDodge(root,humanoid,wizardModel)
    if FarmDodgePosition then return false end
    local now = os.clock()
    if now-FarmLastDodgeAt < 0.10 then return false end

    -- Zero geometry work: alternate a pure left/right escape the instant the
    -- model exists. The exact hitBox detector remains only as a fallback.
    FarmStrafeSign = -FarmStrafeSign
    FarmDodgeKey = FarmStrafeSign > 0 and "d" or "a"
    local direction = root.CFrame.RightVector*FarmStrafeSign
    direction = Vector3.new(direction.X,0,direction.Z).Unit

    local faceModel = wizardModel or FarmCombatTarget
    StopFarmPath(humanoid)
    FarmCombatTarget = faceModel
    FarmDodgePosition = root.Position+direction*18
    FarmDodgeUntil = now+math.clamp(Hub.State.WinterRedDuration or 1.2,0.1,1.2)
    FarmLastDodgeAt = now
    FarmState = "WINTER TELEGRAPH DODGE"
    FarmContinuousMove = true
    FarmCombatMoveDirection = direction
    FarmRetreatWaypoints = nil
    FarmRetreatWaypointIndex = nil
    humanoid.AutoRotate = false
    local wizardRoot = faceModel and GetTaggedRoot(faceModel)
    if wizardRoot then FaceCombatTarget(root,humanoid,wizardRoot) end
    SetFarmHeldKeys({FarmDodgeKey})
    humanoid:Move(direction,false)
    SetFarmAOI(root,"DODGE")
    SetFarmStatus("WINTER: RED • immediate laser event • holding "..string.upper(FarmDodgeKey))
    return true
end

local function HasWinterRangedEnemyInAOI(root)
    local range = Hub.State.WinterAOIRange or 40
    local nearestModel,nearestDistance
    for model,enemyHumanoid in pairs(NPCCandidates) do
        if model and model.Parent and enemyHumanoid and enemyHumanoid.Health > 0
            and IsWinterRangedEnemy(model) then
            local enemyRoot = GetTaggedRoot(model)
            if enemyRoot then
                local delta = enemyRoot.Position-root.Position
                local distance = Vector3.new(delta.X,0,delta.Z).Magnitude
                if distance <= range and (not nearestDistance or distance < nearestDistance) then
                    nearestModel,nearestDistance = model,distance
                end
            end
        end
    end
    return nearestModel
end

FARM_CONFIG.WinterPrefireAnimationId = "110089313901179"
FARM_CONFIG.WinterAnimationConnections = setmetatable({},{__mode="k"})

local function AttachWinterPrefireAnimation(model,enemyHumanoid)
    if not model or not enemyHumanoid or FARM_CONFIG.WinterAnimationConnections[enemyHumanoid]
        or not IsWinterRangedEnemy(model) then return end
    local connection = enemyHumanoid.AnimationPlayed:Connect(function(track)
        local animation = track.Animation
        local animationId = tostring(animation and animation.AnimationId or ""):match("%d+")
        if animationId ~= FARM_CONFIG.WinterPrefireAnimationId
            or not Hub.State.AutoFarm or Hub.State.FarmDungeon ~= "Winter Outpost (Legacy)"
            or Hub.Destroyed then return end

        local root,humanoid = GetFarmRoot()
        local enemyRoot = GetTaggedRoot(model)
        if not root or not humanoid or humanoid.Health <= 0 or not enemyRoot then return end
        local delta = enemyRoot.Position-root.Position
        if Vector3.new(delta.X,0,delta.Z).Magnitude > (Hub.State.WinterAOIRange or 40) then return end

        if StartInstantWinterLaserDodge(root,humanoid,model) then
            SetFarmStatus("WINTER: RED • exact wizard pre-fire • holding "..string.upper(FarmDodgeKey))
        end
    end)
    FARM_CONFIG.WinterAnimationConnections[enemyHumanoid] = connection
    table.insert(Hub.Connections,connection)
end

for model,enemyHumanoid in pairs(NPCCandidates) do
    AttachWinterPrefireAnimation(model,enemyHumanoid)
end

table.insert(Hub.Connections,workspace.DescendantAdded:Connect(function(instance)
    if instance:IsA("Humanoid") then
        local model = instance.Parent
        if model and model:IsA("Model") then
