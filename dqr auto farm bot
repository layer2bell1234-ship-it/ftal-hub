local function WinterBeamVisibleAt(root)
    local now = os.clock()
    if now < FarmBeamThreatUntil then return true end
    if now-FarmBeamScanAt < 0.04 then return false end
    FarmBeamScanAt = now
    local found = false
    pcall(function()
        for _,object in ipairs(workspace:GetDescendants()) do
            if string.lower(object.Name or "") == "laserbeam" then
                if object:IsA("Beam") and object.Enabled then
                    found = true
                    break
                elseif object:IsA("BasePart") and object.Transparency < 0.92 then
                    found = true
                    break
                elseif object:IsA("ParticleEmitter") and object.Enabled then
                    found = true
                    break
                end
            end
            if object:IsA("Beam") and object.Enabled then
                local keypoints = object.Color.Keypoints
                local color = keypoints[1] and keypoints[1].Value
                if color and color.B > 0.42 and color.B > color.R*1.15
                    and color.B > color.G*0.90 then
                    local a0,a1 = object.Attachment0,object.Attachment1
                    if a0 then
                        local origin = a0.WorldPosition
                        local direction,length
                        if a1 then
                            local delta = a1.WorldPosition-origin
                            length = delta.Magnitude
                            if length > 0 then direction = delta.Unit end
                        else
                            direction = a0.WorldCFrame.LookVector
                            length = 100
                        end
                        if direction and length then
                            local offset = root.Position-origin
                            local along = offset:Dot(direction)
                            local closest = origin+direction*math.clamp(along,0,length)
                            if along >= -8 and along <= length+8
                                and (root.Position-closest).Magnitude <= 10 then
                                found = true
                                break
                            end
                        end
                    end
                end
            end
        end
    end)
    if found then
        FarmBeamThreatUntil = now+0.30
        return true
    end
    return false
end

local function GetWinterLaserThreat(root)
    local now = os.clock()
    if now-(FARM_CONFIG.LastLaserThreatScanAt or 0) < 0.015 then
        return FARM_CONFIG.LastLaserThreat
    end
    FARM_CONFIG.LastLaserThreatScanAt = now
    local result
    pcall(function()
        -- Legacy Winter Outpost creates Workspace.laserBeam as a Model for
        -- only ~0.21 seconds. Its hitBox is the real 50x1.3x1.3 attack line.
        local laserModel = workspace:FindFirstChild("laserBeam")
        if laserModel and laserModel:IsA("Model") then
            local hitBox = laserModel:FindFirstChild("hitBox",true)
            if hitBox and hitBox:IsA("BasePart") and hitBox.Transparency < 0.92 then
                local size = hitBox.Size
                local length = math.max(size.X,size.Y,size.Z)
                local direction
                if size.X >= size.Y and size.X >= size.Z then
                    direction = hitBox.CFrame.RightVector
                elseif size.Y >= size.Z then
                    direction = hitBox.CFrame.UpVector
                else
                    direction = hitBox.CFrame.LookVector
                end
                local origin = hitBox.Position-direction*(length*0.5)
                local offset = root.Position-origin
                local along = offset:Dot(direction)
                local closest = origin+direction*math.clamp(along,0,length)
                local width = math.max(1.3,math.min(size.X,size.Y,size.Z))
                if along >= -8 and along <= length+8
                    and (root.Position-closest).Magnitude <= width*0.5+12 then
                    result = {
                        origin=origin,
                        direction=direction,
                        length=length,
                        width=width,
                        instance=laserModel,
                    }
                    return
                end
            end
        end

        for _,object in ipairs(workspace:GetDescendants()) do
            local active = false
            if string.lower(object.Name or "") == "laserbeam" then
                active = (not object:IsA("Beam") or object.Enabled)
                    and (not object:IsA("ParticleEmitter") or object.Enabled)
                    and (not object:IsA("BasePart") or object.Transparency < 0.92)
            elseif object:IsA("Beam") and object.Enabled then
                local keypoints = object.Color.Keypoints
                local color = keypoints[1] and keypoints[1].Value
                active = color and color.B > 0.42 and color.B > color.R*1.15
                    and color.B > color.G*0.90
            end
            if active then
                local origin,direction,length
                if object:IsA("Beam") then
                    local a0,a1 = object.Attachment0,object.Attachment1
                    if a0 then
                        origin = a0.WorldPosition
                        if a1 then
                            local delta = a1.WorldPosition-origin
                            length = delta.Magnitude
                            if length > 0 then direction = delta.Unit end
                        else
                            direction = a0.WorldCFrame.LookVector
                            length = 100
                        end
                    end
                elseif object:IsA("BasePart") then
                    local size = object.Size
                    length = math.max(size.X,size.Y,size.Z)
                    if size.X >= size.Y and size.X >= size.Z then
                        direction = object.CFrame.RightVector
                    elseif size.Y >= size.Z then
                        direction = object.CFrame.UpVector
                    else
                        direction = object.CFrame.LookVector
                    end
                    origin = object.Position-direction*(length*0.5)
                end
                if origin and direction and length and length >= 5 then
                    local offset = root.Position-origin
                    local along = offset:Dot(direction)
                    local closest = origin+direction*math.clamp(along,0,length)
                    if along >= -16 and along <= length+16
                        and (root.Position-closest).Magnitude <= 20 then
                        result = {origin=origin,direction=direction,length=length,instance=object}
                        break
                    end
                end
            end
        end
    end)
    FARM_CONFIG.LastLaserThreat = result
    return result
end
