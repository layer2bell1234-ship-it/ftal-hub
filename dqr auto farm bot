local function SetLine(line,from,to,color,thickness)
local delta= to-from
if delta.Magnitude < .5 then
line.Visible= false
return
end
line.Position= __FTU2((from.X+to.X)/2,(from.Y+to.Y)/2)
line.Size= __FTU2(delta.Magnitude,thickness or 1)
line.Rotation= math.deg(math.atan2(delta.Y,delta.X))
line.BackgroundColor3= color
line.Visible= true
end
