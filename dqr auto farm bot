local function AddRoutePart(position,size,color)
    local part = Instance.new("Part")
    part.Name = "RouteWaypoint"
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Material = Enum.Material.Neon
    part.Color = color
    part.Transparency = 0.18
    part.Size = size
    part.Position = position
    part.Parent = GetFarmVisualFolder()
    table.insert(FarmRouteParts,part)
    return part
end

local function UpdateFarmVisuals(root,targetRoot,targetModel)
    GetFarmVisualFolder()
    if FarmTargetHighlight and targetModel and targetModel.Parent then
        FarmTargetHighlight.Adornee = targetModel
    end
    local visualRoute = FarmRetreatWaypoints or FarmPath
    local currentWaypoint = FarmRetreatWaypoints and (FarmRetreatWaypointIndex or 0) or (FarmWaypointIndex or 0)
    if FarmVisualPath == visualRoute and FarmVisualTarget == targetModel and FarmVisualWaypoint == currentWaypoint then
        return
    end
    FarmLastVisualAt = os.clock()
    FarmVisualPath = visualRoute
    FarmVisualTarget = targetModel
    FarmVisualWaypoint = currentWaypoint
    for _,part in ipairs(FarmRouteParts) do
        if part and part.Parent then part:Destroy() end
    end
    table.clear(FarmRouteParts)
    if not root or not targetRoot then return end
    local previous = root.Position
    local waypoints = FarmRetreatWaypoints or FarmWaypoints or {}
    local startIndex = FarmRetreatWaypoints and (FarmRetreatWaypointIndex or 1) or (FarmWaypointIndex or 1)
    local activeIndex = FarmRetreatWaypoints and (FarmRetreatWaypointIndex or 1) or (FarmWaypointIndex or 1)
    for index = startIndex,#waypoints do
        local waypoint = waypoints[index]
        if waypoint then
            local point = waypoint.Position+Vector3.new(0,0.35,0)
            AddRoutePart(point,Vector3.new(0.5,0.5,0.5),index == activeIndex and Color3.fromRGB(80,255,120) or Color3.fromRGB(80,190,255))
            local delta = point-previous
            if delta.Magnitude > 0.5 then
                local steps = math.max(1,math.ceil(delta.Magnitude/2.5))
                for step=1,steps do
                    local alpha = step/steps
                    AddRoutePart(previous+delta*alpha,Vector3.new(0.36,0.36,0.36),Color3.fromRGB(80,190,255))
                end
            end
            previous = point
        end
    end
    local targetPoint = targetRoot.Position+Vector3.new(0,0.35,0)
    AddRoutePart(targetPoint,Vector3.new(0.8,0.8,0.8),Color3.fromRGB(255,170,40))
end

