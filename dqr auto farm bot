local function GetWinterLockedCombat(root)
    local live = {}
    local models = {}
    local nearestRoot,nearestModel,nearestDistance
    for _,model in ipairs(WinterRouteState.LockedGroup) do
        local humanoid = model and model.Parent and NPCCandidates[model]
        local enemyRoot = humanoid and humanoid.Health > 0 and GetTaggedRoot(model)
        if enemyRoot and IsFarmEnemy(model) then
            local delta = enemyRoot.Position-root.Position
            local distance = Vector3.new(delta.X,0,delta.Z).Magnitude
            table.insert(models,model)
            table.insert(live,{model=model,humanoid=humanoid,root=enemyRoot,distance=distance})
            if not nearestDistance or distance < nearestDistance then
                nearestRoot,nearestModel,nearestDistance = enemyRoot,model,distance
            end
        end
    end
    WinterRouteState.LockedGroup = models
    table.sort(live,function(a,b) return a.distance < b.distance end)
    return nearestRoot,live,nearestModel,nearestDistance
end

local function SelectWinterRetreatDirection(root,target,group)
    local away = Vector3.new(root.Position.X-target.Position.X,0,root.Position.Z-target.Position.Z)
    if away.Magnitude < 0.05 then
        away = Vector3.new(-root.CFrame.LookVector.X,0,-root.CFrame.LookVector.Z)
    end
    if away.Magnitude < 0.05 then away = Vector3.new(0,0,1) end
    away = away.Unit
    local side = Vector3.new(-away.Z,0,away.X)
    local preferredSide = side*FarmStrafeSign
    local candidates = {
        (away*0.75+preferredSide).Unit,
        (away*0.45+preferredSide).Unit,
        preferredSide,
        (away*0.75-preferredSide).Unit,
        (away*0.45-preferredSide).Unit,
        -preferredSide,
        away,
    }

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
    local bestDirection,bestScore
    for _,direction in ipairs(candidates) do
        local travel = direction*12
        local wallHit = workspace:Raycast(root.Position+Vector3.new(0,1.5,0),travel,rayParams)
        local clearance = wallHit and wallHit.Distance or 12
        local destination = root.Position+direction*math.min(10,math.max(4,clearance-1.5))
        local floorHit = workspace:Raycast(
            destination+Vector3.new(0,5,0),Vector3.new(0,-13,0),rayParams
        )
        if floorHit and clearance >= 4 then
            local nearestEnemy = math.huge
            for _,entry in ipairs(group) do
                nearestEnemy = math.min(nearestEnemy,(destination-entry.root.Position).Magnitude)
            end
            if nearestEnemy == math.huge then nearestEnemy = 20 end
            local stableSide = direction:Dot(preferredSide)
            local score = clearance*2+nearestEnemy+direction:Dot(away)*3+stableSide*2
            if not bestScore or score > bestScore then
                bestDirection,bestScore = direction,score
            end
        end
    end

    if not bestDirection then bestDirection = preferredSide end
    FarmStrafeSign = bestDirection:Dot(side) >= 0 and 1 or -1
    return bestDirection
end

local function FollowWinterFixedRoute(root,humanoid)
    local route = FARM_CONFIG.WinterRoutes[WinterRouteState.Room]
    if not route or #route == 0 then return false,true end

    if WinterRouteState.Character ~= root.Parent then
        WinterRouteState.Character = root.Parent
        WinterRouteState.Index = 1
        WinterRouteState.Recovering = false
        local nearestDistance = math.huge
        for index,point in ipairs(route) do
            local distance = (root.Position-point).Magnitude
            if distance < nearestDistance then
                nearestDistance = distance
                WinterRouteState.Index = index
            end
        end
    end

    local index = math.clamp(WinterRouteState.Index,1,#route)

    -- If combat, a collision, or a dodge pushes the character away from the
    -- expected line, reacquire the closest recorded point in this room.
    if not WinterRouteState.Recovering and (root.Position-route[index]).Magnitude > 14 then
        local closestIndex,closestDistance = index,math.huge
        for candidate,point in ipairs(route) do
            local distance = (root.Position-point).Magnitude
            if distance < closestDistance then
                closestIndex,closestDistance = candidate,distance
            end
        end
        WinterRouteState.Index = closestIndex
        WinterRouteState.Recovering = true
        index = closestIndex
    end

    if WinterRouteState.Recovering then
        local recoveryPoint = route[index]
        if (root.Position-recoveryPoint).Magnitude > 4.5 then
            SetFarmHeldKeys({"w"})
            humanoid.AutoRotate = true
            FarmMoveTo(humanoid,recoveryPoint,true)
            return true,false
        end
        WinterRouteState.Recovering = false
    end

    while index < #route and (root.Position-route[index]).Magnitude <= 5.5 do
        index += 1
    end

    -- Recover only forward after combat. The bot never restarts or chases an
    -- NPC; it rejoins the closest upcoming point in this small route window.
    local bestIndex,bestDistance = index,(root.Position-route[index]).Magnitude
    for candidate = index+1,math.min(#route,index+10) do
        local distance = (root.Position-route[candidate]).Magnitude
        if distance+1 < bestDistance then
            bestIndex,bestDistance = candidate,distance
        end
    end
    index = bestIndex
    WinterRouteState.Index = index

    if index == #route and (root.Position-route[index]).Magnitude <= 5.5 then
        local nextRoute = FARM_CONFIG.WinterRoutes[WinterRouteState.Room+1]
        if nextRoute and #nextRoute > 0 then
            WinterRouteState.Room += 1
            WinterRouteState.Index = 1
            WinterRouteState.Recovering = false
            -- Keep the same W hold across connected room boundaries.
            return FollowWinterFixedRoute(root,humanoid)
        end
        ReleaseFarmKeys()
        humanoid:Move(Vector3.zero,false)
        return false,true
    end

    local aimIndex = index
    for candidate = index+1,math.min(#route,index+6) do
        if (route[candidate]-root.Position).Magnitude <= FARM_CONFIG.WinterRouteLookahead then
            aimIndex = candidate
        else
            break
        end
    end
    local destination = route[aimIndex]
    SetFarmHeldKeys({"w"})
    humanoid.AutoRotate = true
    FarmMoveTo(humanoid,destination)
    return true,false
end

local function StepWinterOutpost()
    SetWinterNoclip(false)
    local root,humanoid = GetFarmRoot()
    if not root or not humanoid or humanoid.Health <= 0 then
        StopFarmPath(humanoid)
        SetFarmStatus("Winter route waiting for your character...")
        return
    end

    -- laserBeam exists for only about 0.21 seconds, so inspect it before NPC
    -- selection, AOI transitions, or fixed-route work can consume this tick.
    if not FarmDodgePosition and HasWinterRangedEnemyInAOI(root) then
        local immediateThreat = GetWinterLaserThreat(root)
        if immediateThreat and BeginWinterTelegraphDodge(
            root,humanoid,FarmCombatGroup or {},immediateThreat
        ) then
            SetFarmAOI(root,"DODGE")
            SetFarmStatus("WINTER: RED • laserBeam.hitBox detected • attacks paused")
            return
        end
    end

    -- A dead locked group immediately cancels red/yellow movement and returns
    -- control to the fixed route on this same AI update.
    if FarmDodgePosition and #WinterRouteState.LockedGroup > 0 then
        local aliveTarget,_,_,aliveDistance = GetWinterLockedCombat(root)
        if not aliveTarget or aliveDistance > (Hub.State.WinterAOIRange or 40) then
            FarmDodgePosition = nil
            FarmDodgeUntil = 0
            FarmContinuousMove = false
            FarmCombatMoveDirection = nil
            FarmDodgeKey = nil
            FarmCombatRangeActive = false
            FarmCombatTarget = nil
            ReleaseFarmKeys()
            humanoid:Move(Vector3.zero,false)
        end
    end

    if UpdateDodge(root,humanoid) then
        SetFarmAOI(root,"DODGE")
        SetFarmStatus("WINTER: dodging laserBeam")
        if Hub.State.AutoPickup then TryAutoPickup(root,os.clock()) end
        return
    end

    local target,group,targetModel,targetDistance
    if #WinterRouteState.LockedGroup > 0 then
        target,group,targetModel,targetDistance = GetWinterLockedCombat(root)
        local runRange = Hub.State.WinterNPCAOIRange or 18
        local attackRange = math.max(runRange+2,Hub.State.WinterAttackAOIRange or 32)
        local yellowReleaseRange = attackRange+6
        FarmCombatRangeActive = target ~= nil
            and targetDistance <= yellowReleaseRange
    else
        target,group,targetModel = SelectCombatGroup(root.Position)
        if target then
            local delta = target.Position-root.Position
            targetDistance = Vector3.new(delta.X,0,delta.Z).Magnitude
        else
            targetDistance = math.huge
        end
        local runRange = Hub.State.WinterNPCAOIRange or 18
        local combatTrigger = math.max(runRange+2,Hub.State.WinterAttackAOIRange or 32)
        if target and targetDistance <= combatTrigger then
            table.clear(WinterRouteState.LockedGroup)
            for _,entry in ipairs(group) do
                table.insert(WinterRouteState.LockedGroup,entry.model)
            end
            FarmCombatRangeActive = true
        else
            FarmCombatRangeActive = false
        end
    end

    -- A confirmed laser intersection outranks the normal yellow AOI. This is
    -- checked before fixed-route movement so the 0.21-second model is not lost.
    if target and targetDistance <= (Hub.State.WinterAOIRange or 40)
        and BeginWinterTelegraphDodge(root,humanoid,group) then
        if #WinterRouteState.LockedGroup == 0 then
            for _,entry in ipairs(group) do
                table.insert(WinterRouteState.LockedGroup,entry.model)
            end
        end
        FarmCombatTarget = targetModel
        FarmCombatRangeActive = true
        SetFarmAOI(root,"DODGE")
        SetFarmStatus(string.format("WINTER: laserBeam hitBox dodge • group=%d • attacks paused",#group))
        return
    end

    if not FarmCombatRangeActive or not target then
        table.clear(WinterRouteState.LockedGroup)
        FarmCombatRangeActive = false
        FarmCombatTarget = nil
        humanoid:Move(Vector3.zero,false)
        SetFarmAOI(root,"PURSUE")
        local moving,complete = FollowWinterFixedRoute(root,humanoid)
        local activeRoute = FARM_CONFIG.WinterRoutes[WinterRouteState.Room] or {}
        FarmState = moving and "WINTER FIXED ROUTE" or "WINTER ROUTE WAITING"
        SetFarmStatus(WinterRouteState.Recovering
            and string.format("WINTER: retracking closest point • Room %d • point %d/%d",WinterRouteState.Room,WinterRouteState.Index,#activeRoute)
            or complete
            and string.format("WINTER: Room %d route complete — waiting for Room %d data",WinterRouteState.Room,WinterRouteState.Room+1)
            or string.format("WINTER: fixed Room %d route • point %d/%d",WinterRouteState.Room,WinterRouteState.Index,#activeRoute))
        if Hub.State.AutoPickup then TryAutoPickup(root,os.clock()) end
        return
    end

    FarmCombatTarget = targetModel
    FarmCombatGroup = group
    UpdateFarmVisuals(root,target,targetModel)

    SetFarmAOI(root,"HOLD")
    if FarmPath or FarmHeldKeys.w then
        StopFarmPath(humanoid)
        FarmCombatTarget = targetModel
        FarmCombatGroup = group
        FarmCombatRangeActive = true
    end
    humanoid.AutoRotate = false
    FaceCombatTarget(root,humanoid,target)
    UseCombatAbilities(true)
    local runRange = Hub.State.WinterNPCAOIRange or 18
    if targetDistance <= runRange then
        local retreatDirection = SelectWinterRetreatDirection(root,target,group)
        -- Inner orange AOI: S remains held and A/D steers around walls.
        SetFarmHeldKeys({"s",FarmStrafeSign > 0 and "d" or "a"})
        FARM_CONFIG.WinterYellowMoveDirection = retreatDirection
        humanoid:Move(retreatDirection,false)
        SetFarmStatus(string.format("WINTER: NPC too close • S + %s • Q/E",FarmStrafeSign > 0 and "D" or "A"))
    else
        -- Between the yellow attack AOI and orange run AOI, hold position,
        -- face the group, and attack while allowing it to approach.
        ReleaseFarmKeys()
        FARM_CONFIG.WinterYellowMoveDirection = nil
        humanoid:Move(Vector3.zero,false)
        SetFarmStatus(string.format("WINTER: attack AOI • letting group approach • Q/E • %.1f studs",targetDistance))
    end
    if Hub.State.AutoPickup then TryAutoPickup(root,os.clock()) end
end

local function StepAutoFarm()
    if Hub.State.FarmDungeon == "Winter Outpost (Legacy)" then
        return StepWinterOutpost()
    end
    SetWinterNoclip(false)
    local root,humanoid = GetFarmRoot()
    if not root or not humanoid or humanoid.Health <= 0 then
        StopFarmPath(humanoid)
        SetFarmStatus("Waiting for your character...")
        return
    end
    if UpdateDodge(root,humanoid) then
        SetFarmStatus("DODGING incoming group attack")
        local dodgeTarget = FarmCombatTarget and GetTaggedRoot(FarmCombatTarget)
        if Hub.State.FarmDungeon == "Winter Outpost (Legacy)" and dodgeTarget
            and (dodgeTarget.Position-root.Position).Magnitude <= Hub.State.FarmStopDistance+2 then
            UseCombatAbilities(true)
        end
        if Hub.State.AutoPickup then TryAutoPickup(root,os.clock()) end
        return
    end

    local target,group,targetModel = SelectCombatGroup(root.Position)
    if target then
        ReplayRequested = false
        local winterMode = Hub.State.FarmDungeon == "Winter Outpost (Legacy)"
        local targetDistance = (target.Position-root.Position).Magnitude
        UpdateFarmVisuals(root,target,targetModel)
        if winterMode and targetDistance <= Hub.State.FarmStopDistance+2 and HasWinterRangedAttack(root,group) then
            FaceCombatTarget(root,humanoid,target)
            if BeginWinterRangedDodge(root,humanoid,group) then
                UseCombatAbilities(true)
                SetFarmStatus(string.format("WINTER DODGE S+A/D • %d-enemy group • Q/E",#group))
                return
            end
        elseif HasIncomingAttack(root,group) then
            FaceCombatTarget(root,humanoid,target)
            if BeginDodge(root,humanoid,group) then
                SetFarmStatus(string.format("DODGING %d-enemy group",#group))
                return
            end
        end
        local aggro = IsGroupAggro(root,group)
        if aggro or targetDistance <= Hub.State.FarmStopDistance+1 then
            FaceCombatTarget(root,humanoid,target)
        else
            humanoid.AutoRotate = true
        end
        local retreatTrigger = math.max(Hub.State.FarmStopDistance+6,12)
        UseCombatAbilities(winterMode
            and targetDistance <= Hub.State.FarmStopDistance+1
            or (not winterMode and (aggro or targetDistance <= retreatTrigger)))
        if (aggro or targetDistance <= retreatTrigger) and targetDistance <= retreatTrigger then
            ReleaseFarmKeys()
            if BeginRetreat(root,humanoid,group) then
                SetFarmStatus(string.format("RETREATING from %d-enemy group • Q/E",#group))
                return
            end
            local away = Vector3.new(root.Position.X-target.Position.X,0,root.Position.Z-target.Position.Z)
            if away.Magnitude < 0.05 then away = Vector3.new(0,0,1) end
            FarmContinuousMove = false
            FarmCombatMoveDirection = nil
            FarmDodgePosition = root.Position+away.Unit*4
            FarmDodgeUntil = os.clock()+FARM_CONFIG.DodgeDuration
            ReleaseFarmKeys()
            FarmMoveTo(humanoid,FarmDodgePosition,true)
            SetFarmStatus(string.format("RETREATING emergency from %d-enemy group",#group))
            return
        end
        if FarmCombatRangeActive and targetDistance <= FARM_CONFIG.CombatHoldDistance then
            ReleaseFarmKeys()
            UseCombatAbilities(true)
            humanoid:MoveTo(root.Position)
            FaceCombatTarget(root,humanoid,target)
            SetFarmStatus(string.format("COMBAT RANGE • %d-enemy group • Q/E",#group))
            if Hub.State.AutoPickup then TryAutoPickup(root,os.clock()) end
            return
        elseif FarmCombatRangeActive and targetDistance > FARM_CONFIG.CombatHoldDistance+3 then
            FarmCombatRangeActive = false
        end
        UpdateStuck(root)
        local following = targetModel and FollowFarmPath(root,humanoid,target,targetModel)
        FarmState = following and (targetDistance <= Hub.State.FarmStopDistance+1 and "IN_RANGE" or "MOVING") or "REPATHING"
        SetFarmStatus(string.format("%s: %s group=%d  •  %.1f studs",FarmState,targetModel and targetModel.Name or "NPC",#group,targetDistance))
        if Hub.State.AutoPickup then TryAutoPickup(root,os.clock()) end
        return
    end
    StopFarmPath(humanoid)
    ClearFarmVisuals()
    SetFarmStatus("No living NPC enemies found.")
    if Hub.State.AutoReplay and not ReplayRequested then
        local remote = GetRemote(FARM_CONFIG.ReplayRemote)
        if remote then
            ReplayRequested = true
            remote:FireServer()
            SetFarmStatus("Dungeon clear — replay requested.")
        end
    end
end

local function RunFarmWorker()
    if FarmWorkerRunning then return end
    FarmWorkerRunning = true
    task.spawn(function()
        while Hub.State.AutoFarm and not Hub.Destroyed do
            local ok,err = pcall(StepAutoFarm)
            if not ok then
                local _,humanoid = GetFarmRoot()
                StopFarmPath(humanoid)
                SetFarmStatus("Farm paused after an error: "..tostring(err))
            end
            task.wait(FARM_CONFIG.UpdateInterval)
        end
        local _,humanoid = GetFarmRoot()
        StopFarmPath(humanoid)
        ClearFarmVisuals()
        FarmWorkerRunning = false
    end)
end

