local function SetFarmStatus(message)
    if FarmStatusLabel and FarmStatusLabel.Parent then FarmStatusLabel.Text = message end
end

local function GetDungeonGuiRoots()
    local roots = {LocalPlayer:FindFirstChildOfClass("PlayerGui")}
    pcall(function() table.insert(roots,game:GetService("CoreGui")) end)
    return roots
end

local function DungeonButtonVisible(button)
    if not button or not button:IsA("GuiObject") or not button.Visible then return false end
    local parent = button.Parent
    while parent do
        if parent:IsA("GuiObject") and not parent.Visible then return false end
        parent = parent.Parent
    end
    return button.AbsoluteSize.X >= 80 and button.AbsoluteSize.Y >= 20
end

local function DungeonClickTarget(object)
    -- Click the exact rendered object that matched.  Walking upward can
    -- accidentally resolve a nested label to a large HUD button such as
    -- Inventory.
    return object
end

local function DungeonButtonText(button)
    local text = (button:IsA("TextButton") or button:IsA("TextLabel")) and button.Text or ""
    if text == "" then
        for _,child in ipairs(button:GetDescendants()) do
            if (child:IsA("TextLabel") or child:IsA("TextButton")) and child.Text ~= "" then
                text = child.Text
                break
            end
        end
    end
    if text == "" then return "" end
    return string.lower((text:gsub("%s+"," "):gsub("^%s+"," "):gsub("%s+$"," ")))
end

local function DungeonButtonColor(button)
    if button:IsA("GuiObject") and button.BackgroundTransparency < 1 then
        return button.BackgroundColor3
    end
    if button:IsA("ImageButton") then
        return button.ImageColor3
    end
    for _,child in ipairs(button:GetChildren()) do
        if child:IsA("GuiObject") and child.BackgroundTransparency < 1 then
            return child.BackgroundColor3
        end
    end
    return Color3.new()
end

local function GetDungeonPlayerLevel()
    local roots = GetDungeonGuiRoots()
    -- Prefer the player's top-left level display.  This prevents dungeon
    -- labels such as "Required Lvl: 12" from being mistaken for the player.
    for _,root in ipairs(roots) do
        if root then
            for _,object in ipairs(root:GetDescendants()) do
                if (object:IsA("TextLabel") or object:IsA("TextButton")) and object.AbsolutePosition.X <= 450 and object.AbsolutePosition.Y <= 300 then
                    local objectName = string.lower(object.Name or "")
                    local text = string.lower(object.Text or "")
                    local number = tonumber((object.Text or ""):match("^%s*(%d+)%s*$"))
                    if number and number <= 200 and (objectName:find("level",1,true) or (object.AbsolutePosition.X <= 170 and object.AbsolutePosition.Y >= 120)) then
                        return math.floor(number)
                    end
                end
            end
        end
    end
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local levelValue = leaderstats:FindFirstChild("Level",true)
        if levelValue and (levelValue:IsA("IntValue") or levelValue:IsA("NumberValue")) then
            return math.floor(levelValue.Value)
        end
    end
    for _,name in ipairs({"Level","level","PlayerLevel","playerLevel"}) do
        local ok,value = pcall(function() return LocalPlayer:GetAttribute(name) end)
        if ok and type(value) == "number" then return math.floor(value) end
    end
    for _,root in ipairs(roots) do
        if root then
            for _,object in ipairs(root:GetDescendants()) do
                if object:IsA("TextLabel") or object:IsA("TextButton") then
                    local objectName = string.lower(object.Name or "")
                    local text = string.lower(object.Text or "")
                    local requirementText = text:find("required",1,true) or text:find("minimum",1,true) or objectName:find("required",1,true)
                    if not requirementText and (objectName:find("level",1,true) or text:find("level",1,true)) then
                        local number = tonumber((object.Text or ""):match("%d+"))
                        if number then return math.floor(number) end
                    end
                end
            end
        end
    end
    return 1
end

local function GetHighestDungeonDifficulty(level)
    if level >= 27 then return "nightmare" end
    if level >= 20 then return "insane" end
    if level >= 12 then return "hard" end
    if level >= 6 then return "medium" end
    return "easy"
end

local function FindDungeonButton(kind)
    for _,root in ipairs(GetDungeonGuiRoots()) do
        if root then
            for _,object in ipairs(root:GetDescendants()) do
                -- Only inspect actual clickable Roblox buttons.  Scanning every
                -- colored Frame is what allowed the Inventory panel to win.
                local difficultyPanel = kind == "easy" or kind == "medium" or kind == "hard" or kind == "insane" or kind == "nightmare"
                local textPanel = difficultyPanel or kind == "lobby" or kind == "start"
                if (object:IsA("GuiButton") or (textPanel and object:IsA("GuiObject"))) and DungeonButtonVisible(object) then
                    local text = DungeonButtonText(object)
                    local color = DungeonButtonColor(object)
                    local green = color.G > 0.30 and color.G > color.R*1.35 and color.G > color.B*1.20
                    local orange = color.R > 0.30 and color.R > color.B*1.40 and color.G > color.B*1.20
                    local red = color.R > 0.30 and color.R > color.G*1.20 and color.R > color.B*1.20
                    local yellow = color.R > 0.35 and color.G > 0.30 and color.B < 0.45 and math.abs(color.R-color.G) < 0.30
                    if kind == "play" and text == "play" and green then return object end
                    if kind == "create" and text == "create dungeon" and orange then return object end
                    if kind == "easy" and text == "easy" then return object end
                    if kind == "medium" and text == "medium" then return object end
                    if kind == "hard" and text == "hard" then return object end
                    if kind == "insane" and text == "insane" then return object end
                    if kind == "nightmare" and text == "nightmare" then return object end
                    -- These labels are unique and their parent color can be
                    -- gray depending on the current menu layer, so text is
                    -- authoritative for the final two clicks.
                    if kind == "lobby" and text == "create lobby" then return object end
                    if kind == "start" and text == "start" then return object end
                end
            end
        end
    end
end

local function ActivateDungeonButton(button)
    if not button then return false end
    local clicked = false
    local ok,virtualInput = pcall(function() return game:GetService("VirtualInputManager") end)
    if ok and virtualInput then
        local center = button.AbsolutePosition + button.AbsoluteSize/2
        clicked = pcall(function()
            virtualInput:SendMouseMoveEvent(center.X,center.Y,game)
            virtualInput:SendMouseButtonEvent(center.X,center.Y,0,true,game,1)
            virtualInput:SendMouseButtonEvent(center.X,center.Y,0,false,game,1)
        end)
    end
    if not clicked then
        if button:IsA("GuiButton") and type(firesignal) == "function" then
            clicked = pcall(function() firesignal(button.MouseButton1Click) end)
        end
    end
    if not clicked then
        clicked = pcall(function() button:Activate() end)
    end
    return clicked
end

local function DungeonFallbackPoint(kind)
    local camera = workspace.CurrentCamera
    if not camera then return end
    local size = camera.ViewportSize
    local points = {
        play = Vector2.new(size.X*0.925, size.Y*0.938),
        create = Vector2.new(size.X*0.500, size.Y*0.555),
        easy = Vector2.new(size.X*0.673, size.Y*0.452),
        medium = Vector2.new(size.X*0.673, size.Y*0.512),
        hard = Vector2.new(size.X*0.673, size.Y*0.572),
        insane = Vector2.new(size.X*0.673, size.Y*0.633),
        nightmare = Vector2.new(size.X*0.673, size.Y*0.690),
        lobby = Vector2.new(size.X*0.500, size.Y*0.680),
        start = Vector2.new(size.X*0.610, size.Y*0.235),
    }
    return points[kind]
end

local function ActivateDungeonPoint(point)
    if not point then return false end
    local ok,virtualInput = pcall(function() return game:GetService("VirtualInputManager") end)
    if not ok or not virtualInput then return false end
    return pcall(function()
        virtualInput:SendMouseMoveEvent(point.X,point.Y,game)
        virtualInput:SendMouseButtonEvent(point.X,point.Y,0,true,game,1)
        virtualInput:SendMouseButtonEvent(point.X,point.Y,0,false,game,1)
    end)
end

local function AutoDungeonClickDelay(kind)
    if kind == "create" then return 2.0 end
    if kind == "easy" or kind == "medium" or kind == "hard" or kind == "insane" or kind == "nightmare" then return 1.6 end
    if kind == "lobby" then return 1.8 end
    if kind == "start" then return 3.0 end
    return 1.0
end

local function ClickUniversalStart()
    local camera = workspace.CurrentCamera
    if not camera then return false end
    local size = camera.ViewportSize
    local point = Vector2.new(size.X*0.748,size.Y*0.910)
    local clicked = ActivateDungeonPoint(point)
    -- Roblox can report GUI coordinates with a top inset; the second click
    -- remains inside the large green Start button from the supplied screen.
    local ok,inset = pcall(function()
        return game:GetService("GuiService"):GetGuiInset()
    end)
    if ok and inset.Y > 0 then
        clicked = ActivateDungeonPoint(point + Vector2.new(0,inset.Y)) or clicked
    end
    return clicked
end

local function RunUniversalStartWorker()
    if AutoStartDungeonWorkerRunning then return end
    if not IsAutoStartPlace() then
        SetFarmStatus("Auto Start: unavailable in this place.")
        return
    end
    if Hub.State.AutoDungeon then
        SetFarmStatus("Auto Start: Auto Dungeon already controls Start.")
        return
    end
    AutoStartDungeonWorkerRunning = true
    task.spawn(function()
        SetFarmStatus("Auto Start: starting in 5 seconds...")
        for _ = 1,50 do
            if not Hub.State.AutoStartDungeon or Hub.Destroyed then
                AutoStartDungeonWorkerRunning = false
                return
            end
            task.wait(0.1)
        end

        local armed = true
        while Hub.State.AutoStartDungeon and not Hub.Destroyed do
            if armed then
                local clicked = ClickUniversalStart()
                if clicked then
                    SetFarmStatus("Auto Start: clicked Start")
                    armed = false
                    task.wait(2.0)
                else
                    SetFarmStatus("Auto Start: click failed")
                    task.wait(0.5)
                end
            else
                task.wait(0.25)
            end
        end
        AutoStartDungeonWorkerRunning = false
    end)
end

local function RunAutoDungeonWorker()
    if AutoDungeonWorkerRunning then return end
    if not IsAutoDungeonPlace() then
        SetFarmStatus("Auto Dungeon: unavailable in this place.")
        return
    end
    AutoDungeonWorkerRunning = true
    task.spawn(function()
        local step = 1
        local level = 1
        local difficulty = "easy"
        local steps = {"play","create",difficulty,"lobby","start"}
        local lastButton
        local waitingSince = os.clock()
        SetFarmStatus("Auto Dungeon: starting in 7 seconds...")
        for _ = 1,70 do
            if not Hub.State.AutoDungeon or Hub.Destroyed then
                AutoDungeonWorkerRunning = false
                return
            end
            task.wait(0.1)
        end
        level = GetDungeonPlayerLevel()
        difficulty = GetHighestDungeonDifficulty(level)
        steps[3] = difficulty
        while Hub.State.AutoDungeon and not Hub.Destroyed do
            local kind = steps[step]
            -- Re-read the level immediately before the difficulty click.
            if step == 3 then
                local currentLevel = GetDungeonPlayerLevel()
                local currentDifficulty = GetHighestDungeonDifficulty(currentLevel)
                if currentDifficulty ~= difficulty then
                    level = currentLevel
                    difficulty = currentDifficulty
                    steps[3] = difficulty
                    kind = difficulty
                end
            end
            local button = FindDungeonButton(kind)
            -- Create Lobby is a custom panel in this UI; use its known
            -- screen-relative left-click target rather than a nested GUI
            -- object that may report the wrong bounds.
            if kind == "lobby" or kind == "start" then button = nil end
            if button and button ~= lastButton then
                lastButton = button
                waitingSince = os.clock()
                if ActivateDungeonButton(button) then
                    if kind == "lobby" and button:IsA("GuiButton") then
                        pcall(function() button:Activate() end)
                    end
                    if kind == difficulty then
                        SetFarmStatus("Auto Dungeon: level "..level.." -> "..difficulty)
                    else
                        SetFarmStatus("Auto Dungeon: clicked "..kind)
                    end
                    step = step + 1
                    if step > #steps then
                        step = 1
                        lastButton = nil
                        task.wait(3.0)
                    else
                        task.wait(AutoDungeonClickDelay(kind))
                    end
                else
                    SetFarmStatus("Auto Dungeon: click failed")
                    task.wait(0.75)
                end
            else
                if not button then
                    lastButton = nil
                    if os.clock()-waitingSince >= 1.5 then
                        if ActivateDungeonPoint(DungeonFallbackPoint(kind)) then
                            SetFarmStatus("Auto Dungeon: left-clicked "..kind)
                            step = step + 1
                            waitingSince = os.clock()
                            if step > #steps then
                                step = 1
                                task.wait(3.0)
                            else
                                task.wait(AutoDungeonClickDelay(kind))
                            end
                        else
                            SetFarmStatus("Auto Dungeon: waiting for "..kind.."...")
                            task.wait(0.25)
                        end
                    else
                        SetFarmStatus("Auto Dungeon: waiting for "..kind.."...")
                        task.wait(0.25)
                    end
                else
                    task.wait(0.25)
                end
            end
        end
        AutoDungeonWorkerRunning = false
    end)
end

local function FarmMoveTo(humanoid,position,force)
    if not humanoid or not humanoid.Parent or not position then return end
    local now = os.clock()
    if not force and FarmLastMovePosition
        and (FarmLastMovePosition-position).Magnitude < 0.8
        and now-FarmLastMoveAt < 0.8 then
        return
    end
    FarmLastMovePosition = position
    FarmLastMoveAt = now
    humanoid:MoveTo(position)
end

local function SendFarmKey(key,down)
    if type(keypress) == "function" and type(keyrelease) == "function" then
        pcall(function()
            if down then keypress(key) else keyrelease(key) end
        end)
        return
    end
    local ok,virtualInput = pcall(function() return game:GetService("VirtualInputManager") end)
    if ok and virtualInput and Enum.KeyCode[key:upper()] then
        pcall(function() virtualInput:SendKeyEvent(down,Enum.KeyCode[key:upper()],false,game) end)
    end
end

local function SetFarmHeldKeys(keys)
    local wanted = {}
    for _,key in ipairs(keys or {}) do wanted[key] = true end
    for key in pairs(FarmHeldKeys) do
        if not wanted[key] then
            SendFarmKey(key,false)
            FarmHeldKeys[key] = nil
        end
    end
    for key in pairs(wanted) do
        if not FarmHeldKeys[key] then
            SendFarmKey(key,true)
            FarmHeldKeys[key] = true
        end
    end
end

local function ReleaseFarmKeys()
    SetFarmHeldKeys({})
end

local function ClearFarmVisuals()
    if FarmTargetHighlight then
        FarmTargetHighlight.Adornee = nil
    end
    for _,part in ipairs(FarmRouteParts) do
        if part and part.Parent then part:Destroy() end
    end
    table.clear(FarmRouteParts)
    FarmVisualPath = nil
    FarmVisualTarget = nil
    FarmVisualWaypoint = 0
end

local function GetFarmVisualFolder()
    if FarmVisualFolder and FarmVisualFolder.Parent then return FarmVisualFolder end
    FarmVisualFolder = Instance.new("Folder")
    FarmVisualFolder.Name = "SmartFarmRouteVisuals"
    FarmVisualFolder.Parent = workspace
    FarmTargetHighlight = Instance.new("Highlight")
    FarmTargetHighlight.Name = "CurrentTarget"
    FarmTargetHighlight.FillColor = Color3.fromRGB(255,170,40)
    FarmTargetHighlight.OutlineColor = Color3.fromRGB(255,245,180)
    FarmTargetHighlight.FillTransparency = 0.55
    FarmTargetHighlight.OutlineTransparency = 0
    FarmTargetHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    FarmTargetHighlight.Parent = FarmVisualFolder
    return FarmVisualFolder
end

local function AddRoutePart(position,size,color)
    local part = Instance.new("Part")
    part.Name = "RouteWaypoint"
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Material = Enum.Material.Neon
    part.Color = color
    part.Transparency = 0.18
    part.Size = size
    part.Position = position
    part.Parent = GetFarmVisualFolder()
    table.insert(FarmRouteParts,part)
    return part
end

local function UpdateFarmVisuals(root,targetRoot,targetModel)
    GetFarmVisualFolder()
    if FarmTargetHighlight and targetModel and targetModel.Parent then
        FarmTargetHighlight.Adornee = targetModel
    end
    local visualRoute = FarmRetreatWaypoints or FarmPath
    local currentWaypoint = FarmRetreatWaypoints and (FarmRetreatWaypointIndex or 0) or (FarmWaypointIndex or 0)
    if FarmVisualPath == visualRoute and FarmVisualTarget == targetModel and FarmVisualWaypoint == currentWaypoint then
        return
    end
    FarmLastVisualAt = os.clock()
    FarmVisualPath = visualRoute
    FarmVisualTarget = targetModel
    FarmVisualWaypoint = currentWaypoint
    for _,part in ipairs(FarmRouteParts) do
        if part and part.Parent then part:Destroy() end
    end
    table.clear(FarmRouteParts)
    if not root or not targetRoot then return end
    local previous = root.Position
    local waypoints = FarmRetreatWaypoints or FarmWaypoints or {}
    local startIndex = FarmRetreatWaypoints and (FarmRetreatWaypointIndex or 1) or (FarmWaypointIndex or 1)
    local activeIndex = FarmRetreatWaypoints and (FarmRetreatWaypointIndex or 1) or (FarmWaypointIndex or 1)
    for index = startIndex,#waypoints do
        local waypoint = waypoints[index]
        if waypoint then
            local point = waypoint.Position+Vector3.new(0,0.35,0)
            AddRoutePart(point,Vector3.new(0.5,0.5,0.5),index == activeIndex and Color3.fromRGB(80,255,120) or Color3.fromRGB(80,190,255))
            local delta = point-previous
            if delta.Magnitude > 0.5 then
                local steps = math.max(1,math.ceil(delta.Magnitude/2.5))
                for step=1,steps do
                    local alpha = step/steps
                    AddRoutePart(previous+delta*alpha,Vector3.new(0.36,0.36,0.36),Color3.fromRGB(80,190,255))
                end
            end
            previous = point
        end
    end
    local targetPoint = targetRoot.Position+Vector3.new(0,0.35,0)
    AddRoutePart(targetPoint,Vector3.new(0.8,0.8,0.8),Color3.fromRGB(255,170,40))
end

local function GetFarmRoot()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart"), character and character:FindFirstChildOfClass("Humanoid")
end

local function GetTaggedRoot(instance)
    if not instance or not instance.Parent then return nil end
    if instance:IsA("BasePart") then return instance end
    local model = instance:IsA("Model") and instance or instance:FindFirstAncestorOfClass("Model")
    if not model then return nil end
    return model.PrimaryPart or model:FindFirstChild("HumanoidRootPart",true) or model:FindFirstChildWhichIsA("BasePart",true)
end

-- Cache humanoid models as they enter/leave Workspace; player characters are excluded.
local NPCCandidates = {}
local function RegisterNPC(model)
    if model and not model:IsA("Model") then
        model = model:FindFirstAncestorOfClass("Model")
    end
    if not model or not model:IsA("Model") or not model:IsDescendantOf(workspace) then return end
    local humanoid = model:FindFirstChildWhichIsA("Humanoid",true)
    if humanoid then NPCCandidates[model] = humanoid end
end

for _,instance in ipairs(workspace:GetDescendants()) do
    if instance:IsA("Humanoid") then RegisterNPC(instance.Parent) end
end

Connect(workspace.DescendantAdded,function(instance)
    if instance:IsA("Humanoid") then
        RegisterNPC(instance.Parent)
    elseif instance:IsA("Model") then
        RegisterNPC(instance)
    end
end)

Connect(workspace.DescendantRemoving,function(instance)
    if instance:IsA("Model") then NPCCandidates[instance] = nil end
    if instance:IsA("Humanoid") and instance.Parent then NPCCandidates[instance.Parent] = nil end
end)

local function IsFarmEnemy(model)
    if model:GetAttribute("Friendly") == true or model:GetAttribute("IsFriendly") == true then
        return false
    end
    for _,attributeName in ipairs({"IsEnemy","Enemy","Hostile"}) do
        local value = model:GetAttribute(attributeName)
        if value ~= nil then
            if value == true or value == 1 or value == "true" or value == "True" or value == "TRUE" then
                return true
            end
            if value == false or value == 0 or value == "false" or value == "False" or value == "FALSE" then
                return false
            end
        end
    end
    return true
end

local function FindNearestEnemy(position)
    local bestRoot, bestDistance
    for model,humanoid in pairs(NPCCandidates) do
        if not model.Parent or not humanoid:IsDescendantOf(model) then
            NPCCandidates[model] = nil
        elseif humanoid.Health > 0 and Players:GetPlayerFromCharacter(model) == nil
            and model ~= LocalPlayer.Character and IsFarmEnemy(model) then
            local root = GetTaggedRoot(model)
            if root then
                local distance = (root.Position-position).Magnitude
                if not bestDistance or distance < bestDistance then bestRoot, bestDistance = root, distance end
            end
        end
    end
    return bestRoot, bestDistance
end

local function GetRemote(name)
    local folder = ReplicatedStorage:FindFirstChild(FARM_CONFIG.RemoteFolder)
    local remote = folder and folder:FindFirstChild(name)
    return remote and remote:IsA("RemoteEvent") and remote or nil
end

local function StopFarmPath(humanoid)
    if FarmPathBlockedConnection then
        FarmPathBlockedConnection:Disconnect()
        FarmPathBlockedConnection = nil
    end
    FarmPath = nil
    FarmWaypoints = nil
    FarmWaypointIndex = nil
    FarmPathTarget = nil
    FarmPathRoot = nil
    FarmPathGoal = nil
    FarmNextRepathAt = 0
    FarmDodgePosition = nil
    FarmDodgeUntil = 0
    FarmCombatTarget = nil
    FarmCombatRangeActive = false
    table.clear(FarmCombatGroup)
    FarmState = "IDLE"
    FarmLastRootPosition = nil
    FarmStuckSince = 0
    FarmLastMovePosition = nil
    FarmLastMoveAt = 0
    FarmCommandedWaypoint = nil
    FarmContinuousMove = false
    FarmCombatMoveDirection = nil
    FarmDodgeKey = nil
    FarmRetreatWaypoints = nil
    FarmRetreatWaypointIndex = nil
    ReleaseFarmKeys()
    if humanoid and humanoid.Parent then
        humanoid.AutoRotate = true
        local root = humanoid.Parent:FindFirstChild("HumanoidRootPart")
        if root then humanoid:MoveTo(root.Position) end
    end
end

local function IsTrueAttribute(model, names)
    for _,name in ipairs(names) do
        if model:GetAttribute(name) == true then return true end
    end
    return false
end

local function IsAttackAnimationPlaying(humanoid)
    local ok,tracks = pcall(function() return humanoid:GetPlayingAnimationTracks() end)
    if not ok then return false end
    for _,track in ipairs(tracks) do
        local name = string.lower(track.Name or "")
        if track.IsPlaying and (name:find("attack") or name:find("charge") or name:find("slam") or name:find("lunge")) then
            return true
        end
    end
    return false
end

local function GetLiveEnemies(position)
    local result = {}
    for model,humanoid in pairs(NPCCandidates) do
        if not model.Parent or not humanoid:IsDescendantOf(model) then
            NPCCandidates[model] = nil
        elseif humanoid.Health > 0 and Players:GetPlayerFromCharacter(model) == nil
            and model ~= LocalPlayer.Character and IsFarmEnemy(model) then
            local root = GetTaggedRoot(model)
            if root and (root.Position-position).Magnitude <= (Hub.State.FarmScanRadius or FARM_CONFIG.ScanRadius) then
                table.insert(result,{model=model,humanoid=humanoid,root=root,distance=(root.Position-position).Magnitude})
            end
        end
    end
    table.sort(result,function(a,b) return a.distance < b.distance end)
    return result
end

local function SelectCombatGroup(position)
    local enemies = GetLiveEnemies(position)
    if #enemies == 0 then return nil,{},nil end

    local previousTarget = FarmCombatTarget
    local anchor = FarmCombatTarget
    local anchorHumanoid = anchor and NPCCandidates[anchor]
    if not anchor or not anchor.Parent or not anchorHumanoid or anchorHumanoid.Health <= 0
        or not IsFarmEnemy(anchor) or (GetTaggedRoot(anchor) and (GetTaggedRoot(anchor).Position-position).Magnitude > 90) then
        FarmCombatTarget = nil
        anchor = enemies[1].model
    end
    local anchorRoot = GetTaggedRoot(anchor) or enemies[1].root
    local group = {}
    for _,entry in ipairs(enemies) do
        if (entry.root.Position-anchorRoot.Position).Magnitude <= FARM_CONFIG.GroupRadius then
            table.insert(group,entry)
        end
    end
    if #group == 0 then group = {enemies[1]} end
    FarmCombatTarget = group[1].model
    if previousTarget ~= FarmCombatTarget then
        FarmCombatRangeActive = false
    end
    FarmCombatGroup = group
    return group[1].root,group,FarmCombatTarget
end

local function IsDesertBossAttack(model,humanoid)
    local modelName = string.lower(model.Name or "")
    if not (modelName:find("sand") and modelName:find("giant")) then return false end
    if IsTrueAttribute(model,{"Attacking","IsAttacking","Attack","Charging","Smash","FireLines","Telegraph","Warning"}) then
        return true
    end
    for _,descendant in ipairs(model:GetDescendants()) do
        local name = string.lower(descendant.Name or "")
        if name:find("fireline") or name:find("fire_line") or name:find("smash")
            or name:find("telegraph") or name:find("warning") or name:find("aoe") then
            if (descendant:IsA("BasePart") and descendant.Transparency < 0.95)
                or ((descendant:IsA("ParticleEmitter") or descendant:IsA("Beam")) and descendant.Enabled) then
                return true
            end
        end
    end
    return IsAttackAnimationPlaying(humanoid)
end

local function HasIncomingAttack(root,group)
    for _,entry in ipairs(group) do
        local enemyRoot,humanoid = entry.root,entry.humanoid
        local offset = root.Position-enemyRoot.Position
        local distance = offset.Magnitude
        if distance <= FARM_CONFIG.ThreatRadius then
            if IsTrueAttribute(entry.model,{"Attacking","IsAttacking","Attack","Charging","IsCharging","PreparingAttack"})
                or IsAttackAnimationPlaying(humanoid) or IsDesertBossAttack(entry.model,humanoid) then
                return true
            end
            local velocity = enemyRoot.AssemblyLinearVelocity
            local speed = velocity.Magnitude
            if speed >= 18 and speed > 0 and offset.Unit:Dot(velocity.Unit) > 0.62 then
                return true
            end
        end
    end
    return false
end

local function IsGroupAggro(root,group)
    for _,entry in ipairs(group) do
        local offset = root.Position-entry.root.Position
        local distance = offset.Magnitude
        if distance <= 55 then
            if IsTrueAttribute(entry.model,{"Chasing","Aggro","Aggroed","TargetingPlayer","HasTarget","InCombat"}) then
                return true
            end
            local velocity = entry.root.AssemblyLinearVelocity
            if velocity.Magnitude >= 6 and distance > 0 and offset.Unit:Dot(velocity.Unit) > 0.45 then
                return true
            end
            local moveDirection = entry.humanoid.MoveDirection
            if moveDirection.Magnitude > 0.1 and distance > 0
                and offset.Unit:Dot(moveDirection.Unit) > 0.5
                and distance <= math.max(Hub.State.FarmStopDistance+12,18) then
                return true
            end
        end
    end
    return false
end

local function TapAbilityKey(key)
    local keyCode = Enum.KeyCode[key]
    if not keyCode then return false end
    local pressed = false
    if type(keypress) == "function" and type(keyrelease) == "function" then
        pressed = pcall(function()
            keypress(string.lower(key))
            task.wait(0.04)
            keyrelease(string.lower(key))
        end)
    end
    if not pressed then
        local ok,virtualInput = pcall(function() return game:GetService("VirtualInputManager") end)
        if ok and virtualInput then
            pressed = pcall(function()
                virtualInput:SendKeyEvent(true,keyCode,false,game)
                virtualInput:SendKeyEvent(false,keyCode,false,game)
            end)
        end
    end
    return pressed
end

local function UseCombatAbilities(aggro)
    if not aggro then return end
    local now = os.clock()
    if now-FarmLastAbilityAt < FARM_CONFIG.AbilityCooldown then return end
    FarmLastAbilityAt = now
    TapAbilityKey(FarmNextAbility)
    FarmNextAbility = FarmNextAbility == "Q" and "E" or "Q"
end

local function BeginRetreat(root,humanoid,group)
    local center = Vector3.zero
    for _,entry in ipairs(group) do center += entry.root.Position end
    if #group > 0 then center /= #group end
    local away = Vector3.new(root.Position.X-center.X,0,root.Position.Z-center.Z)
    if away.Magnitude < 0.05 then away = Vector3.new(0,0,1) end
    away = away.Unit
    local side = Vector3.new(-away.Z,0,away.X)
    FarmStrafeSign = -FarmStrafeSign
    local preferredSide = side*FarmStrafeSign
    local candidates = {
        (away*0.35+preferredSide).Unit,
        (away*0.2+preferredSide).Unit,
        preferredSide,
        away,
        (away-preferredSide*0.5).Unit,
    }
    local bestPosition,bestScore
    for _,direction in ipairs(candidates) do
        local position = root.Position+direction*FARM_CONFIG.RetreatDistance
        if IsDodgePointOpen(root,position,group) then
            local nearest = math.huge
            for _,entry in ipairs(group) do nearest = math.min(nearest,(position-entry.root.Position).Magnitude) end
            if not bestScore or nearest > bestScore then bestPosition,bestScore = position,nearest end
        end
    end
    if not bestPosition then return false end
    FarmRetreatWaypoints = nil
    FarmRetreatWaypointIndex = nil
    if FarmPathBlockedConnection then
        FarmPathBlockedConnection:Disconnect()
        FarmPathBlockedConnection = nil
    end
    FarmPath = nil
    FarmWaypoints = nil
    FarmWaypointIndex = nil
    FarmPathTarget = nil
    FarmPathRoot = nil
    FarmPathGoal = nil
    FarmNextRepathAt = 0
    FarmDodgePosition = bestPosition
    FarmDodgeUntil = os.clock()+FARM_CONFIG.DodgeDuration
    FarmState = "REPOSITIONING"
    FarmCombatRangeActive = true
    FarmContinuousMove = false
    FarmCombatMoveDirection = nil
    ReleaseFarmKeys()
    FarmMoveTo(humanoid,bestPosition,true)
    return true
end

local function FaceCombatTarget(root,humanoid,targetRoot)
    if not root or not humanoid or not targetRoot or not targetRoot.Parent then return end
    local lookPosition = Vector3.new(targetRoot.Position.X,root.Position.Y,targetRoot.Position.Z)
    if (lookPosition-root.Position).Magnitude < 0.05 then return end
    humanoid.AutoRotate = false
    root.CFrame = CFrame.lookAt(root.Position,lookPosition)
end

IsDodgePointOpen = function(root,position,group)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
    local direction = position-root.Position
    if workspace:Raycast(root.Position+Vector3.new(0,2,0),direction,rayParams) then return false end
    local floorHit = workspace:Raycast(position+Vector3.new(0,5,0),Vector3.new(0,-12,0),rayParams)
    if not floorHit then return false end
    for _,entry in ipairs(group) do
        if (position-entry.root.Position).Magnitude < 7 then return false end
    end
    return true
end

local function BeginDodge(root,humanoid,group)
    local now = os.clock()
    if now-FarmLastDodgeAt < FARM_CONFIG.DodgeCooldown then return false end
    local threat = Vector3.zero
    for _,entry in ipairs(group) do
        local delta = root.Position-entry.root.Position
        if delta.Magnitude > 0 then
            local velocity = entry.root.AssemblyLinearVelocity
            if velocity.Magnitude >= 8 and delta.Unit:Dot(velocity.Unit) > 0.35 then
                threat += velocity.Unit * math.clamp(velocity.Magnitude/20,0.5,2)
            else
                threat += delta.Unit * math.clamp(1/delta.Magnitude*12,0.2,1)
            end
        end
    end
    threat = Vector3.new(threat.X,0,threat.Z)
    if threat.Magnitude < 0.05 then threat = Vector3.new(0,0,-1) end
    threat = threat.Unit
    local side = Vector3.new(-threat.Z,0,threat.X)
    local candidates = {side,-side,-threat,(side-threat).Unit,(-side-threat).Unit}
    local bestPosition,bestScore
    for _,direction in ipairs(candidates) do
        local position = root.Position+direction*FARM_CONFIG.DodgeDistance
        if IsDodgePointOpen(root,position,group) then
            local nearest = math.huge
            for _,entry in ipairs(group) do nearest = math.min(nearest,(position-entry.root.Position).Magnitude) end
            local score = nearest + (direction:Dot(side) * 2)
            if not bestScore or score > bestScore then bestPosition,bestScore = position,score end
        end
    end
    if not bestPosition then return false end
    local lateral = root.CFrame:VectorToObjectSpace(bestPosition-root.Position)
    FarmDodgeKey = lateral.X >= 0 and "d" or "a"
    SetFarmHeldKeys({FarmDodgeKey})
    FarmDodgePosition = bestPosition
    FarmDodgeUntil = now+FARM_CONFIG.DodgeDuration
    FarmLastDodgeAt = now
    FarmState = "DODGING"
    FarmContinuousMove = false
    FarmCombatMoveDirection = nil
    FarmRetreatWaypoints = nil
    FarmRetreatWaypointIndex = nil
    if FarmPathBlockedConnection then
        FarmPathBlockedConnection:Disconnect()
        FarmPathBlockedConnection = nil
    end
    FarmPath = nil
    FarmWaypoints = nil
    FarmWaypointIndex = nil
    FarmPathTarget = nil
    FarmPathRoot = nil
    FarmPathGoal = nil
    FarmNextRepathAt = 0
    FarmMoveTo(humanoid,bestPosition,true)
    return true
end

local function UpdateDodge(root,humanoid)
    if not FarmDodgePosition then return false end
    local currentTargetRoot = FarmCombatTarget and GetTaggedRoot(FarmCombatTarget)
    FaceCombatTarget(root,humanoid,currentTargetRoot)
    if os.clock() >= FarmDodgeUntil or (root.Position-FarmDodgePosition).Magnitude <= 2.5 then
        if FarmContinuousMove then humanoid:Move(Vector3.zero,false) end
        ReleaseFarmKeys()
        ReleaseFarmKeys()
        FarmDodgePosition = nil
        FarmDodgeUntil = 0
        FarmState = "REPOSITIONING"
        FarmContinuousMove = false
        FarmCombatMoveDirection = nil
        FarmDodgeKey = nil
        FarmRetreatWaypoints = nil
        FarmRetreatWaypointIndex = nil
        return false
    end
    if FarmContinuousMove and FarmCombatMoveDirection then
        SetFarmHeldKeys({"s",FarmStrafeSign > 0 and "d" or "a"})
        local retreatWaypoint = FarmRetreatWaypoints and FarmRetreatWaypoints[FarmRetreatWaypointIndex]
        while retreatWaypoint and (root.Position-retreatWaypoint.Position).Magnitude <= FARM_CONFIG.WaypointReachDistance do
            FarmRetreatWaypointIndex += 1
            retreatWaypoint = FarmRetreatWaypoints[FarmRetreatWaypointIndex]
        end
        if retreatWaypoint then
            local routeDirection = Vector3.new(
                retreatWaypoint.Position.X-root.Position.X,
                0,
                retreatWaypoint.Position.Z-root.Position.Z
            )
            if routeDirection.Magnitude > 0.1 then
                FarmCombatMoveDirection = routeDirection.Unit
            end
            FarmMoveTo(humanoid,retreatWaypoint.Position)
        else
            if not (type(keypress) == "function" and type(keyrelease) == "function") then
                FarmMoveTo(humanoid,FarmDodgePosition)
            end
        end
        if currentTargetRoot and currentTargetRoot.Parent then
            local away = Vector3.new(root.Position.X-currentTargetRoot.Position.X,0,root.Position.Z-currentTargetRoot.Position.Z)
            if away.Magnitude > 0.05 then
                away = away.Unit
                local side = Vector3.new(-away.Z,0,away.X)*FarmStrafeSign
                if not retreatWaypoint then
                    FarmCombatMoveDirection = (away*0.3+side).Unit
                end
            end
        end
        -- Never synthesize W/A/S/D here. Keyboard injection can toggle the menu
        -- if its rebind is W; Humanoid:Move is the smooth equivalent and does
        -- not generate keyboard input events.
        -- FarmMoveTo above owns the retreat command. Keeping one movement
        -- controller active prevents MoveTo and Humanoid:Move fighting each other.
    else
        if FarmDodgeKey then SetFarmHeldKeys({FarmDodgeKey}) end
        humanoid:MoveTo(FarmDodgePosition)
    end
    return true
end

local function UpdateStuck(root)
    local now = os.clock()
    if not FarmLastRootPosition then FarmLastRootPosition = root.Position return false end
    if (root.Position-FarmLastRootPosition).Magnitude < 0.35 then
        if FarmStuckSince == 0 then FarmStuckSince = now end
    else
        FarmStuckSince = 0
    end
    FarmLastRootPosition = root.Position
    if FarmStuckSince > 0 and now-FarmStuckSince >= FARM_CONFIG.StuckTime then
        FarmStuckSince = 0
        FarmNextRepathAt = 0
        FarmState = "REPATHING"
        return true
    end
    return false
end

local function GetGroundApproachPoint(characterRoot, targetRoot)
    local away = Vector3.new(
        characterRoot.Position.X-targetRoot.Position.X,
        0,
        characterRoot.Position.Z-targetRoot.Position.Z
    )
    if away.Magnitude < 0.05 then
        away = Vector3.new(-targetRoot.CFrame.LookVector.X,0,-targetRoot.CFrame.LookVector.Z)
    end
    if away.Magnitude < 0.05 then away = Vector3.new(0,0,1) end
    return targetRoot.Position + away.Unit * Hub.State.FarmStopDistance
end

local function ComputeFarmPath(characterRoot, targetRoot, targetModel)
    local away = Vector3.new(characterRoot.Position.X-targetRoot.Position.X,0,characterRoot.Position.Z-targetRoot.Position.Z)
    if away.Magnitude < 0.05 then away = Vector3.new(-targetRoot.CFrame.LookVector.X,0,-targetRoot.CFrame.LookVector.Z) end
    if away.Magnitude < 0.05 then away = Vector3.new(0,0,1) end
    away = away.Unit
    local side = Vector3.new(-away.Z,0,away.X)
    local approachPoints = {
        targetRoot.Position + away * Hub.State.FarmStopDistance,
        targetRoot.Position - away * Hub.State.FarmStopDistance,
        targetRoot.Position + side * Hub.State.FarmStopDistance,
        targetRoot.Position - side * Hub.State.FarmStopDistance,
    }
    local path,destination
    for _,candidate in ipairs(approachPoints) do
        local attempt = PathfindingService:CreatePath({
            AgentRadius = FARM_CONFIG.AgentRadius,
            AgentHeight = FARM_CONFIG.AgentHeight,
            AgentCanJump = true,
            AgentCanClimb = true,
            WaypointSpacing = 2.5,
        })
        local ok = pcall(function()
            attempt:ComputeAsync(characterRoot.Position,candidate)
        end)
        if ok and attempt.Status == Enum.PathStatus.Success and #attempt:GetWaypoints() > 0 then
            path,destination = attempt,candidate
            break
        end
    end
    if not path then
        local fallback = approachPoints[1]
        StopFarmPath(nil)
        FarmPathTarget = targetModel
        FarmPathRoot = characterRoot
        FarmPathGoal = fallback
        FarmNextRepathAt = os.clock()+0.35
        return false
    end

    if FarmPathBlockedConnection then
        FarmPathBlockedConnection:Disconnect()
        FarmPathBlockedConnection = nil
    end
    FarmPath = path
    FarmWaypoints = path:GetWaypoints()
    FarmWaypointIndex = #FarmWaypoints > 1 and 2 or 1
    FarmPathTarget = targetModel
    FarmPathRoot = characterRoot
    FarmPathGoal = destination
    FarmNextRepathAt = os.clock()+Hub.State.FarmRepathInterval
    FarmPathBlockedConnection = path.Blocked:Connect(function(blockedIndex)
        if FarmWaypointIndex and blockedIndex >= FarmWaypointIndex then
            FarmNextRepathAt = 0
        end
    end)
    return #FarmWaypoints > 0
end

local function FollowFarmPath(characterRoot, humanoid, targetRoot, targetModel)
    -- One persistent W hold for the entire normal route. Retreat calls
    -- ReleaseFarmKeys before taking control.
    SetFarmHeldKeys({"w"})
    local destination = GetGroundApproachPoint(characterRoot,targetRoot)
    local now = os.clock()
    if not FarmPath and FarmPathGoal and FarmPathTarget == targetModel
        and FarmPathRoot == characterRoot and now < FarmNextRepathAt then
        return false
    end
    local targetChanged = FarmPathTarget ~= targetModel
    local rootChanged = FarmPathRoot ~= characterRoot
    local targetMoved = not FarmPathGoal or (FarmPathGoal-destination).Magnitude > 6
    local shouldRepath = not FarmPath or not FarmWaypoints or targetChanged or rootChanged
        or targetMoved or now >= FarmNextRepathAt

    if shouldRepath and not ComputeFarmPath(characterRoot,targetRoot,targetModel) then
        ReleaseFarmKeys()
        FarmMoveTo(humanoid,destination)
        return true
    end

    local waypoint = FarmWaypoints and FarmWaypoints[FarmWaypointIndex]
    if not waypoint then
        if (characterRoot.Position-destination).Magnitude <= Hub.State.FarmStopDistance+1 then
            ReleaseFarmKeys()
            FarmMoveTo(humanoid,characterRoot.Position)
            return true
        end
        FarmNextRepathAt = 0
        FarmMoveTo(humanoid,destination)
        return true
    end

    while waypoint and (characterRoot.Position-waypoint.Position).Magnitude <= FARM_CONFIG.WaypointReachDistance do
        FarmWaypointIndex += 1
        waypoint = FarmWaypoints[FarmWaypointIndex]
    end
    -- Skip short intermediate blocks when the next route segment is already
    -- close enough; this keeps movement continuous through generated rooms.
    if waypoint and waypoint.Action ~= Enum.PathWaypointAction.Jump and FarmWaypoints[FarmWaypointIndex+1]
        and FarmWaypoints[FarmWaypointIndex+1].Action ~= Enum.PathWaypointAction.Jump
        and (waypoint.Position-characterRoot.Position).Magnitude <= 9 then
        FarmWaypointIndex += 1
        waypoint = FarmWaypoints[FarmWaypointIndex]
    end
    if waypoint then
        if waypoint.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
        FarmMoveTo(humanoid,waypoint.Position)
        return true
    end
    return false
end

local function TryAutoPickup(root, now)
    local remote = GetRemote(FARM_CONFIG.PickupRemote)
    if not remote then return end
    for _,pickup in ipairs(CollectionService:GetTagged(FARM_CONFIG.PickupTag)) do
        local pickupRoot = GetTaggedRoot(pickup)
        if pickupRoot and (pickupRoot.Position-root.Position).Magnitude <= FARM_CONFIG.PickupRange then
            local last = LastPickupAt[pickup] or 0
            if now-last >= 1 then
                LastPickupAt[pickup] = now
                remote:FireServer(pickup)
            end
        else
            LastPickupAt[pickup] = nil
        end
    end
end

local function StepAutoFarm()
    local root,humanoid = GetFarmRoot()
    if not root or not humanoid or humanoid.Health <= 0 then
        StopFarmPath(humanoid)
        SetFarmStatus("Waiting for your character...")
        return
    end
    if UpdateDodge(root,humanoid) then
        SetFarmStatus("DODGING incoming group attack")
        if Hub.State.AutoPickup then TryAutoPickup(root,os.clock()) end
        return
    end

    local target,group,targetModel = SelectCombatGroup(root.Position)
    if target then
        ReplayRequested = false
        local targetDistance = (target.Position-root.Position).Magnitude
        UpdateFarmVisuals(root,target,targetModel)
        if HasIncomingAttack(root,group) then
            FaceCombatTarget(root,humanoid,target)
            if BeginDodge(root,humanoid,group) then
                SetFarmStatus(string.format("DODGING %d-enemy group",#group))
                return
            end
        end
        local aggro = IsGroupAggro(root,group)
        if aggro or targetDistance <= Hub.State.FarmStopDistance+1 then
            FaceCombatTarget(root,humanoid,target)
        else
            humanoid.AutoRotate = true
        end
        local retreatTrigger = math.max(Hub.State.FarmStopDistance+6,12)
        UseCombatAbilities(aggro or targetDistance <= retreatTrigger)
        if (aggro or targetDistance <= retreatTrigger) and targetDistance <= retreatTrigger then
            ReleaseFarmKeys()
            if BeginRetreat(root,humanoid,group) then
                SetFarmStatus(string.format("RETREATING from %d-enemy group • Q/E",#group))
                return
            end
            local away = Vector3.new(root.Position.X-target.Position.X,0,root.Position.Z-target.Position.Z)
            if away.Magnitude < 0.05 then away = Vector3.new(0,0,1) end
            FarmContinuousMove = false
            FarmCombatMoveDirection = nil
            FarmDodgePosition = root.Position+away.Unit*4
            FarmDodgeUntil = os.clock()+FARM_CONFIG.DodgeDuration
            ReleaseFarmKeys()
            FarmMoveTo(humanoid,FarmDodgePosition,true)
            SetFarmStatus(string.format("RETREATING emergency from %d-enemy group",#group))
            return
        end
        if FarmCombatRangeActive and targetDistance <= FARM_CONFIG.CombatHoldDistance then
            ReleaseFarmKeys()
            UseCombatAbilities(true)
            humanoid:MoveTo(root.Position)
            FaceCombatTarget(root,humanoid,target)
            SetFarmStatus(string.format("COMBAT RANGE • %d-enemy group • Q/E",#group))
            if Hub.State.AutoPickup then TryAutoPickup(root,os.clock()) end
            return
        elseif FarmCombatRangeActive and targetDistance > FARM_CONFIG.CombatHoldDistance+3 then
            FarmCombatRangeActive = false
        end
        UpdateStuck(root)
        local following = targetModel and FollowFarmPath(root,humanoid,target,targetModel)
        FarmState = following and (targetDistance <= Hub.State.FarmStopDistance+1 and "IN_RANGE" or "MOVING") or "REPATHING"
        SetFarmStatus(string.format("%s: %s group=%d  •  %.1f studs",FarmState,targetModel and targetModel.Name or "NPC",#group,targetDistance))
        if Hub.State.AutoPickup then TryAutoPickup(root,os.clock()) end
        return
    end
    StopFarmPath(humanoid)
    ClearFarmVisuals()
    SetFarmStatus("No living NPC enemies found.")
    if Hub.State.AutoReplay and not ReplayRequested then
        local remote = GetRemote(FARM_CONFIG.ReplayRemote)
        if remote then
            ReplayRequested = true
            remote:FireServer()
            SetFarmStatus("Dungeon clear — replay requested.")
        end
    end
end

local function RunFarmWorker()
    if FarmWorkerRunning then return end
    FarmWorkerRunning = true
    task.spawn(function()
        while Hub.State.AutoFarm and not Hub.Destroyed do
            local ok,err = pcall(StepAutoFarm)
            if not ok then
                local _,humanoid = GetFarmRoot()
                StopFarmPath(humanoid)
                SetFarmStatus("Farm paused after an error: "..tostring(err))
            end
            task.wait(FARM_CONFIG.UpdateInterval)
        end
        local _,humanoid = GetFarmRoot()
        StopFarmPath(humanoid)
        ClearFarmVisuals()
        FarmWorkerRunning = false
    end)
end

Hub.AutoFarmCleanup = function()
    Hub.State.AutoFarm = false
    FarmWorkerRunning = false
    local _,humanoid = GetFarmRoot()
    StopFarmPath(humanoid)
    ClearFarmVisuals()
end

