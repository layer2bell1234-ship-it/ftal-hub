local function SetLine(line,from,to,color,thickness)
    local delta = to-from
    if delta.Magnitude < .5 then
        line.Visible = false
        return
    end

    line.Position = UDim2.fromOffset((from.X+to.X)/2,(from.Y+to.Y)/2)
    line.Size = UDim2.fromOffset(delta.Magnitude,thickness or 1)
    line.Rotation = math.deg(math.atan2(delta.Y,delta.X))
    line.BackgroundColor3 = color
    line.Visible = true
end

local function HideESP(data)
    data.Highlight.Enabled = false
    data.Billboard.Enabled = false
    data.Tracer.Visible = false
    data.HeadDot.Visible = false

    for _,line in ipairs(data.Box) do line.Visible = false end
    for _,line in ipairs(data.Skeleton) do line.Visible = false end
end

local function WallVisible(char,root)
    if not Hub.State.ESPWallCheck then return true end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character,char}

    local result = workspace:Raycast(
        Camera.CFrame.Position,
        root.Position-Camera.CFrame.Position,
        params
    )

    return result == nil
end

-- WorldToViewportPoint returns viewport coordinates. Gui.IgnoreGuiInset=true
-- above makes these coordinates line up with the drawing layer.
local function Project(part)
    if not part then return nil end

    local pos,onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen or pos.Z <= 0 then return nil end

    return Vector2.new(pos.X,pos.Y)
end

-- More stable than the old head/root-only box: project the character's
-- actual bounding box so boxes stay centered and sized correctly at angles.
local function DrawBox(data,char,color)
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local cf,size = char:GetBoundingBox()
    local half = size/2

    local corners = {
        cf * Vector3.new(-half.X,-half.Y,-half.Z),
        cf * Vector3.new(-half.X,-half.Y, half.Z),
        cf * Vector3.new(-half.X, half.Y,-half.Z),
        cf * Vector3.new(-half.X, half.Y, half.Z),
        cf * Vector3.new( half.X,-half.Y,-half.Z),
        cf * Vector3.new( half.X,-half.Y, half.Z),
        cf * Vector3.new( half.X, half.Y,-half.Z),
        cf * Vector3.new( half.X, half.Y, half.Z),
    }

    local minX,minY = math.huge,math.huge
    local maxX,maxY = -math.huge,-math.huge
    local visible = false

    for _,point in ipairs(corners) do
        local p,onScreen = Camera:WorldToViewportPoint(point)
        if onScreen and p.Z > 0 then
            visible = true
            minX = math.min(minX,p.X)
            minY = math.min(minY,p.Y)
            maxX = math.max(maxX,p.X)
            maxY = math.max(maxY,p.Y)
        end
    end

    if not visible then
        for _,line in ipairs(data.Box) do line.Visible = false end
        return
    end

    local tl = Vector2.new(minX,minY)
    local tr = Vector2.new(maxX,minY)
    local br = Vector2.new(maxX,maxY)
    local bl = Vector2.new(minX,maxY)

    SetLine(data.Box[1],tl,tr,color,1)
    SetLine(data.Box[2],tr,br,color,1)
    SetLine(data.Box[3],br,bl,color,1)
    SetLine(data.Box[4],bl,tl,color,1)
end

local R15SkeletonPairs = {
    {"Head","UpperTorso"},
    {"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},
    {"LeftUpperArm","LeftLowerArm"},
    {"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},
    {"RightUpperArm","RightLowerArm"},
    {"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},
    {"LeftUpperLeg","LeftLowerLeg"},
    {"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},
    {"RightUpperLeg","RightLowerLeg"},
    {"RightLowerLeg","RightFoot"},
}

local R6SkeletonPairs = {
    {"Head","Torso"},
    {"Torso","Left Arm"},
    {"Torso","Right Arm"},
    {"Torso","Left Leg"},
    {"Torso","Right Leg"},
}

local function DrawSkeleton(data,char,color)
    local pairsToUse = char:FindFirstChild("UpperTorso") and char:FindFirstChild("LowerTorso") and R15SkeletonPairs or R6SkeletonPairs
    local lineIndex = 1

    for _,pair in ipairs(pairsToUse) do
        local a = char:FindFirstChild(pair[1])
        local b = char:FindFirstChild(pair[2])

        if a and b and lineIndex <= #data.Skeleton then
            local ap = Project(a)
            local bp = Project(b)
            if ap and bp then
                SetLine(data.Skeleton[lineIndex],ap,bp,color,1)
            else
                data.Skeleton[lineIndex].Visible = false
            end
            lineIndex += 1
        end
    end

    for i=lineIndex,#data.Skeleton do
        data.Skeleton[i].Visible = false
    end
end

Connect(RunService.RenderStepped,function()
    if Hub.Destroyed then return end

    for player,data in pairs(Hub.ESP) do
        if not Hub.State.ESPEnabled then
            HideESP(data)
            continue
        end

        if Hub.State.ESPTeamCheck and LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
            HideESP(data)
            continue
        end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if not char or not root or not hum or hum.Health <= 0 then
            HideESP(data)
            continue
        end

        local localChar = LocalPlayer.Character
        local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
        if not localRoot then
            HideESP(data)
            continue
        end

        local distance = (localRoot.Position-root.Position).Magnitude
        if distance > Hub.State.ESPMaxDistance then
            HideESP(data)
            continue
        end

        if not WallVisible(char,root) then
            HideESP(data)
            continue
        end

        local color = Hub.State.ESPColor

        data.Highlight.Adornee = char
        data.Highlight.FillColor = color
        data.Highlight.OutlineColor = color
        data.Highlight.Enabled = Hub.State.ESPChams

        local info = {}
        if Hub.State.ESPNames then table.insert(info,player.DisplayName) end
        if Hub.State.ESPDistance then table.insert(info,math.floor(distance).."m") end
        if Hub.State.ESPHealth then table.insert(info,"HP "..math.floor(hum.Health)) end

        data.Billboard.Adornee = root
        data.Label.Text = table.concat(info,"  •  ")
        data.Label.TextColor3 = color
        data.Billboard.Enabled = #info > 0

        if Hub.State.ESPBoxes then
            DrawBox(data,char,color)
        else
            for _,line in ipairs(data.Box) do line.Visible = false end
        end

        if Hub.State.ESPSkeleton then
            DrawSkeleton(data,char,color)
        else
            for _,line in ipairs(data.Skeleton) do line.Visible = false end
        end

        if Hub.State.ESPHeadDot then
            local head = char:FindFirstChild("Head")
            local pos = Project(head)
            if pos then
                data.HeadDot.Position = UDim2.fromOffset(pos.X,pos.Y)
                data.HeadDot.BackgroundColor3 = color
                data.HeadDot.Visible = true
            else
                data.HeadDot.Visible = false
            end
        else
            data.HeadDot.Visible = false
        end

        if Hub.State.ESPTracers then
            local pos = Project(root)
            if pos then
                local from = Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
                SetLine(data.Tracer,from,pos,color,1)
            else
                data.Tracer.Visible = false
            end
        else
            data.Tracer.Visible = false
        end
    end
end)

