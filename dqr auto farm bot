local function GetTaggedRoot(instance)
    if not instance or not instance.Parent then return nil end
    if instance:IsA("BasePart") then return instance end
    local model = instance:IsA("Model") and instance or instance:FindFirstAncestorOfClass("Model")
    if not model then return nil end
    return model.PrimaryPart or model:FindFirstChild("HumanoidRootPart",true) or model:FindFirstChildWhichIsA("BasePart",true)
end

-- Cache humanoid models as they enter/leave Workspace; player characters are excluded.
local NPCCandidates = {}
local function RegisterNPC(model)
    if model and not model:IsA("Model") then
        model = model:FindFirstAncestorOfClass("Model")
    end
    if not model or not model:IsA("Model") or not model:IsDescendantOf(workspace) then return end
    local humanoid = model:FindFirstChildWhichIsA("Humanoid",true)
    if humanoid then NPCCandidates[model] = humanoid end
end

for _,instance in ipairs(workspace:GetDescendants()) do
    if instance:IsA("Humanoid") then RegisterNPC(instance.Parent) end
end

Connect(workspace.DescendantAdded,function(instance)
    if instance:IsA("Humanoid") then
        RegisterNPC(instance.Parent)
    elseif instance:IsA("Model") then
        RegisterNPC(instance)
    end
end)

Connect(workspace.DescendantRemoving,function(instance)
    if instance:IsA("Model") then NPCCandidates[instance] = nil end
    if instance:IsA("Humanoid") and instance.Parent then NPCCandidates[instance.Parent] = nil end
end)

local function IsFarmEnemy(model)
    if model:GetAttribute("Friendly") == true or model:GetAttribute("IsFriendly") == true then
        return false
    end
    for _,attributeName in ipairs({"IsEnemy","Enemy","Hostile"}) do
        local value = model:GetAttribute(attributeName)
        if value ~= nil then
            if value == true or value == 1 or value == "true" or value == "True" or value == "TRUE" then
                return true
            end
            if value == false or value == 0 or value == "false" or value == "False" or value == "FALSE" then
                return false
            end
        end
    end
    return true
end

local function FindNearestEnemy(position)
    local bestRoot, bestDistance
    for model,humanoid in pairs(NPCCandidates) do
        if not model.Parent or not humanoid:IsDescendantOf(model) then
            NPCCandidates[model] = nil
        elseif humanoid.Health > 0 and Players:GetPlayerFromCharacter(model) == nil
            and model ~= LocalPlayer.Character and IsFarmEnemy(model) then
            local root = GetTaggedRoot(model)
            if root then
                local distance = (root.Position-position).Magnitude
                if not bestDistance or distance < bestDistance then bestRoot, bestDistance = root, distance end
            end
        end
    end
    return bestRoot, bestDistance
end

