    Line.Text = Text
    Line.TextColor3 = Color or Color3.fromRGB(205, 205, 205)
    Line.TextSize = 13
    Line.TextXAlignment = Enum.TextXAlignment.Left
    Line.TextWrapped = true
    Line.Parent = Output

    scrollToBottom()

    return Line
end

local function log(Message, Color)
    return createLine(
        "PS C:\\Terminal> " .. tostring(Message),
        Color
    )
end

local function typeLog(Message, Color, Speed)
    Speed = Speed or 0.018

    local Line = createLine(
        "PS C:\\Terminal> ",
        Color or Color3.fromRGB(205, 205, 205)
    )

    for Index = 1, #Message do
        Line.Text = "PS C:\\Terminal> " .. string.sub(Message, 1, Index) .. "█"
        scrollToBottom()
        task.wait(Speed)
    end

    Line.Text = "PS C:\\Terminal> " .. Message
    scrollToBottom()

    return Line
end

local function animatedLog(Message, Duration)
    local Line = createLine(
        "PS C:\\Terminal> " .. Message .. " ",
        Color3.fromRGB(205, 205, 205)
    )

    local Frames = {"", ".", "..", "..."}
    local StartTime = os.clock()
    local FrameIndex = 1

    while os.clock() - StartTime < Duration do
        Line.Text = "PS C:\\Terminal> " .. Message .. Frames[FrameIndex]
        FrameIndex = FrameIndex % #Frames + 1
        scrollToBottom()
        task.wait(0.16)
    end

    Line.Text = "PS C:\\Terminal> " .. Message .. " DONE"
    Line.TextColor3 = Color3.fromRGB(110, 220, 140)
    scrollToBottom()
end

