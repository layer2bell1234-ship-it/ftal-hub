--============================================================--
-- SAVED ACCESS
--============================================================--

local Authenticated = false
local Loading = false
local Verifying = false

local function canUseFileStorage()
    return type(isfile) == "function"
        and type(readfile) == "function"
        and type(writefile) == "function"
end

local function trim(Text)
    return (tostring(Text):gsub("^%s+", ""):gsub("%s+$", ""))
end

-- Returns the locally saved customer key, or nil if there isn't one.
local function readSavedKey()
    if not CONFIG.REMEMBER_ACCESS or not canUseFileStorage() then
        return nil
    end

    local Success, SavedKey = pcall(function()
        if not isfile(CONFIG.AUTH_FILE) then
            return nil
        end

        return readfile(CONFIG.AUTH_FILE)
    end)

    if Success and type(SavedKey) == "string" then
        SavedKey = trim(SavedKey)

        if SavedKey ~= "" then
            return SavedKey
        end
    end

    return nil
end

local function saveKey(Key)
    if not CONFIG.REMEMBER_ACCESS or not canUseFileStorage() then
        return
    end

    pcall(function()
        writefile(CONFIG.AUTH_FILE, Key)
    end)
end

-- Removes a saved key that the server rejected.
local function clearSavedKey()
    if not canUseFileStorage() then
        return
    end

    pcall(function()
        if type(delfile) == "function" and isfile(CONFIG.AUTH_FILE) then
            delfile(CONFIG.AUTH_FILE)
        else
            writefile(CONFIG.AUTH_FILE, "")
        end
    end)
end

--============================================================--
-- SERVER VALIDATION
--============================================================--

local function getRequestFunction()
    if type(request) == "function" then
        return request
    end

    if type(http_request) == "function" then
        return http_request
    end

    if type(syn) == "table" and type(syn.request) == "function" then
        return syn.request
    end

    if type(http) == "table" and type(http.request) == "function" then
        return http.request
    end

    if type(fluxus) == "table" and type(fluxus.request) == "function" then
        return fluxus.request
    end

    return nil
end

-- Returns one of:
--   "valid",    message   -> server authorized this key for this PlaceId
--   "rejected", reason    -> server said no (bad / revoked / expired / wrong place)
--   "error",    message   -> could not get a real answer (network, bad response, rate limit)
-- Anything other than an explicit  valid == true  is treated as NOT authorized.
local function validateKey(Key)
    local RequestFunction = getRequestFunction()

    if not RequestFunction then
        return "error", "This executor does not support HTTP requests."
    end

    local RequestOK, Response = pcall(function()
        return RequestFunction({
            Url = CONFIG.AUTH_URL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                -- Lets requests through ngrok's free-plan warning page.
                -- Harmless on any other host.
                ["ngrok-skip-browser-warning"] = "true",
            },
            Body = HttpService:JSONEncode({
                key = Key,
                place_id = tostring(game.PlaceId),
            }),
        })
    end)

    if not RequestOK or type(Response) ~= "table" then
        return "error", "Could not reach authentication server."
    end

    local DecodeOK, Result = pcall(function()
        return HttpService:JSONDecode(Response.Body)
    end)

    if not DecodeOK or type(Result) ~= "table" then
        return "error", "Invalid response from authentication server."
    end

    if Result.valid == true then
        return "valid", tostring(Result.message or "authorized")
    end

    local Reason = tostring(Result.error or "rejected")

    if Response.StatusCode == 429 then
        return "error", Reason
    end

    if Result.valid == false then
        return "rejected", Reason
    end

    return "error", "Unexpected response from authentication server."
end

--============================================================--
-- SCRIPT LOADING
--============================================================--

local function runLoadingSequence(SelectedScript, ScriptType, PlaceId)
    Loading = true
    Connect.Active = false
    PasswordBox.Active = false
    Status.Text = "STATUS: LOADING"

    typeLog("Starting terminal session.", Color3.fromRGB(190, 220, 255))
    animatedLog("Reading client environment", CONFIG.LOADING_STEP_DELAY)
    animatedLog("Detecting current PlaceId", CONFIG.LOADING_STEP_DELAY)

    log("PlaceId: " .. tostring(PlaceId), Color3.fromRGB(130, 190, 255))
    task.wait(CONFIG.LOADING_STEP_DELAY)

    if ScriptType == "GAME" then
        typeLog("Game-specific module located.", Color3.fromRGB(110, 220, 140))
    else
        typeLog("No matching module found.", Color3.fromRGB(230, 190, 100))
        typeLog("Universal fallback module selected.", Color3.fromRGB(110, 220, 140))
    end

    animatedLog("Preparing execution environment", CONFIG.LOADING_STEP_DELAY)
    animatedLog("Verifying module integrity", CONFIG.LOADING_STEP_DELAY)
    animatedLog("Allocating runtime resources", CONFIG.LOADING_STEP_DELAY)
    animatedLog("Starting selected module", CONFIG.LOADING_STEP_DELAY)

    Status.Text = "STATUS: EXECUTING"
    typeLog("Executing script...", Color3.fromRGB(220, 220, 220))

    local Success, ErrorMessage = pcall(function()
        SelectedScript()
    end)

    if Success then
        typeLog("Script loaded successfully.", Color3.fromRGB(110, 220, 140))
        Status.Text = "STATUS: ONLINE"

        task.wait(1)

        if Gui and Gui.Parent then
            Gui:Destroy()
        end
    else
        typeLog("Script error: " .. tostring(ErrorMessage), Color3.fromRGB(240, 100, 100))
        Status.Text = "STATUS: ERROR"
        Loading = false
    end
end

local function detectPlace()
    local PlaceId = game.PlaceId
    local SelectedScript = CONFIG.SCRIPTS[PlaceId]
    local ScriptType = "GAME"

    if not SelectedScript then
        SelectedScript = CONFIG.UNIVERSAL
        ScriptType = "UNIVERSAL"
    end

    if not SelectedScript then
        typeLog("No script configured for this PlaceId.", Color3.fromRGB(240, 100, 100))
        Status.Text = "STATUS: NO SCRIPT"
        Loading = false
        return
    end

    task.spawn(function()
        runLoadingSequence(SelectedScript, ScriptType, PlaceId)
    end)
end

--============================================================--
-- AUTHENTICATION
--============================================================--

local function authenticate(AutoLogin, SavedKey)
    if Authenticated or Loading or Verifying then
        return
    end

    local EnteredKey

    if AutoLogin then
        EnteredKey = SavedKey
        typeLog("Saved access detected. Auto-authenticating.", Color3.fromRGB(110, 220, 140))
    else
        EnteredKey = trim(PasswordBox.Text)

        if EnteredKey == "" then
            typeLog("Access key required.", Color3.fromRGB(230, 190, 100))
            return
        end
    end

    Verifying = true
    Status.Text = "STATUS: VERIFYING"

    if not AutoLogin then
        animatedLog("Verifying access key", 1)
    end

    local Result, Message = validateKey(EnteredKey)

    Verifying = false

    if Result == "valid" then
        Authenticated = true
        saveKey(EnteredKey)

        PasswordBox.Visible = false
        Connect.Visible = false

        typeLog("Access key accepted.", Color3.fromRGB(110, 220, 140))
        Status.Text = "STATUS: AUTHENTICATED"

        task.wait(0.5)
        detectPlace()

    elseif Result == "rejected" then
        -- The server explicitly refused this key: never run the script,
        -- and forget the saved key if that is where it came from.
        if AutoLogin then
            clearSavedKey()
        end

        typeLog("Access key rejected: " .. tostring(Message), Color3.fromRGB(240, 100, 100))
        Status.Text = "STATUS: INVALID KEY"
        PasswordBox.Text = ""

        task.wait(1)
        Status.Text = "STATUS: LOCKED"

        if AutoLogin then
            typeLog("Enter access key to continue.")
        end

    else
        -- Could not get a real answer. Do NOT run anything, and do NOT
        -- delete the saved key (the server may just be unreachable).
        typeLog(tostring(Message), Color3.fromRGB(230, 190, 100))
        Status.Text = "STATUS: SERVER ERROR"

        if AutoLogin then
            typeLog("Saved key kept. Re-run the loader to retry, or enter a key.")
        end

        task.wait(1)
        Status.Text = "STATUS: LOCKED"
    end
end

Connect.MouseButton1Click:Connect(function()
    authenticate(false)
end)

PasswordBox.FocusLost:Connect(function(EnterPressed)
    if EnterPressed then
        authenticate(false)
    end
end)

--============================================================--
-- DRAGGING
--============================================================--

local Dragging = false
local DragStart
local StartPosition

TopBar.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then

        Dragging = true
        DragStart = Input.Position
        StartPosition = Main.Position

        Input.Changed:Connect(function()
            if Input.UserInputState == Enum.UserInputState.End then
                Dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(Input)
    if not Dragging then
        return
    end

    if Input.UserInputType ~= Enum.UserInputType.MouseMovement
        and Input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local Delta = Input.Position - DragStart

    Main.Position = UDim2.new(
        StartPosition.X.Scale,
        StartPosition.X.Offset + Delta.X,
        StartPosition.Y.Scale,
        StartPosition.Y.Offset + Delta.Y
    )
end)

