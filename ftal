local SnakeNextDirection = Vector2.new(1,0)
local SnakeBody = {}
local SnakeFood = Vector2.new(10,8)
local SnakeCells = {}
local SnakeScoreValue = 0
local SnakeLoop

local SC = 20
local SR = 16
local SS = 14

local function ClearSnake()

    for _,v in ipairs(SnakeCells) do
        if v and v.Parent then
            v:Destroy()
        end
    end

    table.clear(SnakeCells)
end

local function DrawSnake()

    ClearSnake()

    for i,pos in ipairs(SnakeBody) do

        local cell = Instance.new("Frame")
        cell.Size = UDim2.fromOffset(SS-1,SS-1)
        cell.Position =
            UDim2.fromOffset(
                pos.X*SS,
                pos.Y*SS
            )

        cell.BorderSizePixel = 0
        cell.BackgroundColor3 =
            i == 1 and
            Theme.Accent or
            Theme.Card2

        cell.ZIndex = 307
        cell.Parent = SnakeBoard

        table.insert(SnakeCells,cell)
    end

    local food = Instance.new("Frame")
    food.Size = UDim2.fromOffset(SS-1,SS-1)
    food.Position =
        UDim2.fromOffset(
            SnakeFood.X*SS,
            SnakeFood.Y*SS
        )

    food.BorderSizePixel = 0
    food.BackgroundColor3 = Theme.Text
    food.ZIndex = 307
    food.Parent = SnakeBoard

    table.insert(SnakeCells,food)
end

local function NewSnakeFood()

    for _ = 1,500 do

        local candidate =
            Vector2.new(
                math.random(0,SC-1),
                math.random(0,SR-1)
            )

        local used = false

        for _,v in ipairs(SnakeBody) do
            if v == candidate then
                used = true
                break
            end
        end

        if not used then
            SnakeFood = candidate
            return
        end
    end
end

local function StartSnake()

    if SnakeLoop then
        task.cancel(SnakeLoop)
    end

    SnakeBody = {
        Vector2.new(7,8),
        Vector2.new(6,8),
        Vector2.new(5,8),
    }

    SnakeDirection = Vector2.new(1,0)
    SnakeNextDirection = Vector2.new(1,0)
    SnakeScoreValue = 0
    SnakeScore.Text = "SCORE: 0"

    NewSnakeFood()
    SnakeRunning = true
    DrawSnake()

    SnakeLoop = task.spawn(function()

        while SnakeRunning do

            SnakeDirection = SnakeNextDirection

            local head =
                SnakeBody[1]+SnakeDirection

            if
                head.X < 0 or
                head.X >= SC or
                head.Y < 0 or
                head.Y >= SR
            then
                SnakeRunning = false
                break
            end

            local collision = false

            for i,v in ipairs(SnakeBody) do

                if v == head then
                    collision = true
                    break
                end
            end

            if collision then
                SnakeRunning = false
                break
            end

            table.insert(SnakeBody,1,head)

            if head == SnakeFood then

                SnakeScoreValue += 1
                SnakeScore.Text =
                    "SCORE: "..SnakeScoreValue

                NewSnakeFood()
            else
                table.remove(SnakeBody)
            end

            DrawSnake()
            task.wait(.11)
        end
    end)
end

Connect(SnakeStart.MouseButton1Click,StartSnake)

Connect(UserInputService.InputBegan,function(input,gp)

    if gp or not SnakeRunning then
        return
    end

    if input.KeyCode == Enum.KeyCode.W
        and SnakeDirection ~= Vector2.new(0,1) then

        SnakeNextDirection = Vector2.new(0,-1)

    elseif input.KeyCode == Enum.KeyCode.S
        and SnakeDirection ~= Vector2.new(0,-1) then

        SnakeNextDirection = Vector2.new(0,1)

    elseif input.KeyCode == Enum.KeyCode.A
        and SnakeDirection ~= Vector2.new(1,0) then

        SnakeNextDirection = Vector2.new(-1,0)

    elseif input.KeyCode == Enum.KeyCode.D
        and SnakeDirection ~= Vector2.new(-1,0) then

        SnakeNextDirection = Vector2.new(1,0)
    end
end)

