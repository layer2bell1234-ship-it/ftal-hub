        Hub.ESPConnections[player] = nil
    end

    for _,c in ipairs(Hub.Connections) do
        pcall(function()
            c:Disconnect()
        end)
    end

    table.clear(Hub.Connections)

    pcall(function()
        LocalPlayer.CameraMode =
            Enum.CameraMode.Classic

        LocalPlayer.CameraMinZoomDistance = .5
        LocalPlayer.CameraMaxZoomDistance = 12.5
    end)

    pcall(function()
        Gui:Destroy()
    end)

    _G.StopFTALSHub = nil
end

