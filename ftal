local function StopTween()

    TweenActive = false

    if TweenConnection then
        TweenConnection:Disconnect()
        TweenConnection = nil
    end
end

local function StartTween()

    StopTween()

    if not TweenTarget then
        return
    end

    TweenActive = true

    TweenConnection = RunService.Heartbeat:Connect(function(dt)

        if not TweenActive then return end

        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")

        local targetChar = TweenTarget.Character
        local targetRoot =
            targetChar and
            targetChar:FindFirstChild("HumanoidRootPart")

        if not root or not targetRoot then
            return
        end

        for _,part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end

        local target = targetRoot.Position + Vector3.new(0,3,0)
        local offset = target-root.Position
        local distance = offset.Magnitude

        if distance <= 3 then
            root.CFrame = CFrame.new(
                target,
                targetRoot.Position
            )
            StopTween()
            return
        end

        local movement = math.min(
            distance,
            Hub.State.TweenSpeed * dt
        )

        root.CFrame = CFrame.new(
            root.Position + offset.Unit * movement,
            targetRoot.Position
        )
    end)
end

