local function GetRoot(player)

    local char = player and player.Character
    if not char then return nil end

    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("Torso")
end

local function IsEnemy(player)

    if player == LocalPlayer then
        return false
    end

    if Hub.State.KillAuraTeamCheck
        and LocalPlayer.Team
        and player.Team
        and LocalPlayer.Team == player.Team then

        return false
    end

    return true
end

local function GetMouseTarget(maxDistance)

    local mousePos =
        UserInputService:GetMouseLocation()

    local best
    local bestDistance = maxDistance or math.huge

    for _,player in ipairs(Players:GetPlayers()) do

        if IsEnemy(player) then

            local root = GetRoot(player)
            local hum =
                player.Character and
                player.Character:FindFirstChildOfClass("Humanoid")

            if root and hum and hum.Health > 0 then

                local pos,onScreen =
                    Camera:WorldToViewportPoint(root.Position)

                if onScreen then

                    local d =
                        (
                            Vector2.new(pos.X,pos.Y)
                            - mousePos
                        ).Magnitude

                    if d < bestDistance then
                        bestDistance = d
                        best = player
                    end
                end
            end
        end
    end

    return best
end

local function GetClosestTarget(range)

    local root = GetRoot(LocalPlayer)
    if not root then return nil end

    local best
    local distance = range or math.huge

    for _,player in ipairs(Players:GetPlayers()) do

        if IsEnemy(player) then

            local targetRoot = GetRoot(player)
            local hum =
                player.Character and
                player.Character:FindFirstChildOfClass("Humanoid")

            if targetRoot and hum and hum.Health > 0 then

                local d =
                    (root.Position-targetRoot.Position).Magnitude

                if d < distance then
                    distance = d
                    best = player
                end
            end
        end
    end

    return best
end

