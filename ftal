Connect(RunService.RenderStepped,function()

    if not Hub.State.Aimbot
        or not Hub.State.AimbotHolding then
        return
    end

    local target = GetAimTarget()

    if target then

        local alpha =
            math.clamp(
                Hub.State.AimbotSmoothness/100,
                .01,
