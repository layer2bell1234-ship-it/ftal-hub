local function Slider(page,title,description,min,max,default,callback)

    local c = Card(page,65)

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Position = UDim2.fromOffset(13,5)
    titleLabel.Size = UDim2.new(1,-100,0,19)
