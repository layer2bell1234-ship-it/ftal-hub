        {0,0},{1,0},{1,1},{2,1}
    },
}

local function ResetTetrisGrid()

    TetrisGrid = {}

    for y=1,TH do

        TetrisGrid[y] = {}

        for x=1,TW do
            TetrisGrid[y][x] = false
        end
    end
end

local function ClearTetrisVisual()

    for _,v in ipairs(TetrisVisuals) do
        if v and v.Parent then
            v:Destroy()
        end
    end

    table.clear(TetrisVisuals)
end

local function DrawTetris()

    ClearTetrisVisual()

    for y=1,TH do

        for x=1,TW do

            if TetrisGrid[y][x] then

                local b = Instance.new("Frame")
                b.Size = UDim2.fromOffset(TS-1,TS-1)
                b.Position =
                    UDim2.fromOffset(
                        (x-1)*TS,
                        (y-1)*TS
                    )

                b.BorderSizePixel = 0
                b.BackgroundColor3 = Theme.Card2
                b.ZIndex = 307
                b.Parent = TetrisBoard

                table.insert(TetrisVisuals,b)
            end
        end
    end

    if TetrisCurrent then

        for _,p in ipairs(TetrisCurrent) do

            local x = TetrisX+p[1]
            local y = TetrisY+p[2]

            if
                x >= 1 and
                x <= TW and
                y >= 1 and
                y <= TH
            then

                local b = Instance.new("Frame")
                b.Size = UDim2.fromOffset(TS-1,TS-1)
                b.Position =
                    UDim2.fromOffset(
                        (x-1)*TS,
                        (y-1)*TS
                    )

                b.BorderSizePixel = 0
                b.BackgroundColor3 = Theme.Accent
                b.ZIndex = 308
                b.Parent = TetrisBoard

                table.insert(TetrisVisuals,b)
            end
        end
    end
end

local function CanTetrisMove(dx,dy,piece)

    piece = piece or TetrisCurrent

    if not piece then
        return false
    end

    for _,p in ipairs(piece) do

        local x = TetrisX+p[1]+dx
        local y = TetrisY+p[2]+dy

        if x < 1 or x > TW or y > TH then
            return false
        end

        if y >= 1 and TetrisGrid[y][x] then
            return false
        end
    end

    return true
end

local function RotatePiece(piece)

    local rotated = {}

    for _,p in ipairs(piece) do
        table.insert(
            rotated,
            {
                -p[2],
                p[1]
            }
        )
    end

    local minX = math.huge
    local minY = math.huge

    for _,p in ipairs(rotated) do
        minX = math.min(minX,p[1])
        minY = math.min(minY,p[2])
    end

    for _,p in ipairs(rotated) do
        p[1] -= minX
        p[2] -= minY
    end

    return rotated
end

local function LockTetris()

    for _,p in ipairs(TetrisCurrent) do

        local x = TetrisX+p[1]
        local y = TetrisY+p[2]

        if
            x >= 1 and
            x <= TW and
            y >= 1 and
            y <= TH
        then
            TetrisGrid[y][x] = true
        end
    end
end

local function ClearLines()

    local cleared = 0

    for y=TH,1,-1 do

        local full = true

        for x=1,TW do

            if not TetrisGrid[y][x] then
                full = false
                break
            end
        end

        if full then

            table.remove(TetrisGrid,y)

            local row = {}

            for x=1,TW do
                row[x] = false
            end

            table.insert(TetrisGrid,1,row)
            cleared += 1
        end
    end

    if cleared > 0 then

        TetrisScoreValue += cleared*100

        TetrisScore.Text =
            "SCORE: "..TetrisScoreValue
    end
end

local function SpawnTetris()

    TetrisCurrent =
        Pieces[
            math.random(
                1,
                #Pieces
            )
        ]

    TetrisX = 4
    TetrisY = 1

    if not CanTetrisMove(0,0) then
        TetrisRunning = false
    end
end

local function StartTetris()

    if TetrisLoop then
        task.cancel(TetrisLoop)
    end

    ResetTetrisGrid()

    TetrisScoreValue = 0
    TetrisScore.Text = "SCORE: 0"

    TetrisRunning = true

    SpawnTetris()
    DrawTetris()

    TetrisLoop = task.spawn(function()

        while TetrisRunning do

            if CanTetrisMove(0,1) then

                TetrisY += 1

            else

                LockTetris()
                ClearLines()
                SpawnTetris()
            end

            DrawTetris()
            task.wait(.45)
        end
    end)
end

Connect(TetrisStart.MouseButton1Click,StartTetris)

Connect(UserInputService.InputBegan,function(input,gp)

    if gp or not TetrisRunning then
        return
    end

    if input.KeyCode == Enum.KeyCode.A then

        if CanTetrisMove(-1,0) then
            TetrisX -= 1
            DrawTetris()
        end

    elseif input.KeyCode == Enum.KeyCode.D then

        if CanTetrisMove(1,0) then
            TetrisX += 1
            DrawTetris()
        end

    elseif input.KeyCode == Enum.KeyCode.S then

        if CanTetrisMove(0,1) then
            TetrisY += 1
            DrawTetris()
        end

    elseif input.KeyCode == Enum.KeyCode.W then

        local rotated = RotatePiece(TetrisCurrent)

        if CanTetrisMove(0,0,rotated) then
            TetrisCurrent = rotated
            DrawTetris()
        end

    elseif input.KeyCode == Enum.KeyCode.Space then

        while CanTetrisMove(0,1) do
            TetrisY += 1
        end

        DrawTetris()
    end
end)

