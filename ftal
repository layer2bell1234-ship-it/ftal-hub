local function SafeConfigName(name)

    name = tostring(name or "")
    name = name:gsub("[^%w_%-%s]","")
    name = name:gsub("^%s+","")
    name = name:gsub("%s+$","")

    return name:sub(1,40)
end

local function GetConfig()

    local c = {}

    for key,value in pairs(Hub.State) do

        if typeof(value) ~= "EnumItem"
            and typeof(value) ~= "Color3"
            and type(value) ~= "table" then

            c[key] = value
        end
    end

    c.MenuKey = Hub.State.MenuKey.Name

    c.ESPColor = {
        math.floor(Hub.State.ESPColor.R*255),
        math.floor(Hub.State.ESPColor.G*255),
        math.floor(Hub.State.ESPColor.B*255),
    }

    return c
end

local function SaveConfig(name)

    name = SafeConfigName(name)

    if name == "" or not HasFiles then
        return false
    end

    return pcall(function()

        local path =
            ConfigFolder.."/"..name..".json"

        writefile(
            path,
            HttpService:JSONEncode(
                GetConfig()
            )
        )
    end)
end

local function LoadConfig(name)

    if not HasFiles then
        return false
    end

    return pcall(function()

        local path =
            ConfigFolder.."/"..name..".json"

        if not isfile(path) then
            error("missing config")
        end

        local data =
            HttpService:JSONDecode(
                readfile(path)
            )

        for key,value in pairs(data) do

            if key ~= "MenuKey"
                and key ~= "ESPColor"
                and Hub.State[key] ~= nil then

                Hub.State[key] = value
            end
        end

        if data.MenuKey then
            local key =
                Enum.KeyCode[data.MenuKey]

            if key then
                Hub.State.MenuKey = key
                MenuKeyButton.Text = key.Name
            end
        end

        if data.ESPColor then
            Hub.State.ESPColor =
                Color3.fromRGB(
                    data.ESPColor[1],
                    data.ESPColor[2],
                    data.ESPColor[3]
                )
        end

        SoundBox.Text =
            Hub.State.StartupSoundId or ""
    end)
end

local function DeleteConfig(name)

    if not HasFiles then
        return false
    end

    return pcall(function()

        local path =
            ConfigFolder.."/"..name..".json"

        if isfile(path) then
            delfile(path)
        end
    end)
end

