local function CreateLine(parent)

    local line = Instance.new("Frame")
    line.AnchorPoint = Vector2.new(.5,.5)
    line.BorderSizePixel = 0
    line.Size = UDim2.fromOffset(1,1)
    line.Visible = false
    line.Parent = parent

    return line
end

local function AddESP(player)

    if player == LocalPlayer then
        return
    end

    if Hub.ESP[player] then
        for _,obj in pairs(Hub.ESP[player]) do
            if typeof(obj) == "Instance" then
                pcall(function()
                    obj:Destroy()
                end)
            elseif type(obj) == "table" then
                for _,v in pairs(obj) do
                    if typeof(v) == "Instance" then
                        pcall(function()
                            v:Destroy()
                        end)
                    end
                end
            end
        end
    end

    local data = {}

    data.Highlight = Instance.new("Highlight")
    data.Highlight.Name = "FTAL_Chams"
    data.Highlight.FillTransparency = .75
    data.Highlight.OutlineTransparency = 0
    data.Highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop
    data.Highlight.Enabled = false
    data.Highlight.Parent = workspace

    data.Billboard = Instance.new("BillboardGui")
    data.Billboard.Name = "FTAL_Info"
    data.Billboard.Size = UDim2.fromOffset(220,55)
    data.Billboard.StudsOffset = Vector3.new(0,3.5,0)
    data.Billboard.AlwaysOnTop = true
    data.Billboard.Enabled = false
    data.Billboard.Parent = Gui

    data.Label = Instance.new("TextLabel")
    data.Label.BackgroundTransparency = 1
    data.Label.Size = UDim2.fromScale(1,1)
    data.Label.Font = Enum.Font.GothamBold
    data.Label.TextSize = 10
    data.Label.TextStrokeTransparency = .25
    data.Label.Parent = data.Billboard

    data.Tracer = CreateLine(Gui)

    data.Box = {}

    for i=1,4 do
        data.Box[i] = CreateLine(Gui)
    end

    data.Skeleton = {}

    for i=1,15 do
        data.Skeleton[i] = CreateLine(Gui)
    end

    data.HeadDot = Instance.new("Frame")
    data.HeadDot.AnchorPoint = Vector2.new(.5,.5)
    data.HeadDot.Size = UDim2.fromOffset(6,6)
    data.HeadDot.BorderSizePixel = 0
    data.HeadDot.Visible = false
    data.HeadDot.Parent = Gui
    Round(data.HeadDot,3)

    Hub.ESP[player] = data
end

local function RemoveESP(player)

    local data = Hub.ESP[player]

    if not data then
        return
    end

    for key,obj in pairs(data) do

        if typeof(obj) == "Instance" then
            pcall(function()
                obj:Destroy()
            end)

        elseif type(obj) == "table" then

            for _,v in pairs(obj) do
                if typeof(v) == "Instance" then
                    pcall(function()
                        v:Destroy()
                    end)
                end
            end
        end
    end

    Hub.ESP[player] = nil
end

local function WatchESP(player)

    if player == LocalPlayer then
        return
    end

    AddESP(player)

    if Hub.ESPConnections[player] then
        Hub.ESPConnections[player]:Disconnect()
    end

    Hub.ESPConnections[player] =
        player.CharacterAdded:Connect(function()
            task.wait(.2)

            if not Hub.Destroyed then
                AddESP(player)
            end
        end)
end

for _,player in ipairs(Players:GetPlayers()) do
    WatchESP(player)
end

Connect(Players.PlayerAdded,function(player)
    task.wait(.1)
    WatchESP(player)
end)

Connect(Players.PlayerRemoving,function(player)

    RemoveESP(player)

    if Hub.ESPConnections[player] then
        Hub.ESPConnections[player]:Disconnect()
        Hub.ESPConnections[player] = nil
    end
end)

local function SetLine(line,from,to,color,thickness)

    local delta = to-from

    if delta.Magnitude < .5 then
        line.Visible = false
        return
    end

    line.Position =
        UDim2.fromOffset(
            (from.X+to.X)/2,
            (from.Y+to.Y)/2
        )

    line.Size =
        UDim2.fromOffset(
            delta.Magnitude,
            thickness or 1
        )

    line.Rotation =
        math.deg(
            math.atan2(
                delta.Y,
                delta.X
            )
        )

    line.BackgroundColor3 = color
    line.Visible = true
end

local function HideESP(data)

    data.Highlight.Enabled = false
    data.Billboard.Enabled = false
    data.Tracer.Visible = false
    data.HeadDot.Visible = false

    for _,line in ipairs(data.Box) do
        line.Visible = false
    end

    for _,line in ipairs(data.Skeleton) do
        line.Visible = false
    end
end

local function WallVisible(char,root)

    if not Hub.State.ESPWallCheck then
        return true
    end

    local params = RaycastParams.new()
    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.FilterDescendantsInstances = {
        LocalPlayer.Character,
        char,
    }

    local result =
        workspace:Raycast(
            Camera.CFrame.Position,
            root.Position-Camera.CFrame.Position,
            params
        )

    return result == nil
end

local function Project(part)

    if not part then
        return nil
    end

    local pos,onScreen =
        Camera:WorldToViewportPoint(
            part.Position
        )

    if not onScreen then
        return nil
    end

    return Vector2.new(pos.X,pos.Y)
end

local function DrawBox(data,char,color)

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local topPart =
        char:FindFirstChild("Head")
        or root

    local top = Project(topPart)

    local bottom =
        Project(root)

    if not top or not bottom then
        for _,line in ipairs(data.Box) do
            line.Visible = false
        end
        return
    end

    local height =
        math.abs(bottom.Y-top.Y)*1.25

    local width =
        math.clamp(height*.55,20,200)

    local centerX = bottom.X
    local topY = top.Y-height*.12
    local bottomY = bottom.Y+height*.05
    local leftX = centerX-width/2
    local rightX = centerX+width/2

    SetLine(
        data.Box[1],
        Vector2.new(leftX,topY),
        Vector2.new(rightX,topY),
        color,
        1
    )

    SetLine(
        data.Box[2],
        Vector2.new(rightX,topY),
        Vector2.new(rightX,bottomY),
        color,
        1
    )

    SetLine(
        data.Box[3],
        Vector2.new(rightX,bottomY),
        Vector2.new(leftX,bottomY),
        color,
        1
    )

    SetLine(
        data.Box[4],
        Vector2.new(leftX,bottomY),
        Vector2.new(leftX,topY),
        color,
        1
    )
end

local SkeletonPairs = {

    {"Head","UpperTorso"},
    {"Head","Torso"},
    {"UpperTorso","LowerTorso"},
    {"Torso","Left Arm"},
    {"Torso","Right Arm"},
    {"UpperTorso","LeftUpperArm"},
    {"LeftUpperArm","LeftLowerArm"},
    {"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},
    {"RightUpperArm","RightLowerArm"},
    {"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},
    {"LeftUpperLeg","LeftLowerLeg"},
    {"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},
}

local function DrawSkeleton(data,char,color)

    local lineIndex = 1

    for _,pair in ipairs(SkeletonPairs) do

        local a =
            char:FindFirstChild(pair[1])

        local b =
            char:FindFirstChild(pair[2])

        if a and b and lineIndex <= #data.Skeleton then

            local ap = Project(a)
            local bp = Project(b)

            if ap and bp then

                SetLine(
                    data.Skeleton[lineIndex],
                    ap,
                    bp,
                    color,
                    1
                )

            else
                data.Skeleton[lineIndex].Visible = false
            end

            lineIndex += 1
        end
    end

    for i=lineIndex,#data.Skeleton do
        data.Skeleton[i].Visible = false
    end
end

Connect(RunService.RenderStepped,function()

    for player,data in pairs(Hub.ESP) do

        if not Hub.State.ESPEnabled then
            HideESP(data)
            continue
        end

        if Hub.State.ESPTeamCheck
            and LocalPlayer.Team
            and player.Team
            and LocalPlayer.Team == player.Team then

            HideESP(data)
            continue
        end

        local char = player.Character
        local root =
            char and
            char:FindFirstChild("HumanoidRootPart")

        local hum =
            char and
            char:FindFirstChildOfClass("Humanoid")

        if not char or not root or not hum or hum.Health <= 0 then
            HideESP(data)
            continue
        end

        local localRoot = GetRoot(LocalPlayer)

        if not localRoot then
            HideESP(data)
            continue
        end

        local distance =
            (localRoot.Position-root.Position).Magnitude

        if distance > Hub.State.ESPMaxDistance then
            HideESP(data)
            continue
        end

        if not WallVisible(char,root) then
            HideESP(data)
            continue
        end

        local color = Hub.State.ESPColor

        -- Chams.
        data.Highlight.Adornee = char
        data.Highlight.FillColor = color
        data.Highlight.OutlineColor = color
        data.Highlight.Enabled =
            Hub.State.ESPChams

        -- Information.
        local info = {}

        if Hub.State.ESPNames then
            table.insert(
                info,
                player.DisplayName
            )
        end

        if Hub.State.ESPDistance then
            table.insert(
                info,
                math.floor(distance).."m"
            )
        end

        if Hub.State.ESPHealth then
            table.insert(
                info,
                "HP "..math.floor(hum.Health)
            )
        end

        data.Billboard.Adornee = root
        data.Label.Text =
            table.concat(info,"  •  ")

        data.Label.TextColor3 = color
        data.Billboard.Enabled = #info > 0

        -- Box.
        if Hub.State.ESPBoxes then
            DrawBox(data,char,color)
        else
            for _,line in ipairs(data.Box) do
                line.Visible = false
            end
        end

        -- Skeleton.
        if Hub.State.ESPSkeleton then
            DrawSkeleton(data,char,color)
        else
            for _,line in ipairs(data.Skeleton) do
                line.Visible = false
            end
        end

        -- Head dot.
        if Hub.State.ESPHeadDot then

            local head = char:FindFirstChild("Head")
            local pos = Project(head)

            if pos then

                data.HeadDot.Position =
                    UDim2.fromOffset(
                        pos.X,
                        pos.Y
                    )

                data.HeadDot.BackgroundColor3 =
                    color

                data.HeadDot.Visible = true

            else
                data.HeadDot.Visible = false
            end

        else
            data.HeadDot.Visible = false
        end

        -- Tracer.
        if Hub.State.ESPTracers then

            local pos = Project(root)

            if pos then

                local from =
                    Vector2.new(
                        Camera.ViewportSize.X/2,
                        Camera.ViewportSize.Y
                    )

                SetLine(
                    data.Tracer,
                    from,
                    pos,
                    color,
                    1
                )

            else
                data.Tracer.Visible = false
            end

        else
            data.Tracer.Visible = false
        end
    end
end)

