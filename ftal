    titleLabel.Text = title
    titleLabel.TextSize = 12
    titleLabel.TextColor3 = Theme.Text
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = c

    local valueLabel = Instance.new("TextLabel")
    valueLabel.BackgroundTransparency = 1
    valueLabel.Position = UDim2.new(1,-82,0,5)
    valueLabel.Size = UDim2.fromOffset(68,19)
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextSize = 10
    valueLabel.TextColor3 = Theme.Accent
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Text = tostring(default)
    valueLabel.Parent = c

    local desc = Instance.new("TextLabel")
    desc.BackgroundTransparency = 1
    desc.Position = UDim2.fromOffset(13,24)
    desc.Size = UDim2.new(1,-26,0,14)
    desc.Font = Enum.Font.Gotham
    desc.Text = description or ""
    desc.TextSize = 9
    desc.TextColor3 = Theme.Muted
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.Parent = c

    local bar = Instance.new("Frame")
    bar.Position = UDim2.fromOffset(13,45)
    bar.Size = UDim2.new(1,-26,0,6)
    bar.BackgroundColor3 = Theme.Card2
    bar.BorderSizePixel = 0
    bar.Parent = c

    Round(bar,3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(
        (default-min)/(max-min),
        0,
        1,
        0
    )
    fill.BackgroundColor3 = Theme.Accent
    fill.BorderSizePixel = 0
    fill.Parent = bar

    Round(fill,3)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(.5,.5)
    knob.Size = UDim2.fromOffset(12,12)
    knob.Position = UDim2.new(
        (default-min)/(max-min),
        0,
        .5,
        0
    )
    knob.BackgroundColor3 = Theme.Text
    knob.BorderSizePixel = 0
    knob.Parent = bar

    Round(knob,6)

    local value = default
    local sliding = false

    local function setValue(v)
        value = math.clamp(v,min,max)

        local alpha = (value-min)/(max-min)

        fill.Size = UDim2.new(alpha,0,1,0)
        knob.Position = UDim2.new(alpha,0,.5,0)

        if math.floor(value) == value then
            valueLabel.Text = tostring(math.floor(value))
        else
            valueLabel.Text = string.format("%.2f",value)
        end

        callback(value)
    end

    local function updateFromX(x)
        local alpha = math.clamp(
            (x-bar.AbsolutePosition.X) /
            bar.AbsoluteSize.X,
            0,
            1
        )

        setValue(
            min+(max-min)*alpha
        )
    end

    Connect(bar.InputBegan,function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            updateFromX(input.Position.X)
        end
    end)

    Connect(knob.InputBegan,function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
        end
    end)

    Connect(UserInputService.InputChanged,function(input)
        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(input.Position.X)
        end
    end)

    Connect(UserInputService.InputEnded,function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = false
        end
    end)

    setValue(default)

    return c
end

